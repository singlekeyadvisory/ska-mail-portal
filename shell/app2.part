// ---------- mailboxes + admin ----------
const CTSZ=50;
async function inboxView(){await loadInb();CTPAGE=0;
const{data:_tsi}=await hd.from('tenant_settings').select('sync_interval_minutes').eq('tenant_id',me.tenant).maybeSingle();const _syncMin=_tsi?.sync_interval_minutes||10;
if(me.crm){
const{data:a}=await hd.from('inbox_access').select('*');ACC=a??[];
const{data:tg}=await hd.from('tags').select('*').order('name');TAGS=tg??[];
const{data:ct,count:ctn}=await hd.from('contacts').select('*',{count:'exact'}).order('msg_count',{ascending:false}).range(0,CTSZ-1);CT=ct??[];CTN=ctn??CT.length;CTOT=ctn??CT.length;
const ids=CT.map(c=>c.id);
const{data:ctt}=ids.length?await hd.from('contact_tags').select('*').in('contact_id',ids):{data:[]};CTT=ctt??[];
const{data:rt}=await hd.from('retention_settings').select('*').limit(1).maybeSingle();RET=rt;
const{data:dp}=await pb.from('departments').select('id,name').eq('active',true).order('sort_order');DEPTS=dp??[];
const{data:fa}=await hd.from('feature_access').select('*');FA=fa??[];
const{data:fg}=await hd.from('feature_grants').select('*');FG=fg??[];
const{data:ap2}=await hd.from('approval_settings').select('*').limit(1).maybeSingle();APPR=ap2??APPR;
const{data:ts0}=await hd.from('tenant_settings').select('*').eq('tenant_id',me.tenant).maybeSingle();TSET=ts0;
// The shared temporary password lives in helpdesk.tenant_secrets, which only
// admins can read. tenant_settings is readable by every signed-in member, so
// it must never hold it -- a database trigger enforces that too.
try{const{data:_sec}=await hd.from('tenant_secrets').select('default_temp_password').eq('tenant_id',me.tenant).maybeSingle();
if(TSET)TSET.__temp_pw=(_sec&&_sec.default_temp_password)||''}catch(e){if(TSET)TSET.__temp_pw=''}
const{data:ar0}=await hd.from('allowed_recipients').select('*').is('client_id',null).order('created_at',{ascending:false});AR=ar0??[];}
const{data,error}=await hd.from('v_inbox_status').select('*').order('email_address');
if(error)return `<div class="e">${E(error.message)}</div>`;
const mbAdd=me.crm?`<div class="card" style="margin-top:18px"><h2 style="margin-bottom:10px">Add a mailbox</h2>
<div class="mu" style="margin-bottom:10px">The address must be a real mailbox on the singlekeyadvisory.com domain.
The next sync picks it up automatically and pulls its last year of mail. Who sees and answers it is set per member
under <b>Team members → Mailbox access</b>.</div>
<div class="rw"><input id="nb_e" placeholder="address@singlekeyadvisory.com" style="min-width:240px">
<input id="nb_l" placeholder="Label (e.g. Accounts)">
<button class="pri" id="nb_add">Add mailbox</button></div><div id="nb_msg"></div></div>`:'';
const admin=me.crm?`<div class="ftabs" id="admtabs" style="border:none;position:static;margin:18px 0 6px">
${[['team','Team members'],['contacts','Contacts & tags'],['access','Access & approvals'],['retention','Retention']].map(([k,l])=>`<b data-s="${k}" class="${ADMTAB===k?'on':''}">${l}</b>`).join('')}</div>
<div class="admsec" data-s="access" ${ADMTAB==='access'?'':'hidden'}>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Blocking senders</h2>
<div class="mu">Blocking lives on a contact’s <b>Block</b> tag. Add the Block tag to any contact under <b>Contacts &amp; tags</b> below — or hit <b>🚫 Block sender</b> on a conversation. Their un-ticketed mail is deleted at once, mail already on a ticket is kept, and future mail is dropped on arrival. Gmail is never touched. Remove the Block tag to unblock, which re-fetches that sender’s last 365 days from Gmail.</div></div></div>
<div class="admsec" data-s="team" ${ADMTAB==='team'?'':'hidden'}>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Default temporary password</h2>
<div class="mu" style="margin-bottom:8px">One shared first-login password for every new and not-yet-signed-in member — they must set their own afterwards. Saving a new one re-applies it to everyone who has not logged in yet.</div>
<div class="rw"><input id="tp_val" type="password" value="${E(TSET?.__temp_pw||'')}" placeholder="${TSET&&TSET.__temp_pw?'':'Not set yet'}" style="min-width:220px"><button class="gh" id="tp_eye" type="button" title="Show / hide">Show</button><button class="pri" id="tp_save">Save</button></div>
<div id="tp_msg"></div></div>
<div class="card" style="margin-top:14px"><div class="rw" id="wg_h" role="button" tabindex="0" style="justify-content:space-between;align-items:center;cursor:pointer;gap:10px"><h2 style="margin:0">Welcome guide <span class="mu" style="font-weight:400;font-size:13px;vertical-align:middle">\u00b7 first-login help</span></h2><span id="wg_chev" class="mu" style="font-size:15px;transition:transform .15s">\u25b8</span></div>
<div id="wg_body" style="display:none">
<div class="mu" style="margin:8px 0 8px">Shown once to each member the first time they sign in — they can reopen it anytime from the <b>❔ Guide</b> button. Edit the content below (bold, headings, bullets, links).</div>
<label class="rw" style="gap:8px;align-items:center;margin-bottom:10px"><input type="checkbox" id="onb_en" ${ONBON?'checked':''}> Automatically show it to new members on first login</label>
<div class="rteb" id="onb_tb" style="border-radius:9px 9px 0 0"><button type="button" data-cmd="bold" title="Bold"><b>B</b></button><button type="button" data-cmd="italic" title="Italic"><i>I</i></button><button type="button" data-cmd="formatBlock" data-val="H3" title="Heading">H</button><button type="button" data-cmd="insertUnorderedList" title="Bulleted list">• List</button><button type="button" data-cmd="createLink" title="Add a link">🔗 Link</button></div>
<div class="rte" id="onb_ed" contenteditable="true" spellcheck="false" style="min-height:220px;max-height:440px;overflow:auto"></div>
<div class="rw" style="gap:8px;margin-top:10px;flex-wrap:wrap"><button class="pri" id="onb_save">Save guide</button><button class="gh" id="onb_prev">Preview</button><button class="gh" id="onb_reset">Reset to default</button><button class="gh" id="onb_reshow" title="Make the guide reappear for everyone at their next sign-in">Re-show to everyone</button></div>
<div class="mu" id="onb_msg" style="margin-top:8px"></div></div></div>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Team members</h2>
<div class="mu" style="margin-bottom:8px">Members sign in with a <b>username</b>, not an email. Give a name, a unique
username and an initial password — a new password of their own is forced at first sign-in. Email is optional.
<b>Mailbox access</b> decides exactly which mailboxes each member sees <i>and</i> can send or draft from:
"All mailboxes" means no restriction; list one or more and they see and send from <b>only those</b>. Admins always see everything.</div>
<div class="mu" style="margin-bottom:8px">Members are added centrally from the intranet — there is no local sign-up here, and members have no mailbox of their own. Manage access, roles and passwords for existing members below.</div>
<div id="tm_list" class="mu">Loading members…</div><div id="tm_msg"></div></div></div>
<div class="admsec" data-s="contacts" ${ADMTAB==='contacts'?'':'hidden'}>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Contacts & tags</h2>
<div class="mu" style="margin-bottom:8px">Every address seen in mail over the last 6 months — sender, To, Cc and Bcc,
including people we only ever wrote to — is collected automatically as mail syncs. Tags are yours to define; the behavior
decides what a tag does — <b>Label</b> shows a chip in Inbox · <b>Ignore</b> hides that sender from Inbox · <b>Block (workspace)</b> hides them from everyone incl. admins and deletes un-ticketed mail · <b>Block (team)</b> hides them from members but keeps the mail visible to admins and granted people · <b>Client</b> links their mail to a client name. Every <b>client group</b> from the intranet
is pre-loaded as a Client tag, and a new group added there becomes a tag here automatically.</div>
<div class="rw" style="margin:6px 0 12px;gap:8px;align-items:center"><label class="mu" style="display:inline-flex;align-items:center;gap:6px"><b>Client pill colour</b> <input type="color" id="cli_col" value="${CLICOL&&/^#[0-9a-f]{6}$/i.test(CLICOL)?CLICOL:'#8b5cf6'}" style="width:36px;height:26px;padding:0;border:none;background:none;cursor:pointer"></label><span class="mu">One colour for <b>every</b> client pill across the app — clients aren't coloured one by one.</span><button class="gh" id="cli_col_rst" title="Back to the default violet">Reset to default</button></div>
${(()=>{const intr=TAGS.filter(t=>t.source==='intranet'),man=TAGS.filter(t=>t.source!=='intranet');
const chips=arr=>arr.map(t=>`<span class="chip">${t.behavior==='client'?'':`<input type="color" class="tgcol" data-id="${t.id}" value="${t.color&&/^#[0-9a-f]{6}$/i.test(t.color)?t.color:'#64748b'}" title="Pill colour" style="width:20px;height:16px;padding:0;border:none;background:none;cursor:pointer;vertical-align:-2px"> `}${E(t.name)} <span class="mu">${E(t.behavior)}${t.client_name&&t.client_name!==t.name?' · '+E(t.client_name):''}</span> ${t.source==='intranet'?'':`<b class="tged" data-id="${t.id}" data-n="${E(t.name)}" style="cursor:pointer" title="Rename">✎</b> <b class="tgx" data-id="${t.id}" style="cursor:pointer" title="Delete">✕</b>`}</span>`).join('');
return `<details style="margin-bottom:8px"><summary class="mu" style="cursor:pointer;padding:4px 0"><b>Client groups from the intranet (${intr.length})</b> — kept in sync automatically, not editable here</summary>
<div class="rw" style="margin:8px 0;max-height:170px;overflow:auto">${chips(intr)||'<span class="mu">None yet.</span>'}</div></details>
<details style="margin-bottom:10px" open><summary class="mu" style="cursor:pointer;padding:4px 0"><b>Tags you created (${man.length})</b></summary>
<div class="rw" style="margin:8px 0;max-height:170px;overflow:auto">${chips(man)||'<span class="mu">No tags yet — create the first below.</span>'}</div></details>`})()}
<div class="rw" style="margin-bottom:12px"><input id="tg_n" placeholder="Tag name (e.g. GST, Income tax)" style="min-width:180px">
<select id="tg_b"><option value="label">Behavior: Label</option><option value="client">Behavior: Client</option><option value="ignore">Behavior: Ignore</option><option value="block">Behavior: Block (workspace-wide)</option><option value="block_team">Behavior: Block (team-only)</option></select>
<input id="tg_c" placeholder="Client name" hidden><label class="mu" style="display:inline-flex;align-items:center;gap:5px">Pill colour <input type="color" id="tg_col" value="#64748b" style="width:34px;height:26px;padding:0;border:none;background:none;cursor:pointer"></label><button class="pri" id="tg_add">Create tag</button></div>
<div id="tg_msg"></div>
${me.crm?`<div class="card" style="margin-bottom:12px;padding:12px"><div class="rw" style="align-items:baseline;gap:8px;flex-wrap:wrap"><b>\uD83D\uDD12 Only show to \u2014 by tag</b><span class="mu" style="flex:1;min-width:220px">Apply an \u201conly show to\u201d restriction to every address carrying a tag, in one go. Any single address can still be changed on its own in the contacts list below.</span></div><div class="mu" id="tr_hint" style="display:none;margin-top:8px">Only-show-to restrictions are switched off for the portal \u2014 turn them on under Send &amp; access to use tag rules.</div>
<div class="rw" id="tr_box" style="margin-top:10px;gap:8px;flex-wrap:wrap"><select id="tr_tag"><option value="">Choose a tag\u2026</option>${TAGS.map(t=>`<option value="${E(t.id)}">${E(t.name)}</option>`).join('')}</select><button class="gh" id="tr_go">Set who can see it\u2026</button></div>${me.platform?`<label class="rw" style="gap:7px;align-items:center;margin-top:10px;cursor:pointer"><input type="checkbox" id="tr_cdef" ${TAGRCONN?'checked':''}> <span class="mu">Keep new tag rules <b>connected</b> by default \u2014 addresses tagged later inherit the restriction automatically. Off = one-time apply (the default).</span></label>`:''}<div id="tr_list" style="margin-top:10px"></div></div>`:''}
<div class="rw" style="margin-bottom:8px"><input type="search" id="ct_q" placeholder="Search contacts by address or name…" style="min-width:240px">
<select id="ct_tag"><option value="">Tag: any</option>${TAGS.map(t=>`<option>${E(t.name)}</option>`).join('')}</select>
<span class="mu" id="ct_ct"></span></div>
<div class="rw" style="margin:2px 0 10px;gap:6px;align-items:center"><button class="gh" id="ct_exp">⬇ Export (Excel)</button><button class="gh" id="ct_imp">⬆ Import tags</button><input type="file" id="ct_impf" accept=".xlsx,.xls,.csv" hidden><span class="note" style="margin:0">Export downloads every contact with its current tags; the <b>Tags</b> column carries a dropdown of your existing tags for quick assignment. Import reads a sheet with <b>Email</b> and <b>Tags</b> columns (comma-separated) and applies them — unknown names become Labels, with a confirmation summary first. Gmail is never touched.</span></div>
<div id="ct_list"></div></div></div>
<div class="admsec" data-s="retention" ${ADMTAB==='retention'?'':'hidden'}>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Mail retention</h2>
<div class="mu" style="margin-bottom:10px">Portal-level housekeeping — Gmail is never touched. Archiving hides old mail from
Inbox (still stored, still on its tickets). Attachment files and whole mails are removed permanently after their windows.
Hard floor: nothing newer than 30 days can be deleted, even by an admin — the database refuses it.</div>
<div class="prefh" style="margin:16px 0 5px">Archiving</div>
<div class="mu" style="margin-bottom:7px">Moves old mail out of the Inbox. Nothing is deleted \u2014 it stays on its tickets and in the Archive tab.</div>
<div style="border:1px solid var(--c-border);border-radius:9px;padding:11px 13px;display:grid;gap:10px">
<div class="rw"><label class="mu">Archive after <input id="rt_a" type="number" min="30" style="width:80px" value="${RET?.archive_after_days??90}"> days</label></div>
<div class="rw"><label class="mu"><b>Sent archive</b> holds sent mail older than <input id="rt_sarch" type="number" min="1" max="3650" style="width:80px" value="${TSET?.sent_archive_days??90}"> days <span class="mu">(the Archive \u2192 Sent archive shelf; sent mail younger than this stays in Sent)</span></label></div>
</div>
<div class="prefh" style="margin:16px 0 5px">Permanent deletion</div>
<div class="mu" style="margin-bottom:7px">Removes data for good. Nothing newer than 30 days can be deleted, even by an admin \u2014 the database refuses it.</div>
<div style="border:1px solid var(--c-border);border-radius:9px;padding:11px 13px;display:grid;gap:10px">
<div class="rw"><label class="mu">Delete attachment files after <input id="rt_t" type="number" min="30" style="width:80px" value="${RET?.attachment_delete_after_days??90}"> days</label></div>
<div class="rw"><label class="mu">Delete mails after <input id="rt_d" type="number" min="30" style="width:80px" value="${RET?.mail_delete_after_days??365}"> days</label></div>
<div class="rw"><label class="mu">Delete <b>archived</b> mail ${(()=>{const d=RET?.archived_delete_after_days??3650;
const[u,n]=d%365===0?['years',d/365]:d%30===0?['months',d/30]:d%7===0?['weeks',d/7]:['days',d];
return `<input id="rt_ar" type="number" min="1" style="width:70px" value="${n}">
<select id="rt_aru">${['days','weeks','months','years'].map(x=>`<option ${x===u?'selected':''}>${x}</option>`).join('')}</select>`})()}
after it was archived <span class="mu">(the longest the Archive shelf holds anything \u2014 whichever of this and \u201cDelete mails after\u201d falls first is what applies)</span></label></div>
<div class="rw"><label class="mu">Delete <b>ignored</b> mail ${(()=>{const d=RET?.ignored_delete_after_days??30;
const[u,n]=d%365===0?['years',d/365]:d%30===0?['months',d/30]:d%7===0?['weeks',d/7]:['days',d];
return `<input id="rt_i" type="number" min="1" style="width:70px" value="${n}">
<select id="rt_iu">${['days','weeks','months','years'].map(x=>`<option ${x===u?'selected':''}>${x}</option>`).join('')}</select>`})()}
after it was ignored <span class="mu">(minimum 1 day — someone already reviewed it)</span></label></div>
</div>
<div class="prefh" style="margin:16px 0 5px">How long things stay on screen</div>
<div class="mu" style="margin-bottom:7px">Only changes what a tab lists. Nothing is deleted by these.</div>
<div style="border:1px solid var(--c-border);border-radius:9px;padding:11px 13px;display:grid;gap:10px">
<div class="rw"><label class="mu">Show <b>resolved</b> tickets in the Resolved tab for <input id="rt_r" type="number" min="1" style="width:80px" value="${RET?.resolved_visible_days??30}"> days <span class="mu">(they stay stored either way)</span></label></div>
<div class="rw"><label class="mu"><b>Sent → Everyone</b> shows the last <input id="rt_sad" type="number" min="1" max="365" style="width:80px" value="${TSET?.sent_all_days??90}"> days of sent mail <span class="mu">(how far back the shared “Everyone” view looks, per mailbox, for members allowed to see it)</span></label></div>
<div class="rw"><label class="mu">Keep <b>activity log</b> entries for <input id="rt_l" type="number" min="30" style="width:80px" value="${RET?.activity_retention_days??365}"> days <span class="mu">(30–3650 — older entries are purged automatically)</span></label></div>
</div>
<div class="prefh" style="margin:16px 0 5px">Mail runs, deadlines &amp; sessions</div>
<div class="mu" style="margin-bottom:7px">Portal-wide behaviour that applies to everyone.</div>
<div style="border:1px solid var(--c-border);border-radius:9px;padding:11px 13px;display:grid;gap:10px">
<div class="rw"><label class="mu">Check for new mail every <input id="rt_sync" type="number" min="10" max="1440" style="width:80px" value="${TSET?.sync_interval_minutes??10}"> minutes <span class="mu">(minimum 10 — the background mail run. Queued mail goes out on each run — within 10 min — or instantly with ⟳ Sync now.)</span></label></div>
<div class="rw"><label class="mu">Allow deadlines up to <input id="rt_dlm" type="number" min="1" max="60" style="width:70px" value="${TSET?.deadline_max_months??6}"> months ahead <span class="mu">(the furthest deadline anyone can set — when claiming, self-assigning, or assigning to others)</span></label></div>
<div class="rw"><label class="mu">Sign members out after <input id="rt_idle" type="number" min="0" max="480" style="width:70px" value="${TSET?.inactivity_minutes??30}"> minutes of inactivity <span class="mu">(security auto sign-out for everyone; <b>0 = never</b>. Typing, clicking, scrolling or moving the mouse keeps them signed in — the timer only counts idle time.)</span></label></div>
</div>
<div style="margin-top:14px"><button class="pri" id="rt_s">Save</button></div><div id="rt_msg"></div></div></div>
<div class="admsec" data-s="access" ${ADMTAB==='access'?'':'hidden'}>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Feature access</h2>
<div class="mu" style="margin-bottom:10px">Decide who can use each area. Admins always have access. "Everyone" opens it
to all members; "Admins + granted" limits it to admins plus the people you list. The <b>Settings</b> tab itself is always available to everyone (for personal preferences) — these only control the specific areas listed here.</div>
${[['activity','Activity log'],['all_tickets','All tickets tab'],['all_sent','Sent → Everyone (all members’ sent & queued mail)'],['housekeeping','Housekeeping — bulk-ignore old mail'],['blocked_view','See team-blocked senders’ mail']].map(([f,l])=>{
const row=FA.find(x=>x.feature===f);const ev=row?row.everyone:(f!=='housekeeping');
const gs=FG.filter(x=>x.feature===f);
return `<div class="rw" style="margin-bottom:8px"><span style="min-width:250px">${l}</span>
<select class="famode" data-f="${f}"><option value="everyone" ${ev?'selected':''}>Everyone</option><option value="admins" ${ev?'':'selected'}>Admins + granted</option></select>
${ev?'':gs.map(g=>`<span class="chip">${E(uName(g.user_id))} <b class="fgx" data-id="${g.id}" style="cursor:pointer">✕</b></span>`).join('')+
`<select class="fgadd" data-f="${f}" style="max-width:140px;font-size:12px;padding:4px 6px"><option value="">Grant to…</option>${ppl.map(p=>`<option value="${p.id}">${E(p.n)}</option>`).join('')}</select>`}
</div>`}).join('')}
<div id="fa_msg"></div></div>
${me.platform?`<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Date format <span class="mu" style="font-weight:400;font-size:13px;vertical-align:middle">\u00b7 portal admin only</span></h2>
<div class="mu" style="margin-bottom:8px">How numeric dates are written for everyone in the portal. Dates that already spell the month out, like 08 Sep 2026, are not affected.</div>
<div class="rw" style="gap:8px;align-items:center"><select id="df_sel" style="max-width:260px"><option value="dmy" ${DFMT==='dmy'?'selected':''}>Day first \u2014 ${E(FD(new Date()))}</option><option value="mdy" ${DFMT==='mdy'?'selected':''}>Month first \u2014 ${E((()=>{const _o=DFMT;DFMT='mdy';const _v=FD(new Date());DFMT=_o;return _v})())}</option><option value="ymd" ${DFMT==='ymd'?'selected':''}>Year first \u2014 ${E((()=>{const _o=DFMT;DFMT='ymd';const _v=FD(new Date());DFMT=_o;return _v})())}</option></select></div>
<div id="df_msg"></div></div>`:''}
${me.platform?`<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Send back to Inbox</h2>
<div class="mu" style="margin-bottom:8px">Who can return an assigned ticket to the Inbox with a remark. You (portal admin) can always send any ticket back.</div>
<label class="rw" style="gap:8px;cursor:pointer;margin-bottom:8px"><input type="checkbox" id="sb_en" ${SBEN?'checked':''}> <span class="mu">Send back is available</span></label>
<div class="mu" id="sb_hint" style="display:none;margin-bottom:7px">Send back is switched off \u2014 turn it on above to choose who can use it.</div>
<div class="rw" id="sb_box" style="gap:10px;flex-wrap:wrap"><label class="mu">Who can send back <select id="sb_scope"><option value="everyone" ${SBSCOPE==='everyone'?'selected':''}>Everyone (their own)</option><option value="admins" ${SBSCOPE==='admins'?'selected':''}>Admins only</option></select></label><label class="mu">Admins can send back <select id="sb_all"><option value="all" ${SBADMINALL?'selected':''}>Anyone’s ticket</option><option value="own" ${!SBADMINALL?'selected':''}>Only their own</option></select></label></div>
<div id="sb_msg"></div></div>`:''}${me.platform?`<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Help tickets \u2014 auto-confirm</h2>
<div class="mu" style="margin-bottom:8px">When you mark a help ticket resolved it waits for the person who raised it to confirm. If they never reply, close it automatically after this many days. They are told it closed itself and can still reopen it.</div>
<div class="rw" style="gap:10px;flex-wrap:wrap;align-items:center"><label class="mu">Close automatically after <input id="ac_d" type="number" min="0" max="365" style="width:80px" value="${SUPAC}"> days <span class="mu">(<b>0 = never</b> \u2014 wait for them indefinitely)</span></label><button class="pri" id="ac_s">Save</button></div>
<div id="ac_msg"></div></div>`:''}<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Ignore & block approvals</h2>
<div class="mu" style="margin-bottom:8px">Optional safety net. Pick an approver and members' <b>Ignore</b> / <b>Block</b>
actions wait in Inbox for that person (or any admin) to approve before they apply. Admins and the approver themselves
act immediately. "No approval needed" lets everyone act directly.</div>
<label class="rw" style="gap:8px;cursor:pointer;margin-bottom:10px"><input type="checkbox" id="ap_any" ${APPR?.approver_any_admin?'checked':''}> <span class="mu"><b>Any admin</b> \u2014 approvals are required and any admin can approve (no specific person needed)</span></label>
<div class="mu" style="margin-bottom:6px">Or pick specific approvers:</div>
<div id="ap_who" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:6px 14px;max-height:200px;overflow:auto;border:1px solid var(--c-border);border-radius:9px;padding:10px">${ppl.map(p=>`<label class="rw" style="gap:8px;cursor:pointer"><input type="checkbox" class="ap_ck" value="${p.id}" ${((APPR?.approver_ids&&APPR.approver_ids.includes(p.id))||APPR?.approver_id===p.id)?'checked':''}> <span class="mu">${E(p.n)}</span></label>`).join('')}</div>
<div class="mu" style="margin-top:8px">Nothing ticked and \u201cAny admin\u201d off = no approval needed \u2014 everyone acts directly.</div>
<div id="ap_msg"></div></div>
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Drafts visibility</h2>
<div class="mu" style="margin-bottom:8px">Who can see (and act on) a saved draft.</div>
<div class="rw"><select id="ds_scope"><option value="account" ${DRAFTSCOPE==='mailbox'?'':'selected'}>Account-specific — each person sees only their own drafts</option><option value="mailbox" ${DRAFTSCOPE==='mailbox'?'selected':''}>Mailbox-specific — anyone with access to a mailbox sees drafts composed from it</option></select></div>
<div id="ds_msg"></div></div>
${me.platform?`<div class="card" style="margin-top:14px;border-color:var(--c-accent)"><h2 style="margin-bottom:8px">🔒 “Only show to” restrictions</h2>
<div class="mu" style="margin-bottom:8px">Master switch for sender restrictions. Turn it off and every restricted sender’s mail returns to the shared Inbox for everyone — the restrictions themselves are kept and switch back on when you re-enable it. Only you can change this.</div>
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" id="rst_en" ${RESTRICTON?'checked':''}> <span class="mu"><b style="color:var(--c-text)" id="rst_lbl">Restrictions are ${RESTRICTON?'ON':'OFF'}</b></span></label>
<div id="rst_msg"></div></div>`:''}
<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Who members can email</h2>
<div class="mu" style="margin-bottom:10px">Controls which recipients replies and new mail may go to. Admins always send freely; anything outside the chosen scope waits for per-message approval.</div>
<div id="sm_opts">${[['list','Approved list only','Just the addresses &amp; domains listed below, your own domain, and each client’s own recorded contacts.'],['known','Anyone we’ve corresponded with','Everything in “Approved list only”, plus every address in your captured Contacts and every client mail ID stored in the intranet directory. Staff members’ personal addresses stay blocked.'],['open','Any recipient','No allow-list and no approval — mail can go to any address.']].map(([v,t,d])=>`<label class="rw" style="gap:10px;align-items:flex-start;margin:0 0 8px;cursor:pointer;padding:10px 12px;border:1px solid ${SMODE===v?'var(--c-accent)':'var(--c-border)'};border-radius:10px"><input type="radio" name="smode" value="${v}" ${SMODE===v?'checked':''} style="margin-top:3px"> <span><b style="color:var(--c-text)">${t}</b><div class="mu" style="margin-top:2px">${d}</div></span></label>`).join('')}</div>
<div id="os_msg" style="margin:2px 0 8px"></div>
<div class="prefh" style="margin:12px 0 6px">Approved addresses &amp; domains</div>
<div class="mu" style="margin-bottom:8px">Outside addresses — or whole domains — team members may email directly, used by the first two options above (on top of your own domain and each client’s recorded contacts). Anything not covered needs per-message approval.</div>
<div class="rw">${AR.map(a=>`<span class="chip">${E(a.email||('@'+a.domain))}${a.note?` <span class="mu">· ${E(a.note)}</span>`:''} <b class="arx" data-id="${a.id}" style="cursor:pointer" title="Remove">✕</b></span>`).join('')||'<span class="mu">None yet.</span>'}</div>
<div class="rw" style="margin-top:10px"><input id="ar_e" placeholder="name@example.com or example.com" style="min-width:240px"><input id="ar_n" placeholder="Note (optional)" style="min-width:150px"><button class="pri" id="ar_add">Add</button></div>
<div id="ar_msg"></div></div></div>`:'';
return `<div class="card" style="margin-bottom:12px"><h2 style="margin-bottom:14px">Your preferences</h2>
<div class="prefgrp"><div class="prefh">Sidebar</div><label class="rw" style="gap:8px;cursor:pointer"><input type="checkbox" id="pf_hidemyreq" ${HIDEMYREQ?'checked':''}> <span class="mu">Hide the “My requests” tab when nothing is open (reach it any time from 🛟 Report an issue → Track my tickets)</span></label></div>
<div class="prefgrp"><div class="prefh">Appearance</div>
<div class="rw" style="gap:16px;flex-wrap:wrap;align-items:center"><label class="mu">Font <select id="pf_font">${FONTS.map(([v,l])=>`<option value="${E(v)}" ${UFONT===v?'selected':''} style="font-family:${v||'inherit'}">${E(l)}</option>`).join('')}</select></label><label class="mu">Text size <select id="pf_size">${[[90,'Small'],[100,'Normal'],[105,'Medium'],[110,'Large'],[125,'Largest']].map(([v,l])=>`<option value="${v}" ${USIZE===v?'selected':''}>${l}</option>`).join('')}</select></label><label class="mu">Theme <select id="pf_theme"><option value="outlook" ${curBrand()==='outlook'?'selected':''}>Outlook</option><option value="gmail" ${curBrand()==='gmail'?'selected':''}>Gmail</option></select></label><label class="mu">Mode <select id="pf_mode"><option value="light" ${curMode()==='light'?'selected':''}>Light</option><option value="dark" ${curMode()==='dark'?'selected':''}>Dark</option></select></label></div></div>
<div class="prefgrp"><div class="prefh">Sending</div>
<div class="rw" style="gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between;border:1px solid var(--c-border);border-radius:9px;padding:11px 13px">
<div style="flex:1;min-width:230px"><div style="font-weight:600">Signature</div><div class="mu" style="margin-top:3px">${(SIG&&((SIG.html||'').trim()||(SIG.text||'').trim()))?'Set \u2014 added to the bottom of every mail and reply you send.':'Not set yet \u2014 nothing is added to the bottom of your mail.'}</div></div>
<button class="gh" id="sig" style="flex:0 0 auto">${(SIG&&((SIG.html||'').trim()||(SIG.text||'').trim()))?'Edit signature\u2026':'Add a signature\u2026'}</button></div>
<div class="prefh" style="margin:16px 0 4px">Send with Ctrl+Enter</div>
<div class="mu" style="margin-bottom:8px">Press <b>Ctrl+Enter</b> (<b>\u2318+Enter</b> on a Mac) to send without reaching for the mouse. Tick where it should apply.</div>
<div id="pf_ce" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:8px 16px;border:1px solid var(--c-border);border-radius:9px;padding:11px 13px">
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" class="ce_ck" data-k="mail" ${CE.mail!==false?'checked':''}> <span class="mu">New mail \u2014 Send on next run</span></label>
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" class="ce_ck" data-k="reply" ${CE.reply!==false?'checked':''}> <span class="mu">Replies \u2014 Send on next run</span></label>
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" class="ce_ck" data-k="help" ${CE.help!==false?'checked':''}> <span class="mu">Help tickets \u2014 Send</span></label>
</div></div>
<div class="prefgrp"><div class="prefh">Notifications</div>
<div class="rw" style="gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between;border:1px solid var(--c-border);border-radius:9px;padding:11px 13px">
<div style="flex:1;min-width:230px"><div style="font-weight:600">Notifications on this device</div><div class="mu" id="pf_notif_msg" style="margin-top:3px">Checking\u2026</div></div>
<button id="pf_notif" class="gh" style="flex:0 0 auto">Checking\u2026</button></div>
<div class="prefh" style="margin:16px 0 4px">Alert me about</div>
<div class="mu" style="margin-bottom:8px">Each one sends a push notification and shows the in-app nudge. This is per person \u2014 it applies on every device you sign in on.</div>
<div class="mu" id="pf_ev_hint" style="display:none;margin-bottom:7px">Notifications are off on this device \u2014 turn them on above to change these.</div>
<div id="pf_ev" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:8px 16px;border:1px solid var(--c-border);border-radius:9px;padding:11px 13px">
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" data-ev="assigned" checked> <span class="mu">Mail &amp; tickets assigned to me</span></label>
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" data-ev="sendback" checked> <span class="mu">Send-backs &amp; document-pool items</span></label>
${(me.crm||_aprs().indexOf(me.id)>-1)?`<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" data-ev="approvals" checked> <span class="mu">Approvals waiting for me</span></label>`:``}
<label class="rw" style="gap:8px;align-items:center;cursor:pointer"><input type="checkbox" data-ev="support" checked> <span class="mu">Replies on my help tickets</span></label>
</div></div>
<div class="prefgrp"><div class="prefh">Your account</div>
<div class="rw" style="gap:12px;align-items:center;margin-bottom:10px"><span id="av_prev">${me.avatar?`<img src="${E(me.avatar)}" alt="" style="width:46px;height:46px;border-radius:50%;object-fit:cover">`:avat(me.name)}</span><button class="gh" id="av_up">Upload photo</button><button class="gh" id="av_rm" ${me.avatar?'':'hidden'}>Remove</button><span class="mu">Optional profile photo — shown next to your name in the sidebar.</span></div>
<div class="rw" style="gap:12px;flex-wrap:wrap;align-items:center"><span class="mu">Username <b id="acc_un">@${E(UNM||'—')}</b></span><button class="gh" id="acc_unb">Change username</button><button class="gh" id="acc_pwb">Change password</button></div></div>
<div class="prefgrp"><div class="prefh">Keyboard shortcuts</div>
<div class="mu" style="margin:-2px 0 10px">One key each; clear a box to switch that shortcut off. Press <kbd class="kbd">?</kbd> (when you're not typing in a box) for the full list.</div>
<div class="rw" style="flex-wrap:wrap;gap:8px">${SC_ACTIONS.filter(a=>a[0]!=='help').map(([id,l])=>`<label class="mu" style="display:inline-flex;align-items:center;gap:5px;border:1px solid var(--c-border);border-radius:7px;padding:4px 8px">${E(l)} <input class="sc_key" data-a="${id}" value="${E(SC[id]??scDefaults()[id]??'')}" maxlength="1" style="width:32px;text-align:center;font-weight:700"></label>`).join('')}</div>
<div class="rw" style="margin-top:10px"><button class="pri" id="sc_save">Save shortcuts</button><button class="gh" id="sc_reset">Reset to defaults</button><span class="mu" id="sc_msg"></span></div></div></div>
<div class="card" id="cl_card" style="margin-bottom:12px">
<div class="rw" id="cl_head" role="button" tabindex="0" style="justify-content:space-between;align-items:center;cursor:pointer;gap:10px"><h2 style="margin:0">What’s new <span class="mu" style="font-weight:400;font-size:13px;vertical-align:middle">· you’re on v${APP_VERSION}</span></h2><span id="cl_chev" class="mu" style="font-size:15px;transition:transform .15s">▸</span></div>
<div id="cl_body" hidden>
<div class="mu" style="margin:8px 0 6px">A running log of updates to the portal — newest first.</div>
<div id="cl_list">Loading…</div>
${me.platform?`<div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--c-border)"><div class="prefh" style="margin-bottom:4px">Publish an update</div>
<div class="mu" style="margin-bottom:8px">Enter a two-part version for the release (e.g. <b>1.6</b>). Each line you write below becomes its own numbered change — 1.6.0, 1.6.1, and so on.</div>
<div class="rw" style="flex-wrap:wrap;gap:8px"><input id="cl_ver" placeholder="Version e.g. 1.6" style="width:130px"><input id="cl_date" type="date" value="${toDate(new Date())}"><input id="cl_title" placeholder="Title (e.g. Faster sending)" style="min-width:220px;flex:1"></div>
<textarea id="cl_notes" placeholder="What changed — one change per line (each becomes 1.6.0, 1.6.1, …)" style="width:100%;box-sizing:border-box;min-height:70px;margin-top:8px"></textarea>
<div class="rw" style="margin-top:8px"><button class="pri" id="cl_add">Publish</button><span class="mu" id="cl_msg"></span></div></div>`:''}
</div></div>
<div class="note">Everything is intercepted — inbox, spam and category tabs — and synced automatically about every ${_syncMin} minute${_syncMin===1?'':'s'}. Use ⟳ Sync now at the top of Inbox to pull immediately. Mail is kept for the number of days set under the Retention tab.</div>
<table><tr><th>Mailbox</th><th>Connection</th><th>Last checked</th><th>Last mail in</th>${me.crm?'<th>Active</th>':''}</tr>
${data.map(i=>{const raw=INB.find(x=>x.email_address===i.email_address);
return `<tr><td><b>${E(i.email_address)}</b><div class="rw" style="gap:6px;align-items:center;flex-wrap:nowrap;margin-top:2px"><span class="mu" style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${E(i.label||'\u2014')}</span>${(me.crm&&raw?.id)?`<b class="inblbl" data-id="${E(raw.id)}" data-l="${E(i.label||'')}" data-e="${E(i.email_address)}" title="Rename this mailbox label" style="cursor:pointer;color:var(--c-accent);font-weight:400;font-size:12px;flex:0 0 auto">\u270e</b>`:''}</div></td>
<td><span class="pill ${i.health==='ok'?'d':'w'}">${E(i.health)}</span>${i.sync_error?`<div class="mu">${E(i.sync_error)}</div>`:''}${i.health!=='ok'?`<div style="margin-top:6px"><button class="gh mbalert" data-e="${E(i.email_address)}" data-h="${E(i.health)}" data-m="${E(i.sync_error||'')}" title="Raise a help ticket with the portal admin about this mailbox" style="font-size:12px;padding:4px 9px;border-color:var(--c-accent);color:var(--c-accent)">\uD83D\uDD14 Alert portal admin</button></div>`:''}</td>
<td class="mu">${i.last_synced_at?A(i.last_synced_at):'never'}</td>
<td class="mu" title="${E(i.mails_30d!=null?i.mails_30d+' mails in the last 30 days'+(i.quiet_after_hours!=null?' \u00b7 rarely silent for more than '+i.normal_quiet_hours+'h \u00b7 flagged past '+i.quiet_after_hours+'h':''):'')}">${i.last_mail_at?A(i.last_mail_at):'never'}${i.mail_flow==='quiet'?`<div style="margin-top:4px;color:#ff9a9a">\u26a0 nothing for ${E(i.hours_since_mail)}h \u2014 unusual for this mailbox</div>`:''}</td>
${me.crm?`<td><div class="rw" style="gap:2px"><button class="tgl" data-id="${raw?.id??''}" data-on="${raw?.is_active?1:0}">${raw?.is_active?'On':'Off'}</button>
<button class="gh inbdel" data-id="${raw?.id??''}" title="Delete this mailbox from the portal (Gmail untouched)">🗑</button></div></td>`:''}</tr>`}).join('')}</table>
${mbAdd}
${me.platform?`<div class="card" id="mrl_card" style="margin-top:14px"><div class="rw" id="mrl_head" role="button" tabindex="0" style="justify-content:space-between;align-items:center;cursor:pointer;gap:10px"><h2 style="margin:0">Mail collection runs <span class="mu" style="font-weight:400;font-size:13px;vertical-align:middle">\u00b7 portal admin only</span></h2><span id="mrl_chev" class="mu" style="font-size:15px;transition:transform .15s">\u25b8</span></div>
<div id="mrl_body" hidden>
<div class="mu" style="margin:8px 0 6px">Every collection cycle. Kept for 30 days.</div>
<div class="rw" style="gap:8px;margin-bottom:8px"><select id="mrl_show"><option value="">All runs</option><option value="prob">Only with problems</option><option value="got">Only that collected mail</option></select><select id="mrl_sort"><option value="new">Newest first</option><option value="old">Oldest first</option><option value="slow">Slowest first</option><option value="most">Most collected</option></select></div>
<div id="mrl_box" class="mu">Loading\u2026</div>
</div></div>`:''}
${(me.crm||FEAT.housekeeping)?`<div class="card" style="margin-top:14px"><h2 style="margin-bottom:8px">Housekeeping</h2>
<div class="mu" style="margin-bottom:8px">Mass-ignore old unsorted mail — everything before the date moves to Archive → Ignored (restorable any time; nothing is deleted).</div>
<div class="rw"><select id="mi_in"><option value="">All mailboxes</option>${INB.map(i=>`<option value="${i.id}">${E(i.email_address)}</option>`).join('')}</select><input type="date" id="mi_d" max="${toDate(new Date())}"><button class="gh" id="mi_go">Ignore before this date</button></div></div>`:''}
${admin}`}
function uaLabel(ua){ua=ua||'';let os='an unknown device';
if(/iPhone/.test(ua))os='iPhone';else if(/iPad/.test(ua))os='iPad';else if(/Android/.test(ua))os='Android';
else if(/Windows/.test(ua))os='Windows';else if(/Mac OS X|Macintosh/.test(ua))os='Mac';else if(/Linux/.test(ua))os='Linux';
let br='';if(/Edg\//.test(ua))br='Edge';else if(/OPR\/|Opera/.test(ua))br='Opera';else if(/Chrome\//.test(ua)&&!/Chromium/.test(ua))br='Chrome';else if(/Firefox\//.test(ua))br='Firefox';else if(/Version\/.*Safari/.test(ua))br='Safari';else if(/Safari/.test(ua))br='Safari';
return br?br+' on '+os:os;}
function devIcon(ua){return /iPhone|iPad|Android|Mobile/.test(ua||'')?'📱':'💻';}
async function ipCity(ip){if(!ip)return null;try{const c=new AbortController();const t=setTimeout(()=>c.abort(),3500);
const r=await fetch('https://ipwho.is/'+encodeURIComponent(ip)+'?fields=city,region,country,success',{signal:c.signal});clearTimeout(t);
const j=await r.json();if(j&&j.success!==false){return [j.city,j.country].filter(Boolean).join(', ')||null}}catch(e){}return null}
function sessionsModal(list,opt){return new Promise(res=>{const o=document.createElement('div');o.className='mdl';
const who=opt.who||'this account';
const title=opt.isSelf?'Password changed — sign out other devices?':('Sign out '+who+'’s other devices?');
const intro=opt.isSelf?'Your password was just changed on this device. The devices below are still signed in with the old password (existing sign-ins keep working until you end them). Sign them out to be safe — you’ll stay signed in here.':('These devices are currently signed in as '+who+'. A password reset does not sign them out on its own, so it’s safest to end all of their sessions — they’ll have to sign in again with the new temporary password.');
const rowsHtml=list.map((r,i)=>`<div class="rw" style="align-items:flex-start;gap:10px;padding:9px 0;border-top:1px solid var(--c-border)"><span style="font-size:19px;line-height:1.2">${devIcon(r.user_agent)}</span><div style="flex:1;min-width:0"><div><b>${E(uaLabel(r.user_agent))}</b>${r.is_current?' <span class="mu">· this device</span>':''}</div><div class="mu" id="sloc_${i}">${E(r.ip||'Unknown location')}</div><div class="mu">Last active ${E(Ap(r.last_seen))}</div></div></div>`).join('');
o.innerHTML=`<div class="mdl-box" role="dialog" aria-modal="true"><div class="mdl-t">${E(title)}</div><div class="mdl-m">${E(intro)}</div><div style="max-height:260px;overflow:auto;margin:4px 0 14px">${rowsHtml}</div><div class="mdl-a"><button class="gh" id="ssx">Keep them signed in</button><button class="pri mdl-danger" id="ssok">${opt.isSelf?'Sign out other devices':'Sign out all devices'}</button></div></div>`;
document.body.appendChild(o);const shut=v=>{o.remove();res(v)};
o.querySelector('#ssok').onclick=()=>shut(true);o.querySelector('#ssx').onclick=()=>shut(false);
o.addEventListener('mousedown',e=>{if(e.target===o)shut(false)});
list.forEach((r,i)=>{if(r.ip){ipCity(r.ip).then(c=>{const el=o.querySelector('#sloc_'+i);if(c&&el&&el.isConnected)el.textContent=c+' · '+r.ip})}});})}
async function otherSessions(userId){try{const{data}=await hd.rpc('list_user_sessions',{p_user:userId});return (data||[]).filter(r=>!r.is_current)}catch(e){return[]}}
async function offerSessionSignout(userId,isSelf,who,preList){
let list;
if(preList){list=preList}
else{let rows=[];try{const{data}=await hd.rpc('list_user_sessions',{p_user:userId});rows=data||[]}catch(e){return}
list=isSelf?rows.filter(r=>!r.is_current):rows;}
if(!list||!list.length)return;
const go2=await sessionsModal(list,{isSelf,who});if(!go2)return;
try{if(isSelf){const{error}=await pb.auth.signOut({scope:'others'});if(error)throw error;toast('Signed out your other devices ✓')}
else{const{data:n,error}=await hd.rpc('revoke_other_sessions',{p_user:userId,p_keep_current:false});if(error)throw error;const c=(typeof n==='number'?n:list.length);toast((who||'They')+' signed out of '+c+' device'+(c===1?'':'s')+' ✓')}
try{await hd.rpc('log_act',{p_tenant:me.tenant,p_action:'sessions_signed_out',p_kind:'member',p_id:userId,p_label:who||'',p_detail:{self:!!isSelf}})}catch(e){}}
catch(e){toast(e.message||'Could not sign out other sessions',true)}}
const SEND_NOW_WARN='Send this now?\n\n“Send now” pushes your message out within about a minute instead of waiting for the next scheduled run. It’s meant for genuinely urgent mail only — please don’t use it for routine messages, since overusing it slows sending down for everyone.';
async function markPriority(id){try{const{error:_pe}=await hd.from('outbound_messages').update({priority:true,priority_at:new Date().toISOString()}).eq('id',id);if(_pe)toast('Sent to the queue, but it could not be marked urgent: '+_pe.message,true)}catch(e){toast('Sent to the queue, but it could not be marked urgent',true)}
try{await hd.rpc('log_act',{p_tenant:me.tenant,p_action:'mail_send_now',p_kind:'mail',p_id:id,p_label:'',p_detail:{}})}catch(e){}}
async function kickRunner(){try{const{data:{session}}=await pb.auth.getSession();if(session)await fetch(RUNNER,{headers:{authorization:'Bearer '+session.access_token}})}catch(e){}}
async function sendNowKick(id,waitDebounce){
if(waitDebounce)await new Promise(r=>setTimeout(r,16000));
await kickRunner();
for(let i=0;i<12;i++){await new Promise(r=>setTimeout(r,7000));
let d;try{const q=await hd.from('outbound_messages').select('status,error').eq('id',id).maybeSingle();d=q.data}catch(e){return}
if(!d)return;
if(d.status==='sent'){toast('Sent ✓');if(tab==='sent')go(true);return}
if(d.status==='failed'){toast('Send failed — it’s in Drafts to fix and resend'+(d.error?': '+d.error:''),true);if(tab==='sent'||tab==='drafts')go(true);return}
if(d.status==='blocked'){toast('Held for approval before it can go out',true);return}}
toast('Still sending — it will go out on the next run shortly.');}
const APP_VERSION='5.4';
const clDate=d=>{try{return new Date(d).toLocaleDateString(undefined,{day:'numeric',month:'short',year:'numeric'})}catch(_){return''}};
async function renderChangelog(){
const box=document.getElementById('cl_list');if(!box)return;
const{data,error}=await hd.from('changelog').select('*').order('released_at',{ascending:false}).order('version',{ascending:false});
if(error){box.innerHTML='<span class="mu">Could not load updates.</span>';return}
if(!data||!data.length){box.innerHTML='<span class="mu">No updates yet.</span>';return}
box.innerHTML=data.map(c=>{const pts=(c.notes||'').split('\n').map(s=>s.trim()).filter(Boolean);
return `<div style="padding:10px 0;border-top:1px solid var(--c-border)"><div class="rw" style="align-items:baseline;gap:8px"><span class="pill d">v${E(c.version)}</span><b>${E(c.title||'')}</b><span class="mu" style="margin-left:auto">${E(clDate(c.released_at))}</span>${me.platform?`<b class="cle" data-id="${c.id}" title="Edit this update" style="cursor:pointer;color:var(--c-accent);margin-left:4px">✎</b><b class="clx" data-id="${c.id}" title="Delete this update" style="cursor:pointer;color:#c0392b;margin-left:6px">✕</b>`:''}</div>${pts.length?`<div style="margin-top:8px">${pts.map((p,i)=>`<div style="display:flex;flex-wrap:nowrap;align-items:baseline;gap:8px;padding:3px 0"><code style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;color:var(--c-muted);flex:0 0 auto;min-width:46px">${E(c.version)}.${i}</code><span style="flex:1;min-width:0">${E(p)}</span></div>`).join('')}</div>`:''}</div>`;
}).join('');
box.querySelectorAll('.clx').forEach(b=>b.onclick=async()=>{if(!confirm('Delete this update from the changelog?'))return;const{error}=await hd.rpc('delete_changelog',{p_id:b.dataset.id});if(error){alert(error.message);return}renderChangelog();});
box.querySelectorAll('.cle').forEach(b=>b.onclick=()=>{const c=data.find(x=>String(x.id)===String(b.dataset.id));if(!c)return;const _d=new Date(c.released_at);const _ds=isNaN(_d.getTime())?'':new Date(_d.getTime()-_d.getTimezoneOffset()*60000).toISOString().slice(0,10);const o=document.createElement('div');o.className='mdl';o.innerHTML=`<div class="mdl-box" role="dialog" aria-modal="true" style="width:min(560px,calc(100vw - 20px))"><h2 class="mdl-t">\u270e Edit update</h2><div class="rw" style="gap:12px;flex-wrap:wrap;margin-bottom:8px"><label class="mu">Version <input id="ce_v" style="width:90px" value="${E(c.version||'')}"></label><label class="mu">Date <input id="ce_d" type="date" value="${_ds}"></label></div><input id="ce_t" style="width:100%;margin-bottom:8px" value="${E(c.title||'')}" placeholder="Title"><textarea id="ce_n" rows="6" style="width:100%" placeholder="One change per line">${E(c.notes||'')}</textarea><div id="ce_m" class="mu" style="margin-top:6px"></div><div class="rw" style="margin-top:12px;justify-content:flex-end;gap:8px"><button class="gh" id="ce_x">Cancel</button><button class="pri" id="ce_s">Save changes</button></div></div>`;document.body.appendChild(o);const _cl=()=>o.remove();o.querySelector('#ce_x').onclick=_cl;o.onclick=e=>{if(e.target===o)_cl()};o.querySelector('#ce_s').onclick=async()=>{const _v=(o.querySelector('#ce_v').value||'').trim(),_t=(o.querySelector('#ce_t').value||'').trim(),_n=(o.querySelector('#ce_n').value||'').trim(),_dt=o.querySelector('#ce_d').value,_m=o.querySelector('#ce_m');if(!_v||!_t){_m.textContent='Version and title are required.';return}if(!/^[0-9]+[.][0-9]+$/.test(_v)){_m.textContent='Use a two-part version like 2.1 \u2014 each line becomes 2.1.0, 2.1.1\u2026';return}const _sb=o.querySelector('#ce_s');_sb.disabled=1;_m.textContent='Saving\u2026';const{error}=await hd.rpc('update_changelog',{p_id:c.id,p_version:_v,p_title:_t,p_notes:_n,p_released:_dt?new Date(_dt+'T12:00:00').toISOString():null});_sb.disabled=0;if(error){_m.textContent=error.message;return}_cl();toast('Update saved');renderChangelog()};});
}
function wireChangelog(){
const head=document.getElementById('cl_head'),body=document.getElementById('cl_body'),chev=document.getElementById('cl_chev');
if(head&&body){const setOpen=o=>{body.hidden=!o;if(chev)chev.style.transform=o?'rotate(90deg)':'';try{localStorage.setItem('cl_open',o?'1':'0')}catch(e){}};
setOpen((()=>{try{return localStorage.getItem('cl_open')==='1'}catch(e){return false}})());
const tog=()=>setOpen(body.hidden);head.onclick=tog;head.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();tog()}};}
const add=document.getElementById('cl_add');if(!add)return;
add.onclick=async()=>{const ver=(document.getElementById('cl_ver').value||'').trim();const title=(document.getElementById('cl_title').value||'').trim();const notes=(document.getElementById('cl_notes').value||'').trim();const dt=document.getElementById('cl_date').value;const msg=document.getElementById('cl_msg');
if(!ver||!title){msg.textContent='Version and title are required.';return}
if(!/^\d+\.\d+$/.test(ver)){msg.textContent='Use a two-part version like 1.6 — each line becomes 1.6.0, 1.6.1…';return}
add.disabled=1;msg.textContent='Publishing…';
const{error}=await hd.rpc('add_changelog',{p_version:ver,p_title:title,p_notes:notes,p_released:dt?new Date(dt+'T12:00:00').toISOString():new Date().toISOString()});
add.disabled=0;
if(error){msg.textContent=error.message;return}
try{await hd.rpc('log_act',{p_tenant:me.tenant,p_action:'changelog_published',p_kind:'settings',p_id:null,p_label:'v'+ver,p_detail:{}})}catch(e){}
document.getElementById('cl_ver').value='';document.getElementById('cl_title').value='';document.getElementById('cl_notes').value='';msg.textContent='Published.';setTimeout(()=>{msg.textContent=''},2500);
renderChangelog();};
}
async function syncNow(sy){sy.disabled=1;const _o=sy.textContent;sy.textContent='Syncing — can take a few minutes…';
try{const{data:{session}}=await pb.auth.getSession();
const r=await fetch(RUNNER,{headers:{authorization:'Bearer '+session.access_token}});
const j=await r.json();if(!r.ok)throw new Error(j.error||('HTTP '+r.status));
const tot=(j.mailboxes||[]).reduce((s,x)=>s+(x.ingested||0),0);
toast(`Sync done in ${j.took_s}s — ${tot} new message${tot===1?'':'s'}, ${j.outbound?.sent??0} sent`);
}catch(e){toast('Sync failed: '+e.message,true)}sy.disabled=0;sy.textContent=_o;go(true)}
function wireMassIgnore(m){const mig=m.querySelector('#mi_go');if(mig)mig.onclick=async()=>{
const d=m.querySelector('#mi_d').value;
if(!d){toast('Pick a date first',true);return}
if(!await conf(`Ignore every unsorted mail received before ${d}?\n\nThey move to Archive → Ignored, where each can be restored with one click — nothing is deleted.`))return;
mig.disabled=1;
const _in=m.querySelector('#mi_in')?.value||null;
try{const{data:n,error}=await hd.rpc('mass_ignore_before',{p_before:new Date(d+'T00:00:00').toISOString(),p_inbox:_in});
error?toast(error.message,true):(toast(`${n??0} mails moved to Archive → Ignored`),go(true))}
catch(e){toast('Could not complete that: '+(e&&e.message||e),true)}
finally{mig.disabled=0}}}
async function exportContactsXlsx(btn){const _o=btn.textContent;btn.disabled=1;btn.textContent='Preparing…';
try{const PG=1000;let all=[],from=0;
for(;;){const{data,error}=await hd.from('contacts').select('id,email,name,msg_count').order('email').range(from,from+PG-1);if(error)throw new Error(error.message);all=all.concat(data||[]);if(!data||data.length<PG)break;from+=PG}
const inbMap={};
for(let i=0;i<all.length;i+=500){const batch=all.slice(i,i+500).map(c=>c.email).filter(Boolean);
try{const{data:ib}=await hd.rpc('contact_inboxes',{p_emails:batch});(ib||[]).forEach(r=>{inbMap[String(r.email).toLowerCase()]=(r.inboxes||[]).join(', ')})}catch(e){}}
let cts=[],f2=0;for(;;){const{data,error}=await hd.from('contact_tags').select('contact_id,tag_id').range(f2,f2+PG-1);if(error)throw new Error(error.message);cts=cts.concat(data||[]);if(!data||data.length<PG)break;f2+=PG}
const tmap=Object.fromEntries(TAGS.map(t=>[t.id,t.name]));const byc={};
cts.forEach(x=>{(byc[x.contact_id]||(byc[x.contact_id]=[])).push(tmap[x.tag_id]||'')});
const tagNames=[...new Set(TAGS.map(t=>t.name).filter(Boolean))].sort();
let restrMap={};if(RESTRICTON){try{const{data:rst}=await hd.rpc('list_restrictions');(rst||[]).forEach(r=>{const nm=(r.viewer_ids||[]).map(id=>uName(id)).filter(x=>x&&x!=='Unknown'&&x!=='System');if(r.allow_admins)nm.push('Admins');restrMap[(r.email||'').toLowerCase()]=nm.join(', ')})}catch(e){}}
await loadScript('https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js');const ExcelJS=window.ExcelJS;if(!ExcelJS)throw new Error('Spreadsheet engine failed to load');
const wb=new ExcelJS.Workbook();const ws=wb.addWorksheet('Contacts');
ws.columns=[{header:'Email',key:'email',width:34},{header:'Name',key:'name',width:22},{header:'Mails',key:'mails',width:8},{header:'Correspondence mailbox',key:'mailbox',width:40},{header:'Tags',key:'tags',width:44}].concat(RESTRICTON?[{header:'Only show to',key:'onlyto',width:34}]:[]);
ws.getRow(1).font={bold:true};ws.views=[{state:'frozen',ySplit:1}];
const lk=wb.addWorksheet('TagList');lk.state='veryHidden';tagNames.forEach((nm,i)=>{lk.getCell('A'+(i+1)).value=nm});
all.forEach(c=>{ws.addRow({email:c.email,name:c.name||'',mails:c.msg_count,mailbox:inbMap[(c.email||'').toLowerCase()]||'',tags:(byc[c.id]||[]).filter(Boolean).sort().join(', '),onlyto:restrMap[(c.email||'').toLowerCase()]||''})});
const N=tagNames.length;
if(N){for(let r=2;r<=all.length+1;r++){ws.getCell('E'+r).dataValidation={type:'list',allowBlank:true,showErrorMessage:false,formulae:['TagList!$A$1:$A$'+N]}}}
const buf=await wb.xlsx.writeBuffer();
const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='contacts-tags-'+new Date().toISOString().slice(0,10)+'.xlsx';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),3000);
toast(all.length+' contacts exported'+(N?' — the Tags column has a dropdown of your tags':''));}catch(e){toast('Export failed: '+e.message,true)}
btn.disabled=0;btn.textContent=_o}
async function importTagsXlsx(fi){const f=fi.files[0];if(!f)return;fi.value='';
try{const mod=await import('https://cdn.jsdelivr.net/npm/xlsx@0.18.5/+esm');const XLSX=mod.default||mod;
const wb=XLSX.read(await f.arrayBuffer(),{type:'array'});const ws=wb.Sheets[wb.SheetNames[0]];
const rows=XLSX.utils.sheet_to_json(ws,{defval:''});
if(!rows.length){toast('That sheet is empty',true);return}
const keyOf=(o,name)=>Object.keys(o).find(k=>k.trim().toLowerCase()===name);
const ek=keyOf(rows[0],'email'),tk=keyOf(rows[0],'tags');
if(!ek||!tk){toast('The sheet needs columns named Email and Tags',true);return}
const PG=1000;let all=[],from=0;for(;;){const{data,error}=await hd.from('contacts').select('id,email').range(from,from+PG-1);if(error)throw new Error(error.message);all=all.concat(data||[]);if(!data||data.length<PG)break;from+=PG}
const cmap=Object.fromEntries(all.map(c=>[c.email.toLowerCase(),c.id]));
const tmap=Object.fromEntries(TAGS.map(t=>[t.name.toLowerCase(),t.id]));
const want=[],newtags=new Set(),missing=new Set();
rows.forEach(r=>{const em=String(r[ek]||'').trim().toLowerCase();if(!em)return;const cid=cmap[em];
const tags=String(r[tk]||'').split(/[,;]/).map(x=>x.trim()).filter(Boolean);
if(!cid){if(tags.length)missing.add(em);return}
tags.forEach(tn=>{want.push({cid,tn});if(!tmap[tn.toLowerCase()])newtags.add(tn)})});
const okk=keyOf(rows[0],'only show to');const restrWant=[];
if(okk){const nameIdx={};ppl.forEach(p=>{nameIdx[(p.n||'').trim().toLowerCase()]=p.id});
rows.forEach(r=>{const em=String(r[ek]||'').trim().toLowerCase();if(!em)return;const raw=String(r[okk]||'').trim();if(!raw)return;let adm=false;const vids=[];raw.split(/[,;]/).map(x=>x.trim()).filter(Boolean).forEach(tok=>{const tl=tok.toLowerCase();if(tl==='admins'||tl==='all admins'){adm=true;return}const id=nameIdx[tl];if(id&&!vids.includes(id))vids.push(id)});if(vids.length||adm)restrWant.push({email:em,viewers:vids,allow_admins:adm})})}
if(!want.length&&!restrWant.length){toast('No matching contacts or “only show to” values found in that sheet',true);return}
const msg='Apply '+want.length+' tag assignment(s) to matched contacts.\n'+
(restrWant.length?restrWant.length+' “only show to” restriction(s).\n':'')+
(newtags.size?newtags.size+' new tag(s) created as Labels: '+[...newtags].slice(0,8).join(', ')+(newtags.size>8?'…':'')+'\n':'')+
(missing.size?missing.size+' email(s) are not in Contacts and will be skipped.\n':'')+'\nProceed?';
if(!await conf(msg))return;
for(const tn of newtags){const{data,error}=await hd.from('tags').insert({tenant_id:me.tenant,name:tn,behavior:'label',created_by:me.id}).select('id,name,behavior,client_name,source').single();
if(error){toast('Could not create tag "'+tn+'": '+error.message,true);return}TAGS.push(data);tmap[tn.toLowerCase()]=data.id}
const cids=[...new Set(want.map(w=>w.cid))];const existing=new Set();
for(let i=0;i<cids.length;i+=200){const{data}=await hd.from('contact_tags').select('contact_id,tag_id').in('contact_id',cids.slice(i,i+200));(data||[]).forEach(x=>existing.add(x.contact_id+'|'+x.tag_id))}
const ins=[],seen=new Set();
want.forEach(w=>{const tid=tmap[w.tn.toLowerCase()];if(!tid)return;const key=w.cid+'|'+tid;if(existing.has(key)||seen.has(key))return;seen.add(key);ins.push({contact_id:w.cid,tag_id:tid,added_by:me.id})});
if(!ins.length&&!restrWant.length){toast('Nothing new — those tags were already set');return}
let done=0,_stop='';for(let i=0;i<ins.length;i+=500){const{error}=await hd.from('contact_tags').insert(ins.slice(i,i+500));if(error){_stop=error.message;break}done+=ins.slice(i,i+500).length}
let rdone=0;for(const rw of restrWant){const{error}=await hd.rpc('set_only_show_to',{p_email:rw.email,p_viewers:rw.viewers,p_allow_admins:rw.allow_admins});if(!error)rdone++}
toast(_stop?`Stopped early \u2014 ${done} of ${ins.length} tag assignment(s) applied. ${_stop}`:[done?done+' tag assignment(s)':'',rdone?rdone+' restriction(s)':''].filter(Boolean).join(' + ')+' applied'+(newtags.size?', '+newtags.size+' new tag(s) created':''));go(true);
}catch(e){toast('Import failed: '+e.message,true)}}
function wireInbox(m){
renderChangelog();wireChangelog();
const sy=m.querySelector('#syncnow');if(sy)sy.onclick=()=>syncNow(sy);
const _sg=m.querySelector('#sig');if(_sg)_sg.onclick=sigModal;
const _pt=m.querySelector('#pf_theme'),_pm=m.querySelector('#pf_mode');const _at=()=>setTheme((_pt?.value||'outlook')+'-'+(_pm?.value||'light'));if(_pt)_pt.onchange=_at;if(_pm)_pm.onchange=_at;
{const _ceb=m.querySelector('#pf_ce');if(_ceb)_ceb.querySelectorAll('.ce_ck').forEach(_c=>_c.onchange=async()=>{CE[_c.dataset.k]=_c.checked;try{await hd.from('user_prefs').upsert({user_id:me.id,ctrl_enter:CE,updated_at:new Date().toISOString()})}catch(e){}toast('Ctrl+Enter '+(_c.checked?'on':'off')+' for this')});}
{const _wgh=m.querySelector('#wg_h');if(_wgh){const _wtg=()=>{const _b=m.querySelector('#wg_body'),_c=m.querySelector('#wg_chev');if(!_b)return;const _op=_b.style.display!=='none';_b.style.display=_op?'none':'';if(_c)_c.style.transform=_op?'':'rotate(90deg)';};_wgh.onclick=_wtg;_wgh.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();_wtg()}};}}
const _hmr=m.querySelector('#pf_hidemyreq');if(_hmr)_hmr.onchange=async()=>{HIDEMYREQ=_hmr.checked;try{await hd.from('user_prefs').upsert({user_id:me.id,hide_myreq_when_empty:HIDEMYREQ,updated_at:new Date().toISOString()})}catch(e){}try{paintNav()}catch(e){}};
{const _dfs=m.querySelector('#df_sel');if(_dfs)_dfs.onchange=async()=>{const v=_dfs.value,o=m.querySelector('#df_msg');_dfs.disabled=1;
const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,date_format:v,updated_by:me.id,updated_at:new Date().toISOString()});
_dfs.disabled=0;
if(error){if(o)o.innerHTML=`<div class="blk">${E(error.message)}</div>`;return}
DFMT=v;TSET={...(TSET||{}),date_format:v};toast('Date format saved \u2014 '+FD(new Date())+' from now on');go(true)};
const _sben=m.querySelector('#sb_en'),_sbsc=m.querySelector('#sb_scope'),_sbal=m.querySelector('#sb_all');const _sbsave=async()=>{if(!_sben)return;const _n1=_sben.checked,_n2=_sbsc.value,_n3=_sbal.value==='all';const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,sendback_enabled:_n1,sendback_scope:_n2,sendback_admin_all:_n3,updated_by:me.id,updated_at:new Date().toISOString()});if(!error){SBEN=_n1;SBSCOPE=_n2;SBADMINALL=_n3}const _o=m.querySelector('#sb_msg');if(error){if(_o)_o.innerHTML=`<div class="blk">${E(error.message)}</div>`;}else{if(_o)_o.innerHTML='<div class="note" style="margin-top:8px">Saved ✓</div>';TSET={...(TSET||{}),sendback_enabled:SBEN,sendback_scope:SBSCOPE,sendback_admin_all:SBADMINALL};}};{const _acs=m.querySelector('#ac_s');if(_acs)_acs.onclick=async()=>{
const _i=m.querySelector('#ac_d'),_o=m.querySelector('#ac_msg');
const v=Math.max(0,Math.min(365,Math.round(+(_i&&_i.value)||0)));
_acs.disabled=1;
const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,support_autoconfirm_days:v,updated_by:me.id,updated_at:new Date().toISOString()});
_acs.disabled=0;
if(error){if(_o)_o.innerHTML=`<div class="blk">${E(error.message)}</div>`;return}
SUPAC=v;TSET={...(TSET||{}),support_autoconfirm_days:v};if(_i)_i.value=v;
if(_o)_o.innerHTML='<div class="note" style="margin-top:8px">Saved \u2713</div>';
toast(v?('Help tickets close themselves after '+v+' day'+(v===1?'':'s')+' without a reply'):'Help tickets now wait for the reporter indefinitely')};}
const _sbdep=()=>{try{setDep(m.querySelector('#sb_box'),!!(_sben&&_sben.checked),m.querySelector('#sb_hint'))}catch(_e){}};
if(_sben)_sben.onchange=()=>{_sbdep();_sbsave()};if(_sbsc)_sbsc.onchange=_sbsave;if(_sbal)_sbal.onchange=_sbsave;_sbdep();}
{const _nb=m.querySelector('#pf_notif'),_nm=m.querySelector('#pf_notif_msg');
if(_nb){const _refresh=async()=>{const st=await notifState();
if(st==='unsupported'){_nb.style.display='none';if(_nm)_nm.textContent=(_isIOS()&&!_isStandalone())?'On iPhone, install the app to your Home Screen first (Share \u2192 Add to Home Screen), then notifications become available.':'This browser doesn\u2019t support notifications.';
try{setDep(m.querySelector('#pf_ev'),false,m.querySelector('#pf_ev_hint'))}catch(_e){}return}
_nb.textContent=st==='on'?'Turn off on this device':'Turn on';
if(_nm)_nm.textContent=st==='on'?'On \u2014 you\u2019ll be alerted about mail assigned to you, send-backs and approvals.':st==='denied'?'Blocked in your browser settings \u2014 allow notifications for this site, then try again.':'Off on this device.';
try{setDep(m.querySelector('#pf_ev'),st==='on',m.querySelector('#pf_ev_hint'))}catch(_e){}};
_refresh();
_nb.onclick=async()=>{_nb.disabled=1;const st=await notifState();if(st==='on'){await notifDisable();toast('Notifications turned off on this device')}else{const ok=await notifEnable();if(ok)toast('Notifications on — this device will alert you')}_nb.disabled=0;_refresh()};}}
{const _ev=m.querySelector('#pf_ev');
if(_ev){hd.rpc('my_notif_prefs').then(({data})=>{const pp=data||{};_ev.querySelectorAll('input[data-ev]').forEach(cb=>{if(pp[cb.dataset.ev]===false)cb.checked=false})});
_ev.querySelectorAll('input[data-ev]').forEach(cb=>cb.onchange=async()=>{cb.disabled=1;const{error}=await hd.rpc('set_notif_pref',{p_event:cb.dataset.ev,p_enabled:cb.checked});cb.disabled=0;if(error){cb.checked=!cb.checked;toast(error.message,true)}else toast(cb.checked?'You’ll be notified about this':'Muted for you')})}}
const _pff=m.querySelector('#pf_font');if(_pff)_pff.onchange=()=>{applyFont(_pff.value);savePrefs()};
const _pfs=m.querySelector('#pf_size');if(_pfs)_pfs.onchange=()=>{applyFontSize(_pfs.value);savePrefs()};
const _footAv=url=>{const fr=document.querySelector('.sfoot .rw');if(!fr)return;let im=fr.querySelector('img');if(url){if(im)im.src=url;else{const ni=document.createElement('img');ni.src=url;ni.alt='';ni.style.cssText='width:34px;height:34px;border-radius:50%;object-fit:cover;flex:0 0 auto';fr.insertBefore(ni,fr.firstChild)}}else if(im)im.remove()};
const _avu=m.querySelector('#av_up');if(_avu)_avu.onclick=async()=>{const url=await avatarPick();if(!url)return;const{error}=await hd.rpc('set_avatar',{p_url:url});if(error){toast(error.message,true);return}me.avatar=url;const pv=m.querySelector('#av_prev');if(pv)pv.innerHTML=`<img src="${url}" alt="" style="width:46px;height:46px;border-radius:50%;object-fit:cover">`;const rm=m.querySelector('#av_rm');if(rm)rm.hidden=false;_footAv(url);toast('Profile photo updated')};
const _avr=m.querySelector('#av_rm');if(_avr)_avr.onclick=async()=>{const{error}=await hd.rpc('set_avatar',{p_url:''});if(error){toast(error.message,true);return}me.avatar='';const pv=m.querySelector('#av_prev');if(pv)pv.innerHTML=avat(me.name);_avr.hidden=true;_footAv('');toast('Profile photo removed')};
const _unb=m.querySelector('#acc_unb');if(_unb)_unb.onclick=async()=>{
const nv=await unamePrompt(UNM||'');if(!nv)return;
const{error}=await hd.rpc('set_own_username',{p_username:nv});
if(error){toast(error.message,true);return}
UNM=nv;const un=m.querySelector('#acc_un');if(un)un.textContent='@'+nv;toast('Username changed — use it next time you sign in')};
const _pwb=m.querySelector('#acc_pwb');if(_pwb)_pwb.onclick=async()=>{
const r=await pwPrompt();if(!r)return;
const _pre=await otherSessions(me.id);
const{data:{user}}=await pb.auth.getUser();const email=user?.email;
if(!email){toast('Could not verify your account — sign out and back in, then retry',true);return}
const{error:ve}=await pb.auth.signInWithPassword({email,password:r.cur});
if(ve){toast('Current password is incorrect',true);return}
const{error}=await pb.auth.updateUser({password:r.next});
if(error){toast(error.message,true);return}
try{await hd.rpc('log_password_change',{p_context:'change'})}catch(e){}
if(_pre.length){toast('Password updated ✓');await offerSessionSignout(me.id,true,null,_pre)}
else toast('Password updated ✓ — no other devices are signed in.')};
const _scS=m.querySelector('#sc_save');if(_scS)_scS.onclick=async()=>{const nm={help:SC.help||'?'};m.querySelectorAll('.sc_key').forEach(i=>{nm[i.dataset.a]=(i.value||'').trim()});
const used={},msg=m.querySelector('#sc_msg');let dup='';
for(const a in nm){const v=nm[a];if(!v)continue;if(used[v]){dup=v;break}used[v]=a}
if(dup){if(msg){msg.style.color='var(--c-danger,#c0392b)';msg.textContent='“'+dup+'” is assigned twice — each key must be unique.'}return}
SC=Object.assign(scDefaults(),nm);await saveShortcuts();if(msg){msg.style.color='';msg.textContent='Saved ✓'}toast('Keyboard shortcuts saved')};
const _scR=m.querySelector('#sc_reset');if(_scR)_scR.onclick=async()=>{SC=scDefaults();await saveShortcuts();toast('Shortcuts reset to defaults');go(true)};
wireMassIgnore(m);
const _tpe=m.querySelector('#tp_eye');if(_tpe)_tpe.onclick=()=>{const i=m.querySelector('#tp_val');const sh=i.type==='password';i.type=sh?'text':'password';_tpe.textContent=sh?'Hide':'Show'};
const _tps=m.querySelector('#tp_save');if(_tps)_tps.onclick=async()=>{const v=(m.querySelector('#tp_val').value||'').trim(),out=m.querySelector('#tp_msg');
if(v.length<8){out.innerHTML='<div class="blk">At least 8 characters.</div>';return}
_tps.disabled=1;_tps.textContent='Saving…';
try{const{error:_e}=await hd.from('tenant_secrets').upsert({tenant_id:me.tenant,default_temp_password:v,updated_by:me.id,updated_at:new Date().toISOString()});if(_e)throw new Error(_e.message);TSET={...(TSET||{}),__temp_pw:v};
const jj=await AD('list_users',{});const pend=(jj.users||[]).filter(u=>u.must_change);let ok=0;
for(const u of pend){try{await AD('reset_password',{user_id:u.id,password:v});ok++}catch(_x){}}
out.innerHTML=`<div class="note">Saved. Temporary password is now <b>${E(v)}</b>${pend.length?` and re-applied to ${ok} member(s) who haven’t logged in yet`:''}.</div>`;toast('Temporary password updated');loadTeam&&loadTeam()}catch(e){out.innerHTML=`<div class="blk">${E(e.message)}</div>`}
_tps.disabled=0;_tps.textContent='Save'};
{const _oed=m.querySelector('#onb_ed');if(_oed){_oed.innerHTML=cleanGuide(ONBHTML||ONB_DEFAULT);const _om=m.querySelector('#onb_msg');
const _otb=m.querySelector('#onb_tb');if(_otb)_otb.querySelectorAll('button[data-cmd]').forEach(b=>b.onclick=()=>{_oed.focus();const c=b.dataset.cmd;if(c==='createLink'){const u=prompt('Link URL (https://…)');if(u)document.execCommand('createLink',false,u)}else{document.execCommand(c,false,b.dataset.val||null)}});
const _os=m.querySelector('#onb_save');if(_os)_os.onclick=async()=>{_os.disabled=1;_os.textContent='Saving…';const html=cleanGuide(_oed.innerHTML);const en=m.querySelector('#onb_en')?m.querySelector('#onb_en').checked:true;
try{const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,onboarding_html:html,onboarding_enabled:en,updated_by:me.id,updated_at:new Date().toISOString()});if(error)throw new Error(error.message);ONBHTML=html;ONBON=en;if(_om){_om.style.color='';_om.textContent='Saved ✓ — new members will see this on first login.'}toast('Welcome guide saved')}catch(e){if(_om){_om.style.color='var(--c-over-tx)';_om.textContent=e.message}}
_os.disabled=0;_os.textContent='Save guide'};
const _op=m.querySelector('#onb_prev');if(_op)_op.onclick=()=>{const _prev=ONBHTML;ONBHTML=cleanGuide(_oed.innerHTML);showGuide(false);ONBHTML=_prev};
const _or=m.querySelector('#onb_reset');if(_or)_or.onclick=()=>{_oed.innerHTML=cleanGuide(ONB_DEFAULT);if(_om){_om.style.color='';_om.textContent='Loaded the default text — click Save guide to apply it.'}};
const _orsh=m.querySelector('#onb_reshow');if(_orsh)_orsh.onclick=async()=>{if(!await conf('Show the welcome guide again to every member at their next sign-in?',{okText:'Re-show'}))return;try{const{data:_n}=await hd.rpc('reset_onboarding_seen');toast('The guide will reappear for everyone'+(typeof _n==='number'?' ('+_n+')':''))}catch(e){toast(e.message,true)}};}}
m.querySelectorAll('.tgl').forEach(b=>b.onclick=async()=>{
const on=b.dataset.on==='1';
const{error}=await hd.from('inboxes').update({is_active:!on}).eq('id',b.dataset.id);
error?toast(error.message,true):(toast(on?'Mailbox deactivated — it will no longer sync':'Mailbox reactivated'),go(true))});
m.querySelectorAll('.inblbl').forEach(b=>b.onclick=async()=>{
const v=await ask('Label for '+b.dataset.e+'\n\nThis is the short name shown next to the address across the portal.',b.dataset.l||'',{title:'\u270e Rename mailbox label',okText:'Save'});
if(v===null)return;
const nv=(v||'').trim();
if(!nv){toast('A label is required',true);return}
if(nv===(b.dataset.l||'')){return}
const{error}=await hd.from('inboxes').update({label:nv}).eq('id',b.dataset.id);
error?toast(error.message,true):(toast('Label updated to \u201c'+nv+'\u201d'),go(true))});
m.querySelectorAll('.mbalert').forEach(b=>b.onclick=()=>_mbAlert(b));
if(me.platform){const _mrl={show:'',sort:'new',n:0,rows:[],more:false};
const _mrlRender=()=>{const box=m.querySelector('#mrl_box');if(!box)return;box.classList.remove('mu');
if(!_mrl.rows.length){box.innerHTML='<div class="mu">'+(_mrl.show?'No runs match that filter.':'No runs recorded yet \u2014 the first appears within ten minutes.')+'</div>';return}
box.innerHTML=`<table><tr><th>When</th><th>Took</th><th>Collected</th><th>Mailboxes</th><th>Problems</th></tr>`+_mrl.rows.map(r=>{const mb=Array.isArray(r.mailboxes)?r.mailboxes:[];const bad=mb.filter(x=>x&&(x.error||x.note)).map(x=>(x.mailbox||'?').split('@')[0]+': '+(x.error||x.note));return `<tr class="mrlrow" data-mrl="${E(r.id)}" style="cursor:pointer" title="Click for the per-mailbox breakdown"><td>${A(r.at)}</td><td>${r.took_s==null?'\u2014':E(r.took_s)+'s'}</td><td>${r.ingested?`<b>${E(r.ingested)}</b>`:'<span class="mu">0</span>'}</td><td class="mu">${mb.length}</td><td>${bad.length?`<span class="pill o">${E(bad.join(' \u00b7 ').slice(0,140))}</span>`:'<span class="mu">none</span>'}</td></tr><tr class="mrldet" data-det="${E(r.id)}" hidden><td colspan="5" class="mu">Loading\u2026</td></tr>`}).join('')+`</table>`+(_mrl.more?`<div style="margin-top:8px"><button class="gh" id="mrl_more">Load 20 more</button></div>`:`<div class="mu" style="margin-top:8px">Showing all ${_mrl.rows.length} matching run${_mrl.rows.length===1?'':'s'}.</div>`);
const _more=box.querySelector('#mrl_more');if(_more)_more.onclick=()=>_mrlLoad(false);
box.querySelectorAll('.mrlrow').forEach(tr=>{tr.onclick=async()=>{const id=tr.getAttribute('data-mrl');const det=box.querySelector('.mrldet[data-det="'+id+'"]');if(!det)return;const cell=det.firstElementChild;
if(!det.hidden){det.hidden=true;return}
det.hidden=false;if(det.dataset.done)return;
try{const{data,error}=await hd.rpc('mail_run_breakdown',{p_run_id:Number(id)});if(error)throw new Error(error.message);
const rows=data||[];cell.classList.remove('mu');
cell.innerHTML=rows.length?'<table style="margin:0"><tr><th>Mailbox</th><th>Collected</th><th>Visible</th><th>Blocked</th><th>Note</th></tr>'+rows.map(x=>`<tr><td>${E(x.mailbox||'?')}</td><td>${x.ingested?`<b>${E(x.ingested)}</b>`:'<span class="mu">0</span>'}</td><td>${x.visible?E(x.visible):'<span class="mu">0</span>'}</td><td class="mu">${E(x.blocked)}</td><td>${x.note?`<span class="pill o">${E(x.note)}</span>`:'<span class="mu">—</span>'}</td></tr>`).join('')+'</table>':'<span class="mu">No per-mailbox detail recorded for this run.</span>';
det.dataset.done='1'}
catch(e){cell.classList.add('mu');cell.textContent='Could not load the breakdown: '+e.message}}});};
const _mrlLoad=async(reset)=>{const box=m.querySelector('#mrl_box');if(!box)return;
if(reset){_mrl.n=0;_mrl.rows=[];box.classList.add('mu');box.textContent='Loading\u2026'}
try{let q=hd.from('mail_run_log').select('id,at,took_s,ingested,errors,mailboxes');
if(_mrl.show==='prob')q=q.gt('errors',0);
if(_mrl.show==='got')q=q.gt('ingested',0);
q=_mrl.sort==='old'?q.order('at',{ascending:true})
:_mrl.sort==='slow'?q.order('took_s',{ascending:false,nullsFirst:false}).order('at',{ascending:false})
:_mrl.sort==='most'?q.order('ingested',{ascending:false,nullsFirst:false}).order('at',{ascending:false})
:q.order('at',{ascending:false});
const{data,error}=await q.range(_mrl.n,_mrl.n+19);
if(error)throw new Error(error.message);
const got=data||[];_mrl.rows=_mrl.rows.concat(got);_mrl.more=got.length===20;_mrl.n+=got.length;_mrlRender()}
catch(e){box.classList.add('mu');box.textContent='Could not load the run log: '+e.message}};
const _mrh=m.querySelector('#mrl_head');
if(_mrh){const _mrt=()=>{const b=m.querySelector('#mrl_body'),c=m.querySelector('#mrl_chev');if(!b)return;
const op=!b.hidden;b.hidden=op;if(c)c.style.transform=op?'':'rotate(90deg)';
if(!op&&!_mrl.n)_mrlLoad(true)};
_mrh.onclick=_mrt;_mrh.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();_mrt()}}}
const _mrs=m.querySelector('#mrl_show'),_mro=m.querySelector('#mrl_sort');
if(_mrs)_mrs.onchange=()=>{_mrl.show=_mrs.value;_mrlLoad(true)};
if(_mro)_mro.onchange=()=>{_mrl.sort=_mro.value;_mrlLoad(true)};
}
m.querySelectorAll('.inbdel').forEach(b=>b.onclick=async()=>{
if(!await conf('Delete this mailbox from the portal?\n\nOnly the registration here is removed — the Gmail account itself is untouched. A mailbox that already has mail history cannot be deleted (turn it Off instead).'))return;
const{error}=await hd.from('inboxes').delete().eq('id',b.dataset.id);
error?toast(/foreign key|violates|constraint/i.test(error.message)?'This mailbox already has mail history, so it cannot be deleted — turn it Off instead.':error.message,true)
:(toast('Mailbox deleted — Gmail untouched'),go(true))});
m.querySelectorAll('#admtabs b').forEach(b=>b.onclick=()=>{ADMTAB=b.dataset.s;
m.querySelectorAll('#admtabs b').forEach(x=>x.classList.toggle('on',x===b));
m.querySelectorAll('.admsec').forEach(s=>s.hidden=s.dataset.s!==ADMTAB)});
const nba=m.querySelector('#nb_add');if(nba)nba.onclick=async()=>{
const em=m.querySelector('#nb_e').value.trim().toLowerCase(),lb=m.querySelector('#nb_l').value.trim();
const out=m.querySelector('#nb_msg');
if(!em.includes('@')){out.innerHTML='<div class="blk">Enter the full email address.</div>';return}
const row={tenant_id:me.tenant??INB[0]?.tenant_id,email_address:em,label:lb||em.split('@')[0],
route_kind:'crm_queue',is_active:true,route_user_id:null,route_role_id:null};
const{error}=await hd.from('inboxes').insert(row);
error?out.innerHTML=`<div class="blk">${E(error.message)}</div>`
:(toast('Mailbox added — the next sync will pull its last year of mail'),go(true))};
const ctList=m.querySelector('#ct_list');
const drawCT=()=>{if(!ctList)return;
const pages=Math.max(1,Math.ceil(CTOT/CTSZ));
const cc=m.querySelector('#ct_ct');if(cc)cc.textContent=`${CTOT} addresses collected — page ${CTPAGE+1} of ${pages}`;
const pager=`<div class="rw" style="margin-top:10px;justify-content:center"><button class="gh" id="ct_prev" ${CTPAGE<=0?'disabled':''}>‹ Prev</button><span class="mu">page ${CTPAGE+1} / ${pages}</span><button class="gh" id="ct_next" ${CTPAGE>=pages-1?'disabled':''}>Next ›</button></div>`;
ctList.innerHTML=(CT.length?`<table><tr><th>Address</th><th>Name</th><th>Mails</th><th>Mailbox</th><th>Tags</th>${(me.crm&&RESTRICTON)?'<th>Only show to</th>':''}<th></th></tr>`+
CT.map(c=>{const mine=CTT.filter(x=>x.contact_id===c.id);
const _ib=CTINB[(c.email||'').toLowerCase()];const _ibh=_ib===undefined?'<span class="mu">…</span>':(_ib.length?_ib.map(e=>`<span class="pill" style="margin:1px">${E(e.split('@')[0])}</span>`).join(' '):'<span class="mu">—</span>');
return `<tr><td><b>${E(c.email)}</b></td><td class="mu">${E(c.name||'—')}</td><td class="mu">${c.msg_count}</td>
<td>${_ibh}</td>
<td>${mine.map(x=>{const t=TAGS.find(g=>g.id===x.tag_id);return t?`<span class="chip" style="margin:2px">${E(t.name)} <b class="ctx" data-c="${c.id}" data-t="${t.id}" style="cursor:pointer">✕</b></span>`:''}).join('')||'<span class="mu">—</span>'}</td>
${(me.crm&&RESTRICTON)?`<td>${(()=>{const r=RESTR[(c.email||'').toLowerCase()];if(r){const np=(r.viewer_ids||[]).length;return `<span class="chip" style="background:var(--c-accent);color:#fff;margin:2px" title="Only shown to selected people">🔒 ${[r.allow_admins?'admins':'',np?np+' member'+(np===1?'':'s'):''].filter(Boolean).join(' + ')||'set'}</span> <button class="osx gh" data-e="${E(c.email)}" style="font-size:11px;padding:3px 7px">Edit</button>`}return `<button class="osx gh" data-e="${E(c.email)}" style="font-size:11px;padding:3px 7px">🔒 Only show to…</button>`})()}</td>`:''}<td><select class="addtag" data-c="${c.id}" style="max-width:130px;font-size:12px;padding:4px 6px"><option value="">Tag…</option>${TAGS.map(t=>`<option value="${t.id}">${E(t.name)}</option>`).join('')}</select></td></tr>`}).join('')+`</table>`
:'<div class="mu">No contacts match.</div>')+pager;
ctList.querySelectorAll('.ctx').forEach(b=>b.onclick=async()=>{
const{data:_dd,error}=await hd.from('contact_tags').delete().eq('contact_id',b.dataset.c).eq('tag_id',b.dataset.t).select('tag_id');
if(error){toast(error.message,true);return}
if(!_dd||!_dd.length){toast('Could not remove that tag — you may not have permission',true);return}
const _t=TAGS.find(g=>g.id===b.dataset.t),_blk=_t&&(_t.behavior==='block'||_t.behavior==='block_team');
CTT=CTT.filter(x=>!(x.contact_id===b.dataset.c&&x.tag_id===b.dataset.t));toast(_blk?'Sender unblocked — their last 365 days are being re-fetched from Gmail over the next sync runs':'Tag removed');drawCT()});
ctList.querySelectorAll('.addtag').forEach(s=>s.onchange=async()=>{
if(!s.value)return;
const{error}=await hd.from('contact_tags').insert({contact_id:s.dataset.c,tag_id:s.value,added_by:me.id});
if(error)toast(error.message,true);
else{CTT.push({contact_id:s.dataset.c,tag_id:s.value});toast('Tagged — takes effect immediately in Inbox');drawCT()}});
ctList.querySelectorAll('.osx').forEach(b=>b.onclick=async()=>{const em=(b.dataset.e||'').toLowerCase();const r=RESTR[em];const res=await onlyShowToPrompt(em,r?r.viewer_ids:[],r?r.allow_admins:false,!!r);if(!res)return;if(res==='clear'){const{error}=await hd.rpc('clear_only_show_to',{p_email:em});if(error){toast(error.message,true);return}delete RESTR[em];toast('Restriction removed');fetchCT();return}const{error}=await hd.rpc('set_only_show_to',{p_email:em,p_viewers:res.viewers,p_allow_admins:res.allow_admins});if(error){toast(error.message,true);return}RESTR[em]={viewer_ids:res.viewers,allow_admins:res.allow_admins};toast('Saved — only the chosen people see this sender’s mail');fetchCT()});
(()=>{const miss=[...new Set(CT.map(c=>(c.email||'').toLowerCase()).filter(e=>e&&!(e in CTINB)))];if(!miss.length)return;
hd.rpc('contact_inboxes',{p_emails:miss}).then(({data})=>{(data||[]).forEach(r=>{CTINB[String(r.email).toLowerCase()]=r.inboxes||[]});miss.forEach(e=>{if(!(e in CTINB))CTINB[e]=[]});drawCT()}).catch(()=>{miss.forEach(e=>CTINB[e]=[])})})();
const pv=ctList.querySelector('#ct_prev');if(pv)pv.onclick=()=>{if(CTPAGE>0){CTPAGE--;fetchCT()}};
const nx=ctList.querySelector('#ct_next');if(nx)nx.onclick=()=>{CTPAGE++;fetchCT()}};
async function fetchCT(){const q=(m.querySelector('#ct_q')?.value||'').trim(),tag=m.querySelector('#ct_tag')?.value||'';
let idsFilter=null;
if(tag){const t=TAGS.find(x=>x.name===tag);
if(t){const{data:ctt}=await hd.from('contact_tags').select('contact_id').eq('tag_id',t.id).limit(5000);
idsFilter=[...new Set((ctt??[]).map(x=>x.contact_id))];if(!idsFilter.length)idsFilter=['00000000-0000-0000-0000-000000000000']}}
let qq=hd.from('contacts').select('*',{count:'exact'}).order('msg_count',{ascending:false});
if(q)qq=qq.or(`email.ilike.%${q}%,name.ilike.%${q}%`);
if(idsFilter)qq=qq.in('id',idsFilter);
qq=qq.range(CTPAGE*CTSZ,CTPAGE*CTSZ+CTSZ-1);
const{data:ct2,count}=await qq;CT=ct2??[];CTOT=count??CT.length;
const ids2=CT.map(c=>c.id);
const{data:ctt2}=ids2.length?await hd.from('contact_tags').select('*').in('contact_id',ids2):{data:[]};
CTT=ctt2??[];
try{const{data:rst}=await hd.rpc('list_restrictions');RESTR={};(rst||[]).forEach(r=>{RESTR[(r.email||'').toLowerCase()]={viewer_ids:r.viewer_ids||[],allow_admins:!!r.allow_admins}})}catch(e){}
try{const{data:tgr}=await hd.from('tag_restrictions').select('*');TAGR={};(tgr||[]).forEach(r=>{TAGR[r.tag_id]={viewer_ids:r.viewer_ids||[],allow_admins:!!r.allow_admins,connected:!!r.connected}})}catch(e){}
try{drawTR()}catch(e){}
drawCT()}
drawCT();
const drawTR=()=>{const box=m.querySelector('#tr_list');if(!box)return;
const ks=Object.keys(TAGR||{}).filter(id=>TAGS.some(x=>String(x.id)===String(id)));
if(!ks.length){box.innerHTML='<span class="mu">No tag rules yet.</span>';return}
box.innerHTML=ks.map(id=>{const r=TAGR[id];const t=TAGS.find(x=>String(x.id)===String(id));
const who=[r.allow_admins?'all admins':''].concat((r.viewer_ids||[]).map(uName)).filter(Boolean).join(', ');
return `<div class="rw" style="align-items:center;gap:8px;padding:6px 0;border-top:1px solid var(--c-border)"><b>${E(t.name)}</b><span class="mu" style="flex:1;min-width:150px">\u2192 ${E(who||'nobody')}</span><span class="pill ${r.connected?'d':'i'}">${r.connected?'connected':'one-time'}</span><button class="gh tr_ed" data-t="${E(id)}" style="font-size:12px;padding:3px 9px">Edit</button></div>`}).join('');
box.querySelectorAll('.tr_ed').forEach(b=>b.onclick=()=>_trEdit(b.dataset.t))};
const _trEdit=async(tid)=>{const t=TAGS.find(x=>String(x.id)===String(tid));if(!t)return;
const r=TAGR[tid];
const res=await tagShowToPrompt(t.name,r?r.viewer_ids:[],r?r.allow_admins:false,!!r,r?r.connected:TAGRCONN);
if(!res)return;
if(res==='clear'){
if(!await conf('Remove the tag rule for \u201c'+t.name+'\u201d?\n\nAddresses already restricted keep their current setting \u2014 clear those individually below if you want them opened up.',{title:'Remove tag rule',okText:'Remove rule'}))return;
const{error}=await hd.rpc('clear_tag_restriction',{p_tag_id:tid,p_clear_emails:false});
if(error){toast(error.message,true);return}
delete TAGR[tid];toast('Tag rule removed');drawTR();fetchCT();return}
const{data,error}=await hd.rpc('apply_tag_restriction',{p_tag_id:tid,p_viewers:res.viewers,p_allow_admins:res.allow_admins,p_connected:res.connected});
if(error){toast(error.message,true);return}
TAGR[tid]={viewer_ids:res.viewers,allow_admins:res.allow_admins,connected:res.connected};
toast('Applied to '+((data&&data.applied)||0)+' address(es)'+(res.connected?' \u2014 newly tagged ones will follow automatically':''));
drawTR();fetchCT()};
try{setDep(m.querySelector('#tr_box'),RESTRICTON!==false,m.querySelector('#tr_hint'))}catch(_e){}
const _trgo=m.querySelector('#tr_go');if(_trgo)_trgo.onclick=()=>{const s=m.querySelector('#tr_tag');if(!s||!s.value){toast('Choose a tag first',true);return}_trEdit(s.value)};
const _trc=m.querySelector('#tr_cdef');if(_trc)_trc.onchange=async()=>{TAGRCONN=_trc.checked;const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,tag_restrict_connected_default:TAGRCONN,updated_by:me.id,updated_at:new Date().toISOString()});if(error){toast(error.message,true);return}TSET={...(TSET||{}),tag_restrict_connected_default:TAGRCONN};toast(TAGRCONN?'New tag rules stay connected to the tag':'New tag rules are one-time')};
drawTR();
const ctq=m.querySelector('#ct_q');if(ctq){let deb;ctq.oninput=()=>{clearTimeout(deb);deb=setTimeout(()=>{CTPAGE=0;fetchCT()},250)}}
const ctt=m.querySelector('#ct_tag');if(ctt)ctt.onchange=()=>{CTPAGE=0;fetchCT()};
const _cex=m.querySelector('#ct_exp');if(_cex)_cex.onclick=()=>exportContactsXlsx(_cex);
