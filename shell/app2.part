error?toast(error.message,true):(toast('Tag deleted'),go(true))});
const rts=m.querySelector('#rt_s');if(rts)rts.onclick=async()=>{
const v=id=>Math.round(+m.querySelector('#'+id).value),out=m.querySelector('#rt_msg');
const iu={days:1,weeks:7,months:30,years:365}[m.querySelector('#rt_iu').value]??1;
const ign=Math.round((+m.querySelector('#rt_i').value)*iu);
const _aru={days:1,weeks:7,months:30,years:365}[m.querySelector('#rt_aru')?.value]??1;
const _arn=m.querySelector('#rt_ar')?Math.round((+m.querySelector('#rt_ar').value)*_aru):(RET?.archived_delete_after_days??3650);
const bad=[['rt_a','Archiving',30],['rt_t','Attachment deletion',30],['rt_d','Mail deletion',30],['rt_l','Activity log retention',30],['rt_r','Resolved-tab window',1]].find(([id,,mn])=>!(v(id)>=mn&&v(id)<=3650));
if(bad){out.innerHTML=`<div class="blk"><b>${bad[1]}</b> needs a whole number between ${bad[2]} and 3650 days — currently "${m.querySelector('#'+bad[0]).value||'empty'}". Nothing was saved.</div>`;return}
if(!(ign>=1&&ign<=3650)){out.innerHTML='<div class="blk"><b>Ignored-mail cleanup</b> needs between 1 day and 10 years. Nothing was saved.</div>';return}
if(!(_arn>=30&&_arn<=3650)){out.innerHTML='<div class="blk"><b>Archived-mail retention</b> needs between 30 days and 10 years. Nothing was saved.</div>';return}
rts.disabled=1;rts.textContent='Saving…';
const _si=Math.max(10,Math.min(1440,Math.round(+m.querySelector('#rt_sync').value)||10));const _dlm=Math.max(1,Math.min(60,Math.round(+m.querySelector('#rt_dlm').value)||6));const _sad=Math.max(1,Math.min(365,Math.round(+m.querySelector('#rt_sad').value)||90));const _sar=Math.max(1,Math.min(3650,Math.round(+m.querySelector('#rt_sarch')?.value)||90));const _idle=Math.max(0,Math.min(480,Math.round(+m.querySelector('#rt_idle').value)||0));await hd.from('tenant_settings').upsert({tenant_id:me.tenant,sync_interval_minutes:_si,deadline_max_months:_dlm,sent_all_days:_sad,sent_archive_days:_sar,inactivity_minutes:_idle,updated_by:me.id,updated_at:new Date().toISOString()});TSET={...(TSET||{}),sync_interval_minutes:_si,deadline_max_months:_dlm,sent_all_days:_sad,sent_archive_days:_sar,inactivity_minutes:_idle};SADAYS=_sad;SARCH=_sar;IDLE_MIN=_idle;startIdle();
const{data:sv,error}=await hd.from('retention_settings').upsert({tenant_id:me.tenant,archive_after_days:v('rt_a'),attachment_delete_after_days:v('rt_t'),mail_delete_after_days:v('rt_d'),ignored_delete_after_days:ign,archived_delete_after_days:_arn,activity_retention_days:v('rt_l'),resolved_visible_days:v('rt_r'),updated_by:me.id,updated_at:new Date().toISOString()}).select('tenant_id');
rts.disabled=0;rts.textContent='Save';
if(error){out.innerHTML=`<div class="blk">${/check|constraint/i.test(error.message)
?'One of the values is outside the allowed range. Archive, attachments, mails and activity log need 30–3650 days; ignored-mail cleanup 1–3650.'
:/permission|denied|policy|row-level/i.test(error.message)
?'Not saved — only workspace admins can change retention.'
:E(error.message)}</div>`;return}
if(!sv?.length){out.innerHTML='<div class="blk">Nothing was saved — the settings row could not be written. Reload the page and try again.</div>';return}
out.innerHTML=`<div class="note">Saved ✓ — archive after ${v('rt_a')}d · attachment files ${v('rt_t')}d · mails ${v('rt_d')}d · ignored mail ${ign}d · activity log ${v('rt_l')}d · resolved tab ${v('rt_r')}d. Applies from the next mail run, and the change itself is in the Activity log.</div>`;
toast('Retention saved')};
{const _apbox=m.querySelector('#ap_who'),_apany=m.querySelector('#ap_any');
const _apsave=async()=>{
const out=m.querySelector('#ap_msg');
const ids=_apbox?[..._apbox.querySelectorAll('.ap_ck:checked')].map(x=>x.value):[];
const any=!!(_apany&&_apany.checked);
const{data:sv,error}=await hd.from('approval_settings').upsert({tenant_id:me.tenant,approver_ids:ids,approver_id:ids[0]||null,approver_any_admin:any,updated_by:me.id,updated_at:new Date().toISOString()}).select('tenant_id');
if(error){out.innerHTML=`<div class="blk">${E(error.message)}</div>`;return}
if(!sv?.length){out.innerHTML='<div class="blk">Nothing was saved — reload and try again.</div>';return}
APPR={...(APPR||{}),tenant_id:me.tenant,approver_ids:ids,approver_id:ids[0]||null,approver_any_admin:any};
out.innerHTML='';
toast((ids.length||any)?'Approval routing saved':'Approvals off — ignore and block apply immediately')};
if(_apbox)_apbox.querySelectorAll('.ap_ck').forEach(_ck=>_ck.onchange=_apsave);
if(_apany)_apany.onchange=_apsave;}
m.querySelectorAll('input[name="smode"]').forEach(r=>r.onchange=async()=>{if(!r.checked)return;const v=r.value,o=m.querySelector('#os_msg');const{error:_e}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,send_mode:v,open_send:v==='open',updated_by:me.id,updated_at:new Date().toISOString()});if(_e){if(o)o.innerHTML=`<div class="blk">${E(_e.message)}</div>`;return}SMODE=v;OPENSEND=(v==='open');m.querySelectorAll('input[name="smode"]').forEach(x=>{x.closest('label').style.borderColor=x.value===v?'var(--c-accent)':'var(--c-border)'});toast(v==='open'?'Sending opened — any recipient allowed':v==='known'?'Members can now email any known correspondent + client mail IDs':'Approved-recipient list is now enforced')});
const _dss=m.querySelector('#ds_scope');if(_dss)_dss.onchange=async()=>{const v=_dss.value,o=m.querySelector('#ds_msg');const{error:_e}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,drafts_scope:v,updated_by:me.id,updated_at:new Date().toISOString()});if(_e){if(o)o.innerHTML=`<div class="blk">${E(_e.message)}</div>`;return}DRAFTSCOPE=v;toast(v==='mailbox'?'Drafts are now shared per mailbox':'Drafts are now personal to each account')};
const _rst=m.querySelector('#rst_en');if(_rst)_rst.onchange=async()=>{const on=_rst.checked,o=m.querySelector('#rst_msg');const{error:_e}=await hd.rpc('set_restrict_enabled',{p_on:on});if(_e){if(o)o.innerHTML=`<div class="blk">${E(_e.message)}</div>`;_rst.checked=!on;return}RESTRICTON=on;const lbl=m.querySelector('#rst_lbl');if(lbl)lbl.textContent='Restrictions are '+(on?'ON':'OFF');toast(on?'Only-show-to restrictions are back on':'Only-show-to restrictions turned off — restricted mail is back in the shared Inbox')};
m.querySelectorAll('.arx').forEach(b=>b.onclick=async()=>{const{error}=await hd.from('allowed_recipients').delete().eq('id',b.dataset.id);error?toast(error.message,true):(toast('Removed from the approved list'),go(true))});
const _ara=m.querySelector('#ar_add');if(_ara)_ara.onclick=async()=>{const v=(m.querySelector('#ar_e').value||'').trim().toLowerCase(),nt=(m.querySelector('#ar_n').value||'').trim(),o=m.querySelector('#ar_msg');
if(!v){o.innerHTML='<div class="blk">Enter an email address or a domain.</div>';return}
const row={tenant_id:me.tenant,added_by:me.id,kind:'approved',note:nt||null};
if(v.includes('@')){if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)){o.innerHTML='<div class="blk">That email does not look valid.</div>';return}row.email=v}
else if(/^[a-z0-9.-]+\.[a-z]{2,}$/.test(v)){row.domain=v}
else{o.innerHTML='<div class="blk">Enter a full email address or a domain like example.com.</div>';return}
const{error}=await hd.from('allowed_recipients').insert(row);
error?o.innerHTML=`<div class="blk">${E(error.message)}</div>`:(toast('Added — team members can email it directly now'),go(true))};
m.querySelectorAll('.famode').forEach(s=>s.onchange=async()=>{
const{error}=await hd.from('feature_access').upsert({tenant_id:me.tenant,feature:s.dataset.f,everyone:s.value==='everyone'});
error?toast(error.message,true):(toast('Feature access updated — applies at next page load for each member'),go(true))});
m.querySelectorAll('.fgx').forEach(b=>b.onclick=async()=>{
const{error}=await hd.from('feature_grants').delete().eq('id',b.dataset.id);
error?toast(error.message,true):(toast('Grant removed'),go(true))});
m.querySelectorAll('.fgadd').forEach(s=>s.onchange=async()=>{
if(!s.value)return;
const{error}=await hd.from('feature_grants').insert({tenant_id:me.tenant,feature:s.dataset.f,user_id:s.value,added_by:me.id});
error?toast(/duplicate|unique/i.test(error.message)?'Already granted.':error.message,true):(toast('Granted'),go(true))});
const AD=async(action,payload)=>{const{data:{session}}=await pb.auth.getSession();
const r=await fetch(ADMIN,{method:'POST',headers:{authorization:'Bearer '+session.access_token,'content-type':'application/json'},
body:JSON.stringify({action,...payload})});
const j=await r.json();if(!r.ok)throw new Error(j.error||'HTTP '+r.status);return j};
const tmL=m.querySelector('#tm_list');
const loadTeam=async()=>{try{
const j=await AD('list_users',{});
let SESS={},SLOGIN={};try{const{data:_sc}=await hd.rpc('active_session_counts');(_sc||[]).forEach(r=>{SESS[r.user_id]=r.sessions;SLOGIN[r.user_id]=r.last_login})}catch(e){}
j.users.sort((a,b)=>{let av,bv;if(TMSORT.k==='last'){av=SLOGIN[a.id]?+new Date(SLOGIN[a.id]):0;bv=SLOGIN[b.id]?+new Date(SLOGIN[b.id]):0}else{av=(a.name||a.username||'').toLowerCase();bv=(b.name||b.username||'').toLowerCase()}return av<bv?-TMSORT.d:av>bv?TMSORT.d:0});
const iname=id=>INB.find(i=>i.id===id)?.email_address?.split('@')[0]??'?';
tmL.innerHTML=`<table><tr><th class="tmsort" data-k="name" style="cursor:pointer;user-select:none">Name ${TMSORT.k==='name'?(TMSORT.d>0?'▲':'▼'):'⇅'}</th><th>Username</th><th>Role</th><th class="tmsort" data-k="last" style="cursor:pointer;user-select:none" title="Last sign-in to the mail portal (not the intranet)">Last sign-in ${TMSORT.k==='last'?(TMSORT.d>0?'▲':'▼'):'⇅'}</th><th title="Active sign-in sessions right now — separate devices or browsers currently logged in">Sessions</th><th>Password</th><th>Mailbox access</th><th></th></tr>`+
j.users.map(u=>{const mine=ACC.filter(a=>a.user_id===u.id);
return `<tr><td>${E(u.name||'—')}</td>
<td class="mu">${u.username?'@'+E(u.username):'<span class="pill w">not chosen yet</span>'}</td>
<td>${u.id===me.id?`<span class="pill i">${E(u.role)} (you)</span>`:`<select class="tmrole" data-id="${u.id}" style="font-size:12px;padding:4px 6px"><option value="member" ${u.role!=='admin'?'selected':''}>member</option><option value="admin" ${u.role==='admin'?'selected':''}>admin</option></select>`}</td>
<td class="mu" title="Last sign-in to the mail portal">${SLOGIN[u.id]?A(SLOGIN[u.id]):'—'}</td>
<td title="Active sign-in sessions right now">${SESS[u.id]?`<span class="pill i">${SESS[u.id]}</span>`:'<span class="mu">0</span>'}</td>
<td>${u.must_change?'<span class="pill w" title="Still on the shared temporary password — they set their own at first sign-in">must set</span>':'<span class="pill d">set</span>'}</td>
<td style="max-width:220px">${u.role==='admin'?'<span class="pill i">all (admin)</span>'
:(mine.map(a=>`<span class="chip" style="margin:2px">${E(iname(a.inbox_id))} <b class="tmaccx" data-id="${a.id}" style="cursor:pointer">✕</b></span>`).join('')||'<span class="pill d">All mailboxes</span>')}
${u.role!=='admin'?`<div style="margin-top:4px"><select class="tmacc" data-u="${u.id}" style="max-width:150px;font-size:12px;padding:4px 6px"><option value="">Allow only…</option>${INB.map(i=>`<option value="${i.id}">${E(i.email_address)}</option>`).join('')}</select></div>`:''}</td>
<td class="actcell" style="white-space:nowrap;vertical-align:middle;text-align:right"><button class="gh tmrst" data-id="${u.id}" data-em="${E(u.username?'@'+u.username:u.name)}" title="Set a temporary password — a new one must be chosen at next sign-in">Reset password</button><button class="gh tmrsa" data-id="${u.id}" data-n="${E(u.name||'')}" data-un="${E(u.username||'')}" title="Wipe to a clean slate">Reset account</button>
<button class="gh tmed" data-id="${u.id}" data-n="${E(u.name||'')}" data-un="${E(u.username||'')}" title="Edit name & username">✎</button>
${u.id!==me.id?`<button class="gh tmrm" data-id="${u.id}" data-em="${E(u.name||('@'+u.username))}" title="Remove from the workspace">✕</button>`:''}</td></tr>`}).join('')+`</table>`;
const reACC=async()=>{const{data:a2}=await hd.from('inbox_access').select('*');ACC=a2??[]};
tmL.querySelectorAll('.tmaccx').forEach(b=>b.onclick=async()=>{
const{error}=await hd.from('inbox_access').delete().eq('id',b.dataset.id);
if(error)toast(error.message,true);else{await reACC();toast('Access updated');loadTeam()}});
tmL.querySelectorAll('.tmacc').forEach(s=>s.onchange=async()=>{
if(!s.value)return;
const{error}=await hd.from('inbox_access').insert({inbox_id:s.value,user_id:s.dataset.u,added_by:me.id});
if(error)toast(/duplicate|unique/i.test(error.message)?'Already on their list.':error.message,true);
else{await reACC();toast('They now see and send from only their listed mailboxes');loadTeam()}});
tmL.querySelectorAll('.tmrst').forEach(b=>b.onclick=async()=>{
const np=(TSET&&TSET.__temp_pw)||'';
if(!np){toast('No temporary password is set yet \u2014 set one under Settings \u2192 Default temporary password first.',true);return}
if(!await conf('Reset the password for '+b.dataset.em+'?\n\nThey will sign in with the temporary password ('+np+') and must set their own at next sign-in. Their current password stops working immediately.',{okText:'Reset',danger:true}))return;
b.disabled=1;b.textContent='Resetting…';
try{await AD('reset_password',{user_id:b.dataset.id,password:np});
toast(b.dataset.em+' reset to the temporary password');await offerSessionSignout(b.dataset.id,false,b.dataset.n||b.dataset.em);loadTeam()}catch(e){toast(e.message,true)}
b.disabled=0;b.textContent='Reset password'});
tmL.querySelectorAll('.tmrsa').forEach(b=>b.onclick=async()=>{
const nm=b.dataset.n||b.dataset.un||'this member';
if(!await conf('Reset '+nm+' to a CLEAN SLATE?\n\nTheir password is reset (temporary, must change), ALL mailbox access is removed, and the username is cleared. You’ll then choose what happens to the tickets assigned to them.'))return;
const typed=await ask('This is irreversible. Type the full name ('+(b.dataset.n||'')+') to confirm:');
if(typed===null)return;
if((typed||'').trim().toLowerCase()!==(b.dataset.n||'').trim().toLowerCase()){toast('Name did not match — cancelled',true);return}
let _un=await ask('Choose a username for '+nm+' to sign in with (3–20 chars: lowercase letters, numbers, dots):',(b.dataset.n||'').toLowerCase().split(' ')[0].replace(/[^a-z0-9._]/g,''));
if(_un===null)return;_un=(_un||'').trim().toLowerCase();
if(!/^[a-z0-9._]{3,20}$/.test(_un)){toast('Invalid username — 3–20 lowercase letters, numbers, dots',true);return}
const{count:_tc0}=await hd.from('tickets').select('id',{count:'exact',head:true}).eq('assignee_id',b.dataset.id).is('deleted_at',null).in('status',['open','pending']);
const _tc=_tc0||0;
const _ch=await chooseTicketAction(nm,_tc,ppl.filter(p=>p.id!==b.dataset.id));
if(!_ch){toast('Reset cancelled',true);return}
if(_tc>0&&_ch.action==='delete'&&!await conf('Delete the '+_tc+' active ticket'+(_tc===1?'':'s')+' assigned to '+nm+'?\n\nThis cannot be undone.',{okText:'Delete',danger:true}))return;
const _ta=_ch;
const _mba=await chooseMailboxAccess(nm,(INB||[]).filter(x=>x.is_active!==false).map(x=>({id:x.id,email_address:x.email_address,label:x.label||''})),(ACC||[]).filter(x=>x.user_id===b.dataset.id).map(x=>x.inbox_id));
if(!_mba){toast('Reset cancelled',true);return}
const np=(TSET&&TSET.__temp_pw)||'';
if(!np){toast('No temporary password is set yet \u2014 set one under Settings \u2192 Default temporary password first.',true);return}
b.disabled=1;b.textContent='Resetting…';
try{await AD('reset_password',{user_id:b.dataset.id,password:np});
await hd.rpc('reset_member_data',{p_user:b.dataset.id,p_action:_ta.action,p_reassign_to:_ta.target});
const{error:_ue}=await hd.rpc('admin_set_username',{p_user:b.dataset.id,p_username:_un});if(_ue)throw new Error(_ue.message);
if(_mba.mode==='pick'&&_mba.ids.length){const{error:_ae}=await hd.from('inbox_access').insert(_mba.ids.map(_i=>({inbox_id:_i,user_id:b.dataset.id,added_by:me.id})));
if(_ae)toast('Account reset, but mailbox access could not be set: '+_ae.message,true);else{try{const{data:_a3}=await hd.from('inbox_access').select('*');ACC=_a3??[]}catch(_x){}}}
const _asum={reassign:_tc+' ticket'+(_tc===1?'':'s')+' reassigned',inbox:_tc+' ticket'+(_tc===1?'':'s')+' sent back to Inbox',delete:_tc+' ticket'+(_tc===1?'':'s')+' deleted'}[_ta.action];
toast('Account reset — '+nm+' signs in as @'+_un+', must change password'+(_asum?'; '+_asum:''));await offerSessionSignout(b.dataset.id,false,nm);loadTeam()}catch(e){toast(e.message,true);b.disabled=0;b.textContent='Reset account'}});
tmL.querySelectorAll('.tmsort').forEach(h=>h.onclick=()=>{const k=h.dataset.k;if(TMSORT.k===k)TMSORT.d=-TMSORT.d;else{TMSORT.k=k;TMSORT.d=k==='last'?-1:1}loadTeam()});
tmL.querySelectorAll('.tmrole').forEach(s=>s.onchange=async()=>{
try{await AD('update_user',{user_id:s.dataset.id,role:s.value});toast('Role updated')}
catch(e){toast(e.message,true);loadTeam()}});
tmL.querySelectorAll('.tmed').forEach(b=>b.onclick=async()=>{
const cn=b.dataset.n||'',cu=b.dataset.un||'';
const nn=await ask('Full name:',cn);if(nn===null)return;
let uv=await ask('Username to sign in with (3–20: lowercase letters, numbers, dots):',cu);if(uv===null)return;uv=(uv||'').trim().toLowerCase();
const unChanged=!!uv&&uv!==cu;
if(unChanged&&!/^[a-z0-9._]{3,20}$/.test(uv)){toast('Invalid username — 3–20 lowercase letters, numbers, dots',true);return}
try{
if(unChanged){const{data:ok}=await hd.rpc('username_available',{p_username:uv});if(ok===false){toast('That username is already taken — try another',true);return}}
const done=[];
if(nn.trim()!==cn){await AD('update_user',{user_id:b.dataset.id,full_name:nn.trim()});done.push('name')}
if(unChanged){const{error:ue}=await hd.rpc('admin_set_username',{p_user:b.dataset.id,p_username:uv});if(ue)throw new Error(ue.message);done.push('username')}
toast(done.length?('Updated '+done.join(' & ')+(done.indexOf('username')>-1?' — signs in as @'+uv:'')):'No changes');loadTeam()}
catch(e){toast(e.message,true)}});
tmL.querySelectorAll('.tmrm').forEach(b=>b.onclick=async()=>{
if(!await conf(`Remove ${b.dataset.em} from the workspace?\n\nTheir sign-in is disabled and their username is freed. Tickets and history they touched stay intact.`))return;
try{await AD('remove_user',{user_id:b.dataset.id});toast('Member removed');loadTeam()}
catch(e){toast(e.message,true)}});
}catch(e){tmL.innerHTML=`<div class="blk">${E(e.message)}</div>`}};
if(tmL)loadTeam();
const tmg=m.querySelector('#tm_g');if(tmg)tmg.onclick=()=>{
m.querySelector('#tm_p').value='Ska-'+Math.random().toString(36).slice(2,10)+Math.floor(Math.random()*90+10)};
const tma=m.querySelector('#tm_add');if(tma)tma.onclick=async()=>{
const v=id=>m.querySelector('#'+id).value.trim(),out=m.querySelector('#tm_msg');
tma.disabled=1;
try{const j=await AD('create_user',{username:v('tm_u').toLowerCase(),email:v('tm_e').toLowerCase()||undefined,
password:m.querySelector('#tm_p').value,full_name:v('tm_n'),role:m.querySelector('#tm_r').value});
out.innerHTML=`<div class="note">Added. Share these once, privately: username <b>@${E(j.username)}</b> / password <b>${E(m.querySelector('#tm_p').value)}</b> — a new password of their own is forced at first sign-in.</div>`;
toast('Member added');loadTeam()}catch(e){out.innerHTML=`<div class="blk">${E(e.message)}</div>`}
tma.disabled=0}}

// ---------- drafts ----------
async function draftsView(){
let _dq=hd.from('outbound_messages').select('*').in('status',['draft','failed','blocked']);
if(DRAFTSCOPE==='mailbox'){const _vis=me.crm?INB.map(i=>i.id):[...MYVIS];_dq=_vis.length?_dq.in('from_inbox_id',_vis):_dq.eq('created_by',me.id)}else{_dq=_dq.eq('created_by',me.id)}
const{data,error}=await _dq.order('created_at',{ascending:false}).limit(100);
if(error)return `<div class="e">${E(error.message)}</div>`;
if(!data.length)return '<div class="e">No drafts. New mail → Save draft puts one here; anything that fails or is blocked also lands here to fix and resend.</div>';
DRAFTS=data;dsel=new Set([...dsel].filter(id=>data.some(d=>d.id===id)));
return `<div class="note">Your drafts, plus anything that <b>failed</b> or was <b>blocked</b> — open to edit and resend. Mail you have <b>queued</b> to send now lives under <b>Sent → By me</b>. Tick the boxes to send or delete several at once.</div><div id="dbulk"></div>`+
data.map(d=>`<div class="card dft" data-id="${d.id}" style="cursor:pointer">
<div class="rw" style="justify-content:space-between"><div class="rw" style="gap:8px;align-items:center;min-width:0"><input type="checkbox" class="dck" data-id="${d.id}" ${dsel.has(d.id)?'checked':''}><b>${E(d.subject||'(no subject)')}</b></div>
<span>${d.status==='draft'?'<span class="pill">draft</span>':d.status==='failed'?'<span class="pill o">⚠ failed</span>':'<span class="pill o">🚫 blocked</span>'} <span class="mu">${A(d.created_at)}</span></span></div>
<div class="mu">To: ${E((d.to_emails||[]).join(', ')||'—')}${d.cc_emails?.length?' · Cc: '+E(d.cc_emails.join(', ')):''}</div>
${d.error?`<div class="mu" style="color:var(--c-over-tx)">Reason: ${E(d.error)}</div>`:''}
${d.blocked_reason?`<div class="mu" style="color:var(--c-over-tx)">Reason: ${E(d.blocked_reason)}</div>`:''}
</div>`).join('')}
function wireDrafts(m){DBULK(m);
m.querySelectorAll('.dck').forEach(c=>{c.onclick=e=>e.stopPropagation();c.onchange=()=>{c.checked?dsel.add(c.dataset.id):dsel.delete(c.dataset.id);DBULK(m)}});
m.querySelectorAll('.dft').forEach(c=>c.onclick=async()=>{
const{data}=await hd.from('outbound_messages').select('*').eq('id',c.dataset.id).maybeSingle();
if(data){CM=data;go()}})}
function DBULK(m){const b=m.querySelector('#dbulk');if(!b)return;const n=dsel.size;
b.innerHTML=n?`<div class="rw" style="gap:8px;align-items:center;padding:6px 0 10px;flex-wrap:wrap"><b>${n} selected</b><button class="pri" id="db_send">Queue ${n} to send</button><button class="gh" id="db_del">🗑 Delete ${n}</button><button class="gh" id="db_clr">Clear</button></div>`:'';
if(!n)return;
b.querySelector('#db_clr').onclick=()=>{dsel.clear();m.querySelectorAll('.dck').forEach(c=>c.checked=false);DBULK(m)};
b.querySelector('#db_del').onclick=async()=>{const ids=[...dsel];
if(!await conf(`Delete ${ids.length} item${ids.length===1?'':'s'} from your outbox? This cannot be undone.`,{okText:'Delete',danger:true}))return;
const{data:_dl,error}=await hd.from('outbound_messages').delete().in('id',ids).eq('created_by',me.id).select('id');
if(error){toast(error.message,true);return}const _dn=(_dl||[]).length;dsel.clear();toast(_dn===ids.length?`${_dn} deleted`:`${_dn} of ${ids.length} deleted \u2014 the rest belong to someone else`,_dn<ids.length);go(true)};
b.querySelector('#db_send').onclick=async()=>{const rows=DRAFTS.filter(d=>dsel.has(d.id));
const ok=rows.filter(d=>(d.to_emails&&d.to_emails.length)&&(d.body_text||d.body_html)),skip=rows.length-ok.length;
if(!ok.length){toast('None can be sent — each needs a recipient and a body. Open them to finish first.',true);return}
if(!await conf(`Queue ${ok.length} mail${ok.length===1?'':'s'} to send on the next run?${skip?` ${skip} incomplete item${skip===1?'':'s'} will be left as-is.`:''}`,{okText:'Queue to send'}))return;
const{data:_ql,error}=await hd.from('outbound_messages').update({status:'queued'}).in('id',ok.map(d=>d.id)).eq('created_by',me.id).select('id');
const _qn=(_ql||[]).length;
if(error){toast(error.message,true);return}dsel.clear();toast(_qn===ok.length?`${_qn} queued — goes out next run${skip?`; ${skip} left as-is`:''}`:`${_qn} of ${ok.length} queued — the rest belong to someone else`,_qn<ok.length);go(true)}}

// ---------- compose ----------
let _cmBusy=0;
function _cmLock(m,on){['#cm_send','#cm_sendnow','#cm_save'].forEach(sel=>{const b=m.querySelector(sel);if(b)b.disabled=!!on});}
function composeView(){const d=CM??{};
const initial=d.body_html??('<p><br></p>'+sigTail());
return `<div class="card" style="max-width:860px">
${d.status==='queued'?`<div class="note" style="margin-top:0">⏳ This mail is <b>already queued</b> — it hasn't left yet; it goes out on the next mail run (next run ~${nrun()}). Editing here keeps it queued. Use <b>Save draft</b> to pull it back, or <b>⚡ Send now</b> to push it out within about a minute.</div>`:''}
<div class="rw"><span class="mu" style="width:56px">From</span>
<select id="cm_from">${INB.filter(i=>i.is_active&&(MYVIS.size?MYVIS.has(i.id):true)).map(i=>`<option value="${i.id}" ${d.from_inbox_id===i.id?'selected':''}>${E(i.email_address)}</option>`).join('')}</select>
${d.ticket_id?'<span class="pill i">reply draft — stays on its ticket</span>':'<span class="pill">standalone mail — no prior thread needed</span>'}</div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:56px">To</span>
<input id="cm_to" list="cedl" style="flex:1" value="${E((d.to_emails||[]).join(', '))}" placeholder="Start typing — suggestions from your collected contacts"></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:56px">Cc</span>
<input id="cm_cc" list="cedl" style="flex:1" value="${E((d.cc_emails||[]).join(', '))}"></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:56px">Bcc</span>
<input id="cm_bc" list="cedl" style="flex:1" value="${E((d.bcc_emails||[]).join(', '))}"></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:56px">Subject</span>
<input id="cm_sj" style="flex:1" value="${E(d.subject||'')}"></div>
<label class="mu" style="display:flex;gap:6px;align-items:center;margin-top:8px"><input type="checkbox" id="cm_rr" ${d.request_receipt?'checked':''}> Request read receipt (recipient's mail client decides whether to send one)</label>
<div style="margin-top:12px">${rteHtml('cm_ed',initial)}</div>
<div class="rw" style="margin-top:10px"><button class="gh" id="cm_af">📎 Attach files</button>
<input id="cm_att" type="file" multiple hidden><span id="cm_fl" class="rw"></span></div>
<div class="mu" style="margin-top:8px">Goes out on the next mail run — next run about <b>${nrun()}</b> (roughly every ${TSET?.sync_interval_minutes??10} min). ${SMODE==='open'?'Sending is open — any recipient is allowed.':SMODE==='known'?'Anyone you’ve corresponded with or a client mail ID goes straight out; other addresses need approval.':'Every recipient — To, Cc, Bcc — is checked against the approved list.'} For normal mail use <b>Send on next run</b>; for urgent mail that can’t wait, <b>⚡ Send now</b> pushes it out within about a minute.</div>
<div id="cm_msg"></div>
<div class="rw" style="margin-top:12px">
<button class="pri" id="cm_send">Send on next run</button>
<button class="gh" id="cm_sendnow" title="Urgent only — sends within about a minute">⚡ Send now</button>
<button id="cm_save">Save draft</button>
${d.id?'<button class="gh" id="cm_back">← Back to drafts</button><button class="gh" id="cm_del">Delete draft</button>':''}
<button class="gh" id="cm_x">Discard</button></div></div>`}
function ensureCEDatalist(){let dl=document.getElementById('cedl');
if(!dl){dl=document.createElement('datalist');dl.id='cedl';document.body.appendChild(dl)}
dl.innerHTML=CEMAILS.slice(0,1500).map(e=>`<option value="${E(e)}">`).join('')}
function wireCompose(m){wireRte(m);ensureCEDatalist();makeSearchable(m);
const fl=m.querySelector('#cm_fl'),att=m.querySelector('#cm_att');
const renderFl=()=>{fl.innerHTML=CMEX.map(a=>`<span class="chip cmex" data-p="${E(a.storage_path||'')}" data-fn="${E(a.filename||'file')}" data-aid="${E(a.id)}" title="Already attached \u2014 click to open, \u2715 to remove">\ud83d\udcce ${E(a.filename||'file')} <span class="mu">${KB(a.size_bytes)}</span> <b class="cmexx" style="cursor:pointer">\u2715</b></span>`).join('')+FILES.map((f,i)=>`<span class="chip" data-x="${i}" title="Click to remove">\ud83d\udcce ${E(f.name)} <span class="mu">${KB(f.size)}</span> \u2715</span>`).join('');
fl.querySelectorAll('.chip[data-x]').forEach(c=>c.onclick=()=>{FILES.splice(+c.dataset.x,1);renderFl()});
fl.querySelectorAll('.cmex').forEach(c=>c.onclick=async e=>{
if(e.target&&e.target.classList.contains('cmexx')){e.stopPropagation();
const{error}=await hd.from('outbound_attachments').delete().eq('id',c.dataset.aid);
if(error){toast(error.message,true);return}
CMEX=CMEX.filter(a=>a.id!==c.dataset.aid);renderFl();toast('Attachment removed')}
else _openStored(c.dataset.p,c.dataset.fn)})};
FILES=[];CMEX=[];renderFl();
if(CM&&CM.id){hd.from('outbound_attachments').select('id,filename,size_bytes,storage_path').eq('outbound_id',CM.id).then(({data})=>{CMEX=data||[];if(CMEX.length)renderFl()})}
m.querySelector('#cm_af').onclick=()=>att.click();
att.onchange=()=>{for(const f of att.files){
if(f.size>15*1048576){toast(f.name+' is over 15 MB — send a link instead',true);continue}
if(FILES.length>=5){toast('Five files max',true);break}
FILES.push(f)}att.value='';renderFl()};
m.querySelector('#cm_x').onclick=()=>{CM=null;go()};
const bk=m.querySelector('#cm_back');if(bk)bk.onclick=()=>{CM=null;tab='drafts';go()};
const del=m.querySelector('#cm_del');if(del)del.onclick=async()=>{
const{error}=await hd.from('outbound_messages').delete().eq('id',CM.id);
error?toast(error.message,true):(toast('Draft deleted'),CM=null,go(true))};
const gather=()=>{const v=id=>m.querySelector('#'+id).value;
const list=s=>s.split(/[,;]/).map(x=>x.trim()).filter(Boolean);
const{html,text}=edOut(m,'cm_ed');
const inb=INB.find(i=>i.id===v('cm_from'));
return{from_inbox_id:v('cm_from'),tenant_id:inb?.tenant_id??me.tenant,
to_emails:list(v('cm_to')),cc_emails:list(v('cm_cc')),bcc_emails:list(v('cm_bc')),
request_receipt:!!m.querySelector('#cm_rr')?.checked,
subject:v('cm_sj').trim()||'(no subject)',body_html:html,body_text:text,created_by:me.id}};
const persist=async(status)=>{const out=m.querySelector('#cm_msg');
const row={...gather(),status};
if(status==='queued'&&(!row.to_emails.length||!row.body_text)){
out.innerHTML='<div class="blk">Add a recipient and a message.</div>';return null}
try{
const ups=[];
for(const f of FILES){
const path=`outbound/${crypto.randomUUID()}/${f.name.replace(/[^\w.\- ]+/g,'_').slice(0,140)}`;
const{error:ue}=await pb.storage.from('helpdesk-attachments').upload(path,f,{contentType:f.type||'application/octet-stream'});
if(ue)throw new Error('Upload failed for '+f.name+': '+ue.message);
ups.push({path,f});UPQ.push(path)}
let data,error;
if(CM?.id)({data,error}=await hd.from('outbound_messages').update(row).eq('id',CM.id).select().single());
else({data,error}=await hd.from('outbound_messages').insert(row).select().single());
if(error)throw new Error(error.message);
if(data&&data.id)CM=Object.assign({},CM||{},data);
if(ups.length){const rows=ups.map(u=>({tenant_id:row.tenant_id,outbound_id:data.id,filename:u.f.name,
mime_type:u.f.type||null,size_bytes:u.f.size,storage_path:u.path,created_by:me.id}));
const{error:ae}=await hd.from('outbound_attachments').insert(rows);
if(ae)throw new Error('Saved, but attachments failed to register: '+ae.message)}
UPQ=[];
if(data.status==='blocked'){out.innerHTML=`<div class="blk"><b>Not sent.</b> ${E(data.blocked_reason)}<div style="margin-top:8px"><button class="pri" id="cm_reqap">Request approval to send</button></div></div>`;CM=data;const _rq=out.querySelector('#cm_reqap');if(_rq)_rq.onclick=async()=>{_rq.disabled=1;_rq.textContent='Requesting…';const{error:_e}=await hd.rpc('request_send_approval',{p_outbound:data.id});if(_e){_rq.disabled=0;_rq.textContent='Request approval to send';toast(_e.message,true)}else{toast('Sent for approval — it goes out once an admin approves');CM=null;FILES=[];go()}};return null}
return data}catch(e){upClean();out.innerHTML=`<div class="blk">${E(e.message)}</div>`;return null}};
m.querySelector('#cm_save').onclick=async()=>{if(_cmBusy)return;_cmBusy=1;_cmLock(m,true);
const d=await persist('draft');
_cmBusy=0;_cmLock(m,false);
if(d){toast('Draft saved');CM=d;go()}};
bindCE(m,'mail','#cm_send');
m.querySelector('#cm_send').onclick=async()=>{const b=m.querySelector('#cm_send');
if(_cmBusy)return;_cmBusy=1;_cmLock(m,true);
b.disabled=1;b.textContent='Sending…';
const d=await persist('queued');
_cmBusy=0;_cmLock(m,false);
b.disabled=0;b.textContent='Send on next run';
if(d){toast('Queued — goes out on the next mail run (~'+nrun()+'). Need it sooner? Use ⚡ Send now.');CM=null;FILES=[];go()}};
const _sn=m.querySelector('#cm_sendnow');if(_sn)_sn.onclick=async()=>{
if(_cmBusy)return;
if(!await conf(SEND_NOW_WARN,{okText:'Send now'}))return;
if(_cmBusy)return;_cmBusy=1;_cmLock(m,true);
const _s=m.querySelector('#cm_send');_sn.disabled=1;_sn.textContent='Sending…';if(_s)_s.disabled=1;
const d=await persist('queued');
_cmBusy=0;_cmLock(m,false);
if(!d){_sn.disabled=0;_sn.textContent='⚡ Send now';if(_s)_s.disabled=0;return}
await markPriority(d.id);
CM=null;FILES=[];toast('Sending now — usually under a minute.');go();
sendNowKick(d.id,true)}}

// ---------- activity ----------
const NV=v=>v==null?'—':(typeof v==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-/.test(v))?uName(v):String(v);
const EVTXT={created:'Ticket created',classified:'Message tagged',tagged:'Tagged',assigned:'Assigned',unassigned:'Unassigned',
claimed:'Claimed from pool',pooled:'Sent to pool',seen:'First opened',status_changed:'Status changed',
priority_changed:'Priority changed',deadline_set:'Deadline updated',reply_received:'Reply received',
reassigned:'Reassigned',deleted:'Deleted',delete_refused:'Deletion refused',blocked_outbound:'Reply blocked',escalated:'Escalated',sent_back:'Sent back to Inbox'};
async function activityHtml(id){const{data:ev,error}=await hd.from('ticket_events')
.select('*').eq('ticket_id',id).order('created_at',{ascending:true}).limit(100);
const items=ev??[];
const inner=error?`<div class="blk">${E(error.message)}</div>`
:items.length?`<ul class="tl">
${items.map(e=>{const d=e.detail||{};
let extra=[d.class,d.status,d.role==='assignee'?'by the assignee':d.role==='viewer'?'by a viewer':null,
d.assignee?('→ '+uName(d.assignee)):null,(d.from!==undefined||d.to!==undefined)?(NV(d.from)+' → '+NV(d.to)):null,d.reason].filter(Boolean).join(' · ');
return `<li><b>${E(EVTXT[e.event]??e.event.replace(/_/g,' '))}</b>${extra?` — ${E(extra)}`:''}
<span class="mu">${E(uName(e.actor_id))} · ${E(FDT(e.created_at))}</span></li>`}).join('')}
</ul>`
:'<div class="mu" style="margin-top:8px">Nothing recorded yet — entries appear as the ticket is tagged, assigned, first opened, prioritised, completed or replied to.</div>';
return `<details class="act" open><summary>📋 Activity log${items.length?` (${items.length})`:''}</summary>${inner}</details>`}

// ---------- global activity feed (unified, portal-wide) ----------
let TKM={};
const EVTXT2={contact_tag_added:'Tag added to contact',contact_tag_removed:'Tag removed from contact',
tag_created:'Tag created',tag_updated:'Tag updated',tag_deleted:'Tag deleted',
sender_blocked:'Sender blocked',sender_unblocked:'Sender unblocked',
mailbox_added:'Mailbox added',mailbox_activated:'Mailbox turned on',mailbox_deactivated:'Mailbox turned off',
mailbox_deleted:'Mailbox deleted',mailbox_access_granted:'Mailbox access granted',mailbox_access_revoked:'Mailbox access revoked',
feature_mode_changed:'Feature access changed',feature_granted:'Feature access granted',feature_revoked:'Feature access removed',
retention_changed:'Retention changed',username_claimed:'Username claimed',username_changed:'Username changed',password_changed:'Password changed',signature_updated:'Signature updated',client_colour_changed:'Client pill colour changed',send_mode_changed:'Sending policy changed',guide_updated:'Welcome guide updated',signed_in:'Signed in',signed_out:'Signed out',
draft_saved:'Draft saved',mail_queued:'Mail queued to send',mail_send_now:'Sent now (urgent)',mail_sent:'Mail sent',mail_failed:'Mail send failed',mail_blocked:'Mail send blocked',mail_read:'Mail read',
message_ignored:'Mail ignored',message_restored:'Mail restored',mass_ignored:'Mass ignore',account_reset:'Account reset',
approval_requested:'Approval requested',approval_approved:'Request approved',approval_rejected:'Request rejected',approver_changed:'Approver changed',
member_added:'Member added',member_removed:'Member removed',member_role_changed:'Member role changed',member_renamed:'Member renamed',password_reset:'Password reset',sessions_signed_out:'Signed out other devices',changelog_published:'Update published',support_raised:'Help ticket raised',support_resolved:'Help ticket resolved',sender_blocked:'Sender blocked',sender_unblocked:'Sender unblocked',blocked_mail_hidden:'Blocked-sender mail hidden',blocked_mail_restored:'Blocked-sender mail restored',tag_created:'Tag created',tag_updated:'Tag updated',mailbox_activated:'Mailbox activated',mailbox_deactivated:'Mailbox deactivated'};
const ETX=e=>EVTXT[e]??EVTXT2[e]??e.replace(/_/g,' ');
const KINDL={ticket:'Tickets',contact:'Contacts',tag:'Tags',sender:'Blocked senders',mailbox:'Mailboxes',member:'Team',settings:'Settings',feature:'Feature access',mail:'Outgoing mail',message:'Mail',approval:'Approvals',support:'Help tickets'};
function lgExtra(d){if(!d)return'';
if(d.from&&d.to&&typeof d.from==='object'&&typeof d.to==='object')
return Object.keys(d.to).filter(k=>JSON.stringify(d.from[k])!==JSON.stringify(d.to[k])).map(k=>`${k}: ${d.from[k]} → ${d.to[k]} days`).join(' · ');
return [d.class,d.status,d.role==='assignee'?'by the assignee':d.role==='viewer'?'by a viewer':null,
d.assignee?('→ '+uName(d.assignee)):null,(d.from!==undefined||d.to!==undefined)?(NV(d.from)+' → '+NV(d.to)):null,d.changed?d.changed:null,d.colour_to?('→ '+d.colour_to):null,d.reason].filter(Boolean).join(' · ')}
async function logsView(){
try{const{data:_fac}=await hd.rpc('activity_facets');if(_fac&&_fac[0]){LGACTS=_fac[0].actions||[];LGKINDS=_fac[0].kinds||[]}}catch(e){}
let _lq=hd.from('activity_log').select('*',{count:'exact'}).order('created_at',{ascending:false});
if(LG.ev)_lq=_lq.eq('action',LG.ev);
if(LG.kind)_lq=_lq.eq('target_kind',LG.kind);
if(LG.actor==='system')_lq=_lq.is('actor_id',null);else if(LG.actor)_lq=_lq.eq('actor_id',LG.actor);
const{data:ev,error,count:_ctall}=await _lq.limit(800);
if(error)return `<div class="e">${E(error.message)}</div>`;
EVD=ev??[];EVTOTAL=_ctall||0;
if(!EVD.length&&!(LG.ev||LG.kind||LG.actor||(LG.q&&LG.q.trim())))return '<div class="e">No activity recorded yet.</div>';
const tids=[...new Set(EVD.filter(e=>e.target_kind==='ticket'&&e.target_id).map(e=>e.target_id))];
const{data:tk}=tids.length?await hd.from('tickets').select('id,ticket_no,subject,thread_id').in('id',tids):{data:[]};
TKM=Object.fromEntries((tk??[]).map(t=>[t.id,t]));
const acts=(LGACTS.length?LGACTS.slice():[...new Set(EVD.map(e=>e.action))]).sort((a,b)=>ETX(a).localeCompare(ETX(b)));
const kinds=(LGKINDS.length?LGKINDS.slice():[...new Set(EVD.map(e=>e.target_kind).filter(Boolean))]).sort();
return `<div class="note">Everything, portal-wide: every tag put on a contact, every ignore and restore, every assignment,
status change, sent mail, member change, setting change — with <b>who did it and exactly when</b>. Search any word
(a tag name, a mail address, a subject, a person), narrow by action or area, flip the order. Ticket rows open the ticket.
Entries are kept for the window set under Mailboxes → Retention.</div>
<div class="fbar"><input type="search" id="lg_q" placeholder="Search tag, mail ID, subject, person…" value="${E(LG.q)}">
<select id="lg_e"><option value="">Action: any</option>${acts.map(v=>`<option value="${v}" ${LG.ev===v?'selected':''}>${ETX(v)}</option>`).join('')}</select>
<select id="lg_k"><option value="">Area: any</option>${kinds.map(v=>`<option value="${v}" ${LG.kind===v?'selected':''}>${KINDL[v]??v}</option>`).join('')}</select>
<select id="lg_a"><option value="">By: anyone</option><option value="system" ${LG.actor==='system'?'selected':''}>System</option>${ppl.map(p=>`<option value="${p.id}" ${LG.actor===p.id?'selected':''}>${E(p.n)}</option>`).join('')}</select>
<select id="lg_o"><option value="desc" ${LG.order==='desc'?'selected':''}>Newest first</option><option value="asc" ${LG.order==='asc'?'selected':''}>Oldest first</option></select>
<span class="mu" id="lg_ct"></span></div><div id="lg_list"></div><div id="lg_more" style="text-align:center;padding:12px"></div>`}
function renderLogs(m){const q=LG.q.trim().toLowerCase();
let rows=EVD.filter(e=>{
if(LG.ev&&e.action!==LG.ev)return false;
if(LG.kind&&e.target_kind!==LG.kind)return false;
if(LG.actor==='system'&&e.actor_id)return false;
if(LG.actor&&LG.actor!=='system'&&e.actor_id!==LG.actor)return false;
if(q&&!(((e.target_label??'')+' '+e.action+' '+ETX(e.action)+' '+lgExtra(e.detail||{})+' '+uName(e.actor_id)).toLowerCase().includes(q)))return false;
return true});
rows=[...rows].sort((a,b)=>LG.order==='asc'
?(+new Date(a.created_at))-(+new Date(b.created_at))
:(+new Date(b.created_at))-(+new Date(a.created_at)));
const ct=m.querySelector('#lg_ct');if(ct)ct.textContent=`${rows.length} shown · ${EVD.length} of ${EVTOTAL.toLocaleString()} loaded`;
const ll=m.querySelector('#lg_list');if(!ll)return;
let g='';
ll.innerHTML=rows.length?`<div class="card">`+rows.map(e=>{const extra=lgExtra(e.detail||{});
const tk=e.target_kind==='ticket'?TKM[e.target_id]:null;
const dg=dayGrp(e.created_at),hdr=dg!==g?`<div class="dgrp" style="margin:0 -15px;padding-left:15px">${dg}</div>`:'';g=dg;
return hdr+`<div class="lgr" data-i="${tk?e.target_id:''}" data-h="${tk?.thread_id??''}" data-msg="${e.target_kind==='message'&&e.target_id?e.target_id:''}" style="padding:9px 4px;border-bottom:1px solid var(--c-border)${(tk||(e.target_kind==='message'&&e.target_id))?';cursor:pointer':''}">
<b>${E(ETX(e.action))}</b>${e.target_label?` — ${E(e.target_label.slice(0,110))}`:''}${extra?` <span class="mu">(${E(extra)})</span>`:''}
${e.target_kind?`<span class="pill" style="margin-left:6px">${E(KINDL[e.target_kind]??e.target_kind)}</span>`:''}
<div class="mu">by ${E(uName(e.actor_id))} · ${E(FDT(e.created_at))}</div></div>`}).join('')+`</div>`
:'<div class="e">Nothing matches.</div>';
ll.querySelectorAll('.lgr').forEach(r=>r.onclick=async()=>{
if(r.dataset.i){tab='all';F.foc='';open={i:r.dataset.i,h:r.dataset.h||null};go();return}
if(r.dataset.msg)await openMailFromLog(r.dataset.msg)});
const mo=m.querySelector('#lg_more');
if(mo){if(EVD.length<EVTOTAL){const left=EVTOTAL-EVD.length;
mo.innerHTML=`<button class="gh" id="lg_more_b">Load older activity — ${left.toLocaleString()} more</button>`;
mo.querySelector('#lg_more_b').onclick=async()=>{const bt=mo.querySelector('#lg_more_b');bt.disabled=1;bt.textContent='Loading…';
let _mq=hd.from('activity_log').select('*').order('created_at',{ascending:false});
if(LG.ev)_mq=_mq.eq('action',LG.ev);
if(LG.kind)_mq=_mq.eq('target_kind',LG.kind);
if(LG.actor==='system')_mq=_mq.is('actor_id',null);else if(LG.actor)_mq=_mq.eq('actor_id',LG.actor);
const{data:more}=await _mq.range(EVD.length,EVD.length+799);
if(more&&more.length){EVD=EVD.concat(more);
const tids=[...new Set(EVD.filter(e=>e.target_kind==='ticket'&&e.target_id).map(e=>e.target_id))];
const{data:tk}=tids.length?await hd.from('tickets').select('id,ticket_no,subject,thread_id').in('id',tids):{data:[]};
TKM=Object.fromEntries((tk??[]).map(t=>[t.id,t]));}
renderLogs(m)}}else mo.innerHTML=EVTOTAL?'<span class="mu">— that\'s the entire history —</span>':'';}}
function wireLogs(m){renderLogs(m);
const q=m.querySelector('#lg_q');if(q)q.oninput=()=>{LG.q=q.value;renderLogs(m)};
const o=m.querySelector('#lg_o');if(o)o.onchange=()=>{LG.order=o.value;renderLogs(m)};
[['lg_e','ev'],['lg_k','kind'],['lg_a','actor']].forEach(([id,k])=>{
const x=m.querySelector('#'+id);if(x)x.onchange=()=>{LG[k]=x.value;reloadLogs(m)}})}
async function reloadLogs(m){
let _lq=hd.from('activity_log').select('*',{count:'exact'}).order('created_at',{ascending:false});
if(LG.ev)_lq=_lq.eq('action',LG.ev);
if(LG.kind)_lq=_lq.eq('target_kind',LG.kind);
if(LG.actor==='system')_lq=_lq.is('actor_id',null);else if(LG.actor)_lq=_lq.eq('actor_id',LG.actor);
const _ct=m.querySelector('#lg_ct');if(_ct)_ct.textContent='Loading…';
const{data:ev,count}=await _lq.limit(800);
EVD=ev??[];EVTOTAL=count||0;
const tids=[...new Set(EVD.filter(e=>e.target_kind==='ticket'&&e.target_id).map(e=>e.target_id))];
const{data:tk}=tids.length?await hd.from('tickets').select('id,ticket_no,subject,thread_id').in('id',tids):{data:[]};
TKM=Object.fromEntries((tk??[]).map(t=>[t.id,t]));
renderLogs(m)}
// Open a mail from an Activity row — jump to wherever it currently sits (ticket tab, Inbox to-sort, or Archive).
async function openMailFromLog(mid){
const{data:msg,error}=await hd.from('messages').select('id,thread_id,ticket_id,classification,archived,blocked_hidden,subject,direction').eq('id',mid).maybeSingle();
if(error||!msg){toast('That mail is no longer available to open.',true);return}
if(msg.blocked_hidden){toast('That mail is from a blocked sender and is hidden.',true);return}
if(msg.ticket_id){
const{data:tk}=await hd.from('tickets').select('id,thread_id,status').eq('id',msg.ticket_id).maybeSingle();
if(tk){tab=(tk.status==='resolved'||tk.status==='closed')?'resolved':'all';F.foc='';F.q='';open={i:tk.id,h:tk.thread_id||msg.thread_id||null};go();return}}
if(msg.classification==='ignore'){tab='archive';AF='ignored';ASQ=msg.subject||'';open=null;go();return}
if(msg.archived||msg.direction==='outbound'){tab='archive';AF=(msg.direction==='outbound')?'sent':'old';ASQ=msg.subject||'';open=null;go();return}
PENDTRI={th:msg.thread_id,mid:msg.id};F.q='';open=null;tab='triage';go()}

// ---------- sent ----------
async function sentView(){
const canAll=!!(FEAT.all_sent||me.crm);
if(SENTV==='all'&&!canAll)SENTV='mine';
if(SENTV==='mine'){
const{data,error}=await hd.from('outbound_messages')
.select('id,subject,to_emails,cc_emails,body_text,body_html,sent_at,created_at,status,priority,in_reply_to,ticket_id,from_inbox_id,bounce_to,bounce_reason,bounce_kind,delivery_state,delivery_checked_at,outbound_attachments(id,filename,size_bytes,storage_path)')
.eq('created_by',me.id).in('status',['sent','queued','bounced']).order('created_at',{ascending:false}).limit(400);
if(error)return `<div class="e">${E(error.message)}</div>`;
SNTM=data??[];
}else{
const days=SADAYS||90;const cutoff=new Date(Date.now()-days*86400000).toISOString();
const own=INB.filter(i=>MYVIS.size?MYVIS.has(i.id):true).map(i=>i.email_address);
let q=hd.from('messages').select('id,subject,from_email,to_emails,cc_emails,sent_at,snippet,has_attachments,gmail_message_id').eq('direction','outbound').gte('sent_at',cutoff).order('sent_at',{ascending:false}).limit(500);
q=own.length?q.in('from_email',own):q.eq('direction','__none__');
const[a,b,p,rp]=await Promise.all([q,hd.rpc('queued_all'),hd.rpc('portal_sent_ids',{p_days:days}),hd.rpc('sent_reply_ids',{p_days:days})]);
SREP=new Set(((rp&&rp.data)||[]).map(r=>typeof r==='string'?r:(r&&(r.sent_reply_ids??r.id))).filter(Boolean));
SNTA=a.data??[];SNTQ=b.data??[];SPIDS=new Map((p.data||[]).map(x=>{const g=typeof x==='string'?x:(x&&(x.portal_sent_ids??x.gmail_message_id));return g?[g,{by:(x&&x.created_by)||null,bounced:!!(x&&x.bounced),bto:(x&&x.bounce_to)||null,bkind:(x&&x.bounce_kind)||null,oid:(x&&x.outbound_id)||null,dstate:(x&&x.delivery_state)||null}]:null}).filter(Boolean));
}
const sub=[['mine','By me']].concat(canAll?[['all','Everyone']]:[]);
const bar=`<div class="ftabs" style="margin-bottom:0">${sub.map(([k,l])=>`<b class="${SENTV===k?'on':''}" data-sv="${k}">${l}</b>`).join('')}</div>`;
const seg=(k,l)=>`<b data-sk="${k}" style="padding:5px 13px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;user-select:none;border:1px solid ${SKIND===k?'var(--c-accent)':'var(--c-border)'};color:${SKIND===k?'#fff':'var(--c-muted)'};background:${SKIND===k?'var(--c-accent)':'transparent'};transition:all .12s">${l}</b>`;
const kinds=`<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:10px"><span class="mu" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;opacity:.7;margin-right:2px">Show</span>${[['all','All'],['direct','Direct'],['reply','Replies']].map(([k,l])=>seg(k,l)).join('')}</div>`;
const ownList=SENTV==='all'?[...new Set(SNTA.map(x=>x.from_email).filter(Boolean))].sort():[...new Set(SNTM.map(x=>inbxEmail(x.from_inbox_id)).filter(Boolean))].sort();
const byList=SENTV==='all'?[...new Set(sentRows().map(x=>x.by).filter(Boolean))].map(id=>[id,uName(id)]).sort((a,b)=>String(a[1]).localeCompare(String(b[1]))):[];
const fbar=`<div class="fbar"><input type="search" id="sf_q" placeholder="Search subject, recipient…" value="${E(SF.q)}">
${ownList.length>1?`<select id="sf_i"><option value="">Mailbox: any</option>${ownList.map(a=>`<option ${SF.inbox===a?'selected':''}>${E(a)}</option>`).join('')}</select>`:''}
${byList.length?`<select id="sf_by"><option value="">Sent by: anyone</option>${byList.map(([id,nm])=>`<option value="${E(id)}" ${SF.by===id?'selected':''}>${E(nm)}</option>`).join('')}</select>`:''}<select id="sf_dlv"><option value="">Delivery: any</option><option value="bounced" ${SF.dlv==='bounced'?'selected':''}>Not delivered</option><option value="ok" ${SF.dlv==='ok'?'selected':''}>Delivered</option></select>${SENTV==='mine'?'':`<select id="sf_org"><option value="">Sent via: any</option><option value="portal" ${SF.org==='portal'?'selected':''}>Portal only</option><option value="gmail" ${SF.org==='gmail'?'selected':''}>Gmail only</option></select>`}
<select id="sf_att"><option value="">Attachments: any</option><option value="1" ${SF.att==='1'?'selected':''}>With attachments</option><option value="0" ${SF.att==='0'?'selected':''}>Without attachments</option></select>
<select id="sf_sort"><option value="newest" ${SF.sort==='newest'?'selected':''}>Newest first</option><option value="oldest" ${SF.sort==='oldest'?'selected':''}>Oldest first</option></select>
<span class="mu" id="sf_ct"></span></div>`;
const note=SENTV==='mine'?'Mail you sent from the portal — direct mails and replies — plus anything you have queued to go out on the next run.':`Everything sent from your mailboxes in the last ${SADAYS||90} days by anyone — via this portal or straight from Gmail — plus mail the team has queued. Use “Sent via” to see portal-only or Gmail-only.`;
return `<div class="note">${note}</div><div style="margin:8px 0 14px">${bar}${kinds}</div>${fbar}<div id="slist"></div>`}
function sentRows(){
if(SENTV==='mine'){
return SNTM.filter(x=>{const rep=!!(x.in_reply_to||x.ticket_id);
if(SKIND==='reply'&&!rep)return false;if(SKIND==='direct'&&rep)return false;return true})
.map(x=>({t:'out',id:x.id,subject:x.subject,to:x.to_emails,cc:x.cc_emails,when:x.sent_at||x.created_at,status:x.status,priority:x.priority,dstate:x.delivery_state||null,rep:!!(x.in_reply_to||x.ticket_id),from:inbxEmail(x.from_inbox_id),att:!!(x.outbound_attachments&&x.outbound_attachments.length),bto:x.bounce_to||null,dreason:x.bounce_reason||null,bkind:x.bounce_kind||null,origin:'portal'}));}
const q=SNTQ.map(x=>({t:'out',id:x.id,subject:x.subject,to:x.to_emails,cc:x.cc_emails,when:x.created_at,status:'queued',rep:!!(x.in_reply_to||x.ticket_id),from:inbxEmail(x.from_inbox_id),by:x.created_by||null,origin:'portal'}));
const s=SNTA.map(x=>({t:'msg',id:x.id,subject:x.subject,to:x.to_emails,cc:x.cc_emails,when:x.sent_at,status:'sent',from:x.from_email,snippet:x.snippet,att:!!x.has_attachments,by:(x.gmail_message_id?(SPIDS.get(x.gmail_message_id)||{}).by:null)||null,status:(x.gmail_message_id&&(SPIDS.get(x.gmail_message_id)||{}).bounced)?'bounced':'sent',bto:(x.gmail_message_id?(SPIDS.get(x.gmail_message_id)||{}).bto:null)||null,bkind:(x.gmail_message_id?(SPIDS.get(x.gmail_message_id)||{}).bkind:null)||null,oid:(x.gmail_message_id?(SPIDS.get(x.gmail_message_id)||{}).oid:null)||null,dstate:(x.gmail_message_id?(SPIDS.get(x.gmail_message_id)||{}).dstate:null)||null,rep:SREP.has(x.id),origin:(x.gmail_message_id&&SPIDS.has(x.gmail_message_id))?'portal':'gmail'}));
return [...q,...s].filter(x=>SKIND==='all'?true:(SKIND==='reply'?x.rep:!x.rep));}
// One place that decides what a mail's status chip says.
// The old inline ternary fell through to a green tick for ANY status that was
// not queued or bounced, so 'failed', 'blocked' and 'draft' would all have
// claimed the mail was sent. Nothing here falls through to a success claim.
//
// 'sent' has only ever meant Gmail accepted the API call. dstate carries the
// separate check the runner makes against Gmail a couple of minutes later,
// which does not depend on the ingestion pipeline being healthy.
const _sT=t=>E(t);
const _schip=x=>{
const bad='background:#3a1d1d;color:#ff9a9a;border-color:#7a3a3a';
if(x.status==='queued')return x.priority
?`<span class="pill i" title="${_sT('Going out on the next collection cycle \u2014 usually under a minute.')}">\u26a1 sending now</span>`
:`<span class="pill i" title="${_sT('Waiting for the next collection cycle.')}">\u23f3 queued</span>`;
if(x.status==='bounced'||x.dstate==='bounced')return `<span class="pill w" style="${bad}" title="${_sT('Not delivered'+(x.bto?' to '+x.bto:'')+(x.dreason?' \u2014 '+x.dreason:''))}">\u2717 not delivered</span>`;
if(x.status==='failed')return `<span class="pill w" style="${bad}" title="${_sT('The portal could not hand this to Gmail. It has not gone anywhere.')}">\u2717 failed to send</span>`;
if(x.status==='blocked')return `<span class="pill w" style="${bad}" title="${_sT('Held back by an approval or blocking rule. Not sent.')}">\u26d4 blocked</span>`;
if(x.status==='draft')return `<span class="pill" title="${_sT('Still a draft. Not sent.')}">draft</span>`;
if(x.status!=='sent')return `<span class="pill" title="${_sT('The portal has no delivery record for this one.')}">status unknown</span>`;
if(x.origin==='gmail')return `<span class="pill d" title="${_sT('Sent from Gmail directly, not through the portal, so the portal has no delivery record for it.')}">\u2713 sent</span>`;
if(x.dstate==='missing')return `<span class="pill w" style="${bad}" title="${_sT('Gmail accepted this and gave us an id, but the message is not in the mailbox. Worth checking by hand.')}">\u26a0 not found in Gmail</span>`;
if(x.dstate==='in_gmail')return `<span class="pill d" title="${_sT('Sent, and confirmed in the mailbox with no delivery failure reported. Gmail cannot tell us whether it was opened.')}">\u2713 sent</span>`;
return `<span class="pill d" title="${_sT('Handed to Gmail and accepted. The delivery check runs a couple of minutes after sending and has not reported yet.')}">\u2713 sent \u00b7 checking</span>`};
function renderSent(m){const ql=SF.q.trim().toLowerCase();
let rows=sentRows().filter(x=>{
if(SF.inbox&&x.from!==SF.inbox)return false;
if(SF.org&&x.origin!==SF.org)return false;
if(SF.dlv==='bounced'&&x.status!=='bounced')return false;
if(SF.dlv==='ok'&&x.status==='bounced')return false;
if(SENTV==='all'&&SF.by&&x.by!==SF.by)return false;
if(SF.att==='1'&&!x.att)return false;
if(SF.att==='0'&&x.att)return false;
if(ql&&!((x.subject??'')+' '+((x.to||[]).join(' '))+' '+(x.from??'')).toLowerCase().includes(ql))return false;
return true});
rows.sort((a,b)=>SF.sort==='oldest'?(+new Date(a.when))-(+new Date(b.when)):(+new Date(b.when))-(+new Date(a.when)));
const ct=m.querySelector('#sf_ct');if(ct)ct.textContent=`${rows.length} shown`;
const sl=m.querySelector('#slist');if(!sl)return;
sl.innerHTML=rows.length?rows.map(x=>`<div class="card" data-t="${x.t}" data-g="${E(x.id)}">
<div class="rw"><div class="sub" style="flex:1;cursor:pointer">${E(x.subject||'(no subject)')} ${_schip(x)}${SENTV==='mine'?(x.rep?' <span class="pill">reply</span>':' <span class="pill">direct</span>'):''}${SENTV==='all'?(x.origin==='portal'?' <span class="pill o">Portal</span>':' <span class="pill w">Gmail</span>'):''}${x.att?'<span class="pill">📎</span>':''}</div><span class="mu">${A(x.when)}</span></div>
${x.status==='bounced'?`<div style="margin-top:4px;color:#ff9a9a;font-size:12px" title="${E(x.dreason||'')}">\u2717 <b>${E(x.bkind||'Delivery failed')}</b>${x.bto?' \u2014 '+E(x.bto)+' did not receive it':''}</div>`:''}<div class="mu">From ${E(x.from||'')}${x.by?' · by '+E(uName(x.by)):''} · To ${E((x.to||[]).join(', ')||'—')}${x.cc?.length?' · Cc '+E(x.cc.join(', ')):''}</div>
<div class="rw" style="margin-top:6px;gap:12px;align-items:flex-start">${x.snippet?`<div class="prev" style="color:var(--c-muted);flex:1 1 240px;min-width:0">${E(x.snippet.slice(0,200))}</div>`:'<span style="flex:1 1 120px"></span>'}<span class="rw actbar" style="flex:0 0 auto;gap:6px;justify-content:flex-end"><button class="rd gh">Read full message</button>${(SENTV==='mine'&&x.status==='queued')?`<button class="pbk gh" data-id="${E(x.id)}">↩ Pull back to draft</button>${x.priority?'':`<button class="snw gh" data-id="${E(x.id)}" title="Send this now instead of waiting for the next run">⚡ Send now</button>`}`:''}${(x.status==='bounced'&&(x.oid||x.t==='out'))?`<button class="rsnd gh" data-oid="${E(x.oid||x.id)}" title="Open this again as a new mail with everything filled in, so you can correct the address and send">↻ Resend / change address</button>`:''}</span></div><div class="body" hidden></div></div>`).join('')
:'<div class="e">'+(SENTV==='mine'?'You have not sent or queued any mail from the portal yet.':'No sent mail captured yet — it appears here as it syncs.')+'</div>';
sl.querySelectorAll('.card[data-g]').forEach(c=>{
const rd=c.querySelector('.rd'),sub=c.querySelector('.sub');
if(rd)rd.onclick=()=>revealSent(c);if(sub)sub.onclick=()=>revealSent(c)});
sl.querySelectorAll('.rsnd').forEach(b=>b.onclick=e=>{e.stopPropagation();_resend(b.dataset.oid,b)});
sl.querySelectorAll('.pbk').forEach(b=>b.onclick=async()=>{b.disabled=1;
const{error}=await hd.from('outbound_messages').update({status:'draft'}).eq('id',b.dataset.id).eq('created_by',me.id);
error?(toast(error.message,true),b.disabled=0):(toast('Pulled back to a draft — find it under Drafts'),go(true))});
sl.querySelectorAll('.snw').forEach(b=>b.onclick=async()=>{if(!await conf(SEND_NOW_WARN,{okText:'Send now'}))return;b.disabled=1;b.textContent='Sending…';await markPriority(b.dataset.id);toast('Sending now — usually under a minute.');go(true);sendNowKick(b.dataset.id,false)})}
async function _openStored(p,fn){if(!p){toast('That file is no longer stored',true);return}
const{data,error}=await pb.storage.from('helpdesk-attachments').createSignedUrl(p,600);
if(error||!data?.signedUrl){toast('Could not open '+(fn||'the file')+(error?': '+error.message:''),true);return}
window.open(data.signedUrl,'_blank','noopener')}
function _attRow(list){return list.length?`<div class="rw" style="gap:6px;flex-wrap:wrap;margin-top:8px">${list.join('')}</div>`:''}
async function _resend(oid,btn){if(!oid){toast('That mail cannot be reopened',true);return}
if(btn){btn.disabled=1;btn.textContent='Opening\u2026'}
try{
const{data:o,error}=await hd.from('outbound_messages').select('*').eq('id',oid).maybeSingle();
if(error||!o)throw new Error(error?error.message:'That mail is no longer available');
const{data:atts}=await hd.from('outbound_attachments').select('filename,mime_type,size_bytes,storage_path').eq('outbound_id',oid);
const{data:d,error:ie}=await hd.from('outbound_messages').insert({tenant_id:o.tenant_id,ticket_id:o.ticket_id,thread_id:o.thread_id,
from_inbox_id:o.from_inbox_id,to_emails:o.to_emails,cc_emails:o.cc_emails,bcc_emails:o.bcc_emails,
subject:o.subject,body_html:o.body_html,body_text:o.body_text,created_by:me.id,status:'draft'}).select().single();
if(ie)throw new Error(ie.message);
if((atts||[]).length){const{error:ae}=await hd.from('outbound_attachments').insert((atts||[]).map(a=>({tenant_id:o.tenant_id,outbound_id:d.id,filename:a.filename,mime_type:a.mime_type,size_bytes:a.size_bytes,storage_path:a.storage_path,created_by:me.id})));
if(ae)toast('Reopened, but the attachments could not be carried over: '+ae.message,true)}
CM=d;toast('Reopened as a new mail \u2014 change the address or anything else, then send');go()}
catch(e){toast(e.message,true);if(btn){btn.disabled=0;btn.textContent='\u21bb Resend / change address'}}}
async function revealSentAtt(c,body){
if(c.dataset.t==='out'){const r=[...SNTM,...SNTQ].find(x=>x.id===c.dataset.g)||{};
const a=(r.outbound_attachments||[]).map(a=>`<span class="chip oatt" data-p="${E(a.storage_path||'')}" data-fn="${E(a.filename||'file')}" title="Click to open">\ud83d\udcce ${E(a.filename||'file')} <span class="mu">${KB(a.size_bytes)}</span></span>`);
if(a.length){body.insertAdjacentHTML('beforeend',_attRow(a));body.querySelectorAll('.oatt').forEach(x=>x.onclick=()=>_openStored(x.dataset.p,x.dataset.fn))}return}
try{const by=await attachChips(null,[c.dataset.g]);const ch=(by[c.dataset.g]||[]);
if(ch.length){body.insertAdjacentHTML('beforeend',_attRow(ch.map(chipHtml)));wireChips(body)}}catch(_x){}}
async function revealSent(c){const body=c.querySelector('.body');if(!body)return;
if(!body.hidden){body.hidden=true;return}
if(c.dataset.t==='out'){const r=[...SNTM,...SNTQ].find(x=>x.id===c.dataset.g)||{};
const _mk='s:'+c.dataset.g;
body.innerHTML=r.body_html?(MHTML[_mk]=r.body_html,`<div class="mailhost" data-mid="${_mk}"></div>`):('<pre style="white-space:pre-wrap;margin:0">'+E(r.body_text||'')+'</pre>');body.hidden=false;hydrateMail(c);revealSentAtt(c,body);return}
const{data}=await hd.from('messages').select('body_text,body_html,snippet').eq('id',c.dataset.g).maybeSingle();
const _mk2='m:'+c.dataset.g;
body.innerHTML=data?.body_html?(MHTML[_mk2]=data.body_html,`<div class="mailhost" data-mid="${_mk2}"></div>`):('<pre style="white-space:pre-wrap;margin:0">'+E(data?.body_text||data?.snippet||'')+'</pre>');body.hidden=false;hydrateMail(c);revealSentAtt(c,body)}
function wireSent(m){renderSent(m);
m.querySelectorAll('[data-sv]').forEach(b=>b.onclick=()=>{SENTV=b.dataset.sv;SKIND='all';if(SENTV==='mine')SF.org='';go(true)});
m.querySelectorAll('[data-sk]').forEach(b=>b.onclick=()=>{SKIND=b.dataset.sk;m.querySelectorAll('[data-sk]').forEach(x=>{const on=x.dataset.sk===SKIND;x.style.background=on?'var(--c-accent)':'transparent';x.style.color=on?'#fff':'var(--c-muted)';x.style.borderColor=on?'var(--c-accent)':'var(--c-border)'});renderSent(m)});
const q=m.querySelector('#sf_q');if(q)q.oninput=()=>{SF.q=q.value;renderSent(m)};
const si=m.querySelector('#sf_i');if(si)si.onchange=()=>{SF.inbox=si.value;renderSent(m)};
const sb=m.querySelector('#sf_by');if(sb)sb.onchange=()=>{SF.by=sb.value;renderSent(m)};
const sd=m.querySelector('#sf_dlv');if(sd)sd.onchange=()=>{SF.dlv=sd.value;renderSent(m)};
const so=m.querySelector('#sf_org');if(so)so.onchange=()=>{SF.org=so.value;renderSent(m)};
const sa=m.querySelector('#sf_att');if(sa)sa.onchange=()=>{SF.att=sa.value;renderSent(m)};
const ss=m.querySelector('#sf_sort');if(ss)ss.onchange=()=>{SF.sort=ss.value;renderSent(m)}}

// ---------- archive ----------
async function archView(){
SARCH=Math.max(1,Math.min(3650,(TSET&&TSET.sent_archive_days)||90));
const _scut=new Date(Date.now()-SARCH*864e5).toISOString().slice(0,19)+'Z';
const[ig,od,sn]=await Promise.all([
hd.from('messages').select('id,subject,from_email,from_name,sent_at,classified_at,classified_by,snippet,inbox_id,has_attachments').eq('classification','ignore').order('classified_at',{ascending:false}).limit(200),
hd.from('messages').select('id,subject,from_email,from_name,sent_at,snippet,classification,ticket_id,inbox_id,has_attachments').eq('archived',true).eq('direction','inbound').order('sent_at',{ascending:false}).limit(200),
hd.from('messages').select('id,subject,to_emails,from_email,from_name,sent_at,snippet,classification,ticket_id,inbox_id,has_attachments').eq('direction','outbound').or('archived.eq.true,sent_at.lt.'+_scut).order('sent_at',{ascending:false}).limit(200)]);
if(ig.error)return `<div class="e">${E(ig.error.message)}</div>`;
IGD=ig.data??[];ODD=od.data??[];SND=sn.data??[];
return `<div class="note">Two shelves, kept separate. <b>Ignored</b> — mail someone chose to ignore; it stays here so
mistakes can be undone, and Restore puts it straight back in Inbox. Ignored mail is deleted for good only after the
admin-set window (Mailboxes → Retention). <b>Auto-archived</b> — mail past the retention window, tucked away
automatically. Archiving is <b>conversation-aware</b>: a thread is archived only once its <b>latest</b> mail is older than
the window, so an active back-and-forth is never archived mid-way. Mail that was already sorted onto a ticket shows no
Restore button \u2014 it is not waiting in Inbox, it lives on its ticket. <b>Sent archive</b> \u2014 mail this firm sent that is older than the sent-archive window (currently <b>${SARCH}</b> days, set in Mailboxes \u2192 Retention) or already archived. Gmail is untouched either way.</div>
<div class="ftabs" style="border:none;position:static;margin-bottom:12px">
<b class="${AF==='ignored'?'on':''}" data-a="ignored">Ignored (${IGD.length}${IGD.length===200?'+':''})</b>
<b class="${AF==='old'?'on':''}" data-a="old">Auto-archived (${ODD.length}${ODD.length===200?'+':''})</b>
<b class="${AF==='sent'?'on':''}" data-a="sent">Sent archive (${SND.length}${SND.length===200?'+':''})</b></div>
<div class="fbar" id="ar_bar">${archBar()}</div>
<div id="alist"></div>`}
function renderArch(m){const al=m.querySelector('#alist');if(!al)return;
const _src=AF==='ignored'?IGD:AF==='sent'?SND:ODD;
let rows=((ASQ||'').trim().length>=2&&ASRES)?ASRES.slice():_src.slice();
const q=(ASQ||'').trim().toLowerCase();
if(q)rows=rows.filter(x=>((x.subject??'')+' '+(x.from_name??'')+' '+(x.from_email??'')+' '+((x.to_emails||[]).join(' '))).toLowerCase().includes(q));
if(AFIL.inbox)rows=rows.filter(x=>x.inbox_id===AFIL.inbox);
if(AFIL.att==='1')rows=rows.filter(x=>!!x.has_attachments);else if(AFIL.att==='0')rows=rows.filter(x=>!x.has_attachments);
if(AFIL.by)rows=rows.filter(x=>x.classified_by===AFIL.by);
if(AFIL.tk==='1')rows=rows.filter(x=>!!x.ticket_id);else if(AFIL.tk==='0')rows=rows.filter(x=>!x.ticket_id);
if(AFIL.days){const _cut=Date.now()-(+AFIL.days)*864e5;rows=rows.filter(x=>+new Date(x.sent_at||x.classified_at||0)>=_cut)}
const dt=x=>AF==='ignored'?(x.classified_at||x.sent_at):x.sent_at;
rows.sort((a,b)=>ASORT==='oldest'?(+new Date(dt(a)))-(+new Date(dt(b))):(+new Date(dt(b)))-(+new Date(dt(a))));
const ctn=m.querySelector('#ar_ct');if(ctn)ctn.textContent=((ASQ||'').trim().length>=2?`${rows.length} found in the archive`:`${rows.length} shown \u00b7 ${_src.length} loaded`);
al.innerHTML=rows.length?rows.map(x=>`<div class="card" data-g="${x.id}">
<div class="rw" style="justify-content:space-between"><div class="sub" style="flex:1;cursor:pointer">${E(x.subject||'(no subject)')}</div><span class="mu">${AF==='sent'?'sent':'received'} ${A(x.sent_at)}</span></div>
<div class="mu">${AF==='sent'?'to '+E((x.to_emails||[]).join(', ')||'\u2014'):E(x.from_name||x.from_email||'')}${AF==='ignored'?` \u00b7 ignored ${A(x.classified_at)} by ${E(uName(x.classified_by))}`:x.ticket_id?' \u00b7 attached to a ticket \u2014 still visible there':''}</div>
<div class="prev mu" style="margin-top:4px">${E((x.snippet||'').slice(0,180))}</div>
<div class="body" hidden></div>
<div class="rw" style="margin-top:8px"><button class="rd gh">Read full message</button>
${AF==='sent'?'<span class="pill d">sent mail \u2014 archived copy</span>':me.crm&&(AF==='ignored'||!x.ticket_id)?`<button class="rst" data-id="${x.id}">\u21a9 Restore to Inbox</button>`
:AF==='old'?'<span class="pill i">already sorted \u2014 lives on its ticket</span>':''}</div>
</div>`).join(''):`<div class="e">${q?'Nothing matches.':AF==='ignored'?'Nothing ignored.':AF==='sent'?'No sent mail is old enough for the archive yet.':'Nothing auto-archived yet.'}</div>`;
al.querySelectorAll('.card[data-g]').forEach(c=>{const rd=c.querySelector('.rd');if(rd)rd.onclick=()=>reveal(c);
const sub=c.querySelector('.sub');if(sub)sub.onclick=()=>reveal(c)});
al.querySelectorAll('.rst').forEach(b=>b.onclick=async()=>{
b.disabled=1;
const{error}=await hd.rpc('restore_message',{p_message_id:b.dataset.id});
error?(toast(error.message,true),b.disabled=0):(toast('Restored — back in Inbox'),go(true))})}
let _asDeb;
let ARCHGEN=0;
async function archSearch(m){const q=(ASQ||'').trim();
if(q.length<2){ASRES=null;renderArch(m);return}
clearTimeout(_asDeb);_asDeb=setTimeout(async()=>{
const _ag=++ARCHGEN,_af=AF;
const ss=q.replace(/[%,()*]/g,'');
const base=hd.from('messages').select('id,subject,to_emails,from_email,from_name,sent_at,classified_at,classified_by,snippet,classification,ticket_id,inbox_id,has_attachments');
const _sc2=new Date(Date.now()-(SARCH||90)*864e5).toISOString().slice(0,19)+'Z';
const qy=AF==='ignored'?base.eq('classification','ignore'):AF==='sent'?base.eq('direction','outbound').or('archived.eq.true,sent_at.lt.'+_sc2):base.eq('archived',true).eq('direction','inbound');
const{data}=await qy.or(`subject.ilike.%${ss}%,from_email.ilike.%${ss}%,from_name.ilike.%${ss}%,snippet.ilike.%${ss}%`).order('sent_at',{ascending:false}).limit(200);
if(_ag!==ARCHGEN||_af!==AF)return;ASRES=data??[];renderArch(m)},300)}
let AFIL={inbox:'',att:'',days:'',by:'',tk:''};
function archBar(){return `<input type="search" id="ar_q" placeholder="Search subject, sender…" value="${E(ASQ)}">${(me.crm?INB.length:MYVIS.size)>1?`<select id="ar_in"><option value="">Mailbox: any</option>${INB.filter(i=>me.crm||MYVIS.has(i.id)).map(i=>`<option value="${E(i.id)}" ${AFIL.inbox===i.id?'selected':''}>${E(i.email_address)}</option>`).join('')}</select>`:''}<select id="ar_att"><option value="">Attachments: any</option><option value="1" ${AFIL.att==='1'?'selected':''}>With attachments</option><option value="0" ${AFIL.att==='0'?'selected':''}>Without</option></select><select id="ar_days"><option value="">Any time</option>${[['7','Last 7 days'],['30','Last 30 days'],['90','Last 90 days'],['365','Last year']].map(([v,l])=>`<option value="${v}" ${AFIL.days===v?'selected':''}>${l}</option>`).join('')}</select>${AF==='ignored'?`<select id="ar_by"><option value="">Ignored by: anyone</option>${ppl.map(p=>`<option value="${E(p.id)}" ${AFIL.by===p.id?'selected':''}>${E(p.n)}</option>`).join('')}</select>`:''}${AF==='old'?`<select id="ar_tk"><option value="">On a ticket: any</option><option value="1" ${AFIL.tk==='1'?'selected':''}>Attached to a ticket</option><option value="0" ${AFIL.tk==='0'?'selected':''}>Not on a ticket</option></select>`:''}
<select id="ar_sort"><option value="newest" ${ASORT==='newest'?'selected':''}>Newest first</option><option value="oldest" ${ASORT==='oldest'?'selected':''}>Oldest first</option></select>${(ASQ||AFIL.inbox||AFIL.att||AFIL.days||AFIL.by||AFIL.tk)?`<button type="button" class="gh" id="ar_clr" title="Clear search and filters">✕ Clear filters</button>`:''}<span class="mu" id="ar_ct"></span>`}
function wireArchBar(m){const q=m.querySelector('#ar_q');if(q)q.oninput=()=>{ASQ=q.value;archSearch(m)};
const s=m.querySelector('#ar_sort');if(s)s.onchange=()=>{ASORT=s.value;renderArch(m)};
[['ar_in','inbox'],['ar_att','att'],['ar_days','days'],['ar_by','by'],['ar_tk','tk']].forEach(([id,k])=>{const _x=m.querySelector('#'+id);if(_x)_x.onchange=()=>{AFIL[k]=_x.value;renderArch(m)}});
const _ac=m.querySelector('#ar_clr');if(_ac)_ac.onclick=()=>{ASQ='';ASRES=null;AFIL={inbox:'',att:'',days:'',by:'',tk:''};go(true)}}
function wireArch(m){renderArch(m);if((ASQ||'').trim().length>=2)archSearch(m);
m.querySelectorAll('.ftabs b').forEach(b=>b.onclick=()=>{AF=b.dataset.a;
m.querySelectorAll('.ftabs b').forEach(x=>x.classList.toggle('on',x===b));
AFIL.by='';AFIL.tk='';
const _bar=m.querySelector('#ar_bar');if(_bar){_bar.innerHTML=archBar();wireArchBar(m)}
archSearch(m)});
wireArchBar(m)}

// ---------- ticket reading pane ----------
async function oneView(id,th){const{data:t}=await hd.from('v_ticket_workspace').select('*').eq('id',id).maybeSingle();
if(!t)return '<div class="e">Not found.</div>';
OPENT=t;
hd.rpc('mark_seen',{p_ticket:id}).then(()=>{});
const{data:_ms}=th?await hd.from('messages').select('*').eq('thread_id',th).order('sent_at'):{data:[]};const ms=dedupeMsgs(_ms);
const li=[...(ms??[])].reverse().find(m=>m.direction==='inbound');
LI=li;FILES=[];MHTML={};
const by=await attachChips(null,(ms??[]).map(m=>m.id));
hd.rpc('mark_read_many',{p_ids:(ms??[]).map(m=>m.id)}).then(()=>{});
const act=await activityHtml(id);
const stNow=t.status==='closed'?'resolved':t.status;
return `<div class="rw" style="justify-content:space-between;align-items:flex-start;flex-wrap:nowrap;gap:8px"><h2 style="flex:1;min-width:0;margin:0">#${t.ticket_no} ${E(t.subject)}</h2><button class="gh" id="tk_x" title="Close — back to the list">✕ Close</button></div>
<div class="rw" style="padding:12px 0;border-bottom:1px solid var(--c-border)">
<span class="pill ${t.source==='portal'?'i':''}">${E(t.source_label)}</span>
${me.crm?'':priPill(t.priority)}
${t.client_name?clientPill(t.client_name):''}
${t.client_name&&VIPS.has(t.client_name)?'<span class="pill vip">⭐ VIP</span>':''}
${(t.due_at&&!me.crm)?`<span class="pill ${t.health==='breached'?'o':t.health==='at_risk'?'w':''}">due ${A(t.due_at)}</span>`:''}
${me.crm?`<span class="pill ${stNow==='resolved'?'d':stNow==='pending'?'w':''}">${E(stNow)}</span></div>
<div class="rw" style="padding:10px 0 12px;border-bottom:1px solid var(--c-border)"><span style="display:flex;gap:6px;align-items:center;flex-wrap:nowrap;flex:1 1 200px;min-width:160px"><span class="mu" style="font-size:11px;font-weight:600;flex:0 0 auto">Owner</span>${comboHtml('as',[{v:'',label:'Unassigned'}].concat(ppl.map(p=>({v:p.id,label:p.n}))),t.assignee_id||'','Assign to…')}</span>
<span style="display:flex;gap:6px;align-items:center;flex-wrap:nowrap;flex:0 0 auto"><span class="mu" style="font-size:11px;font-weight:600;flex:0 0 auto">Urgency</span><select id="pr" title="Urgency">${[[1,'Urgent'],[2,'High'],[3,'Normal']].map(([v,l])=>`<option value="${v}" ${(t.priority??3)==v?'selected':''}>${l}</option>`).join('')}</select></span>
<span style="display:flex;gap:6px;align-items:center;flex-wrap:nowrap;flex:0 0 auto"><span class="mu" style="font-size:11px;font-weight:600;flex:0 0 auto">Due</span><input type="date" id="dl" min="${toDate(new Date())}" max="${dlMaxDate()}" title="Deadline (date)" value="${t.due_at?toDate(t.due_at):''}">${t.due_at?`<span class="${t.health==='breached'?'pill o':t.health==='at_risk'?'pill w':'mu'}" title="Time left on this deadline">${E(Ap(t.due_at))}</span>`:''}</span>${_canSB(t)?`<button class="gh" id="mv_back" style="margin-left:auto" title="Return this to Inbox with a remark">↩ Send back</button>`:''}`
:`<span class="pill i">${E(t.assignee_name??(t.is_pool?'pool':'unassigned'))}</span><span class="pill ${stNow==='resolved'?'d':stNow==='pending'?'w':''}">${E(stNow)}</span>
${t.assignee_id===me.id?(['resolved','closed'].includes(t.status)?`<button class="pri" id="mv_reopen">↩ Reopen</button>`:`<button class="pri" id="mv_res">✓ Resolve</button>
<button id="mv_pnd">${t.status==='pending'?'▶ Resume':'⏸ Mark pending'}</button>
${_canSB(t)?`<button class="gh" id="mv_back" title="${t.is_pool?'Return this to the document pool with a remark — everyone sees who sent it back and why':'Return this to Inbox with a remark — the sorter sees who sent it back and why'}">↩ Send back</button>`:''}`):''}`}</div>
${(!me.crm&&t.assignee_id===me.id)?`<div class="mu" style="margin-top:6px">Assigned work is fixed — the deadline, urgency and owner can only be changed by an admin. If this should not be yours, use <b>Send back</b> with a remark.</div>`:''}
<div style="margin-top:16px">${(ms??[]).slice().reverse().map(m=>`<div class="msg ${m.direction==='outbound'?'o':''}">
<div class="rw">${avat(m.from_name||m.from_email)}<div><div><b style="font-size:13px">${E(m.from_name||m.from_email)}</b> ${LBL(m.headers?.labels)}</div>
<div class="mu">To: ${E((m.to_emails||[]).join(', ')||'—')} · ${E(FDT(m.sent_at))}</div></div></div>
${(by[m.id]?.length)?`<div class="rw" style="margin-top:7px">${by[m.id].map(chipHtml).join('')}</div>`:''}
${m.body_html?(MHTML[m.id]=m.body_html,`<div class="mailhost" data-mid="${m.id}"></div>`):`<div style="margin-top:6px">${P(m.body_text??m.snippet)}</div>`}
</div>`).join('')||'<div class="e">No messages yet.</div>'}</div>
${act}
${t.thread_id?(['resolved','closed'].includes(t.status)?`<div class="note" style="margin-top:12px">This ticket is <b>resolved</b> — reopen it (button at the top) to reply or make changes.</div>`:`<div class="card">
${me.crm?`<div class="rw" style="margin-bottom:8px"><span class="mu" style="width:44px">Owner</span>
${comboHtml('ras',[{v:'',label:'Unassigned'}].concat(ppl.map(p=>({v:p.id,label:p.n}))),t.assignee_id||'','Re-assign this thread…')}
<span class="mu">re-assign without leaving the reply</span></div>`:''}
<div class="rw"><span class="mu" style="width:44px">Subject</span>
<input id="sj" style="flex:1" value="${E(t.subject.startsWith('Re:')?t.subject:'Re: '+t.subject)}"></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:44px">To</span>
<input id="to" list="cedl" style="flex:1" value="${E(li?.from_email??'')}"><button class="gh" id="ra">Reply all</button></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:44px">Cc</span>
<input id="cc" list="cedl" style="flex:1" placeholder="Optional — comma-separated"></div>
<div class="rw" style="margin-top:8px"><span class="mu" style="width:44px">Bcc</span>
<input id="bc" list="cedl" style="flex:1" placeholder="Optional — checked against the allow-list too"></div>
<label class="mu" style="display:flex;gap:6px;align-items:center;margin-top:8px"><input type="checkbox" id="rr"> Request read receipt (recipient's mail client decides whether to send one)</label>
<div style="margin-top:10px">${rteHtml('rp','<p><br></p>'+sigTail())}</div>
<div class="rw" style="margin-top:8px"><button class="gh" id="af">📎 Attach files</button>
<input id="att" type="file" multiple hidden><span id="fl" class="rw"></span></div>
<div class="mu" style="margin-top:6px">Sends from ${E(t.inbox??"the firm's mailbox")}. Use <b>Send on next run</b> for normal replies, or <b>⚡ Send now</b> for urgent ones — it goes out within about a minute.</div>
<div id="sm"></div><div class="rw" style="margin-top:8px"><button class="pri" id="sd">Send on next run</button><button class="gh" id="sdnow" title="Urgent only — sends within about a minute">⚡ Send now</button></div></div>`):''}`}

let RPD={},UPQ=[],CMEX=[];
async function upClean(){if(!UPQ.length)return;const _p=UPQ.slice();UPQ=[];try{await pb.storage.from('helpdesk-attachments').remove(_p)}catch(_x){}}
function wireTicket(m){ensureCEDatalist();bindCE(m,'reply','#sd');
{const _rp=m.querySelector('#rp'),_tk=open&&open.i;
if(_rp&&_tk){const _sv=RPD[_tk];if(_sv&&_sv.replace(/<[^>]*>|&nbsp;|\s/g,''))_rp.innerHTML=_sv;
_rp.addEventListener('input',()=>{RPD[_tk]=_rp.innerHTML})}}
const doAssign=async(val)=>{const{error}=await hd.rpc('assign_ticket',{p_ticket_id:open.i,p_assignee:val||null,p_reason:null});
if(error)toast(error.message,true);else{toast(val?('Assigned to '+uName(val)):'Unassigned');go(true)}};
wireCombo(m,(id,val)=>{if(id==='as'||id==='ras')doAssign(val)});
const kx=m.querySelector('#tk_x');if(kx)kx.onclick=()=>{open=null;const rd=m.querySelector('#read');if(rd)rd.innerHTML='<div class="e">Select a mail on the left to read it here.</div>';m.querySelectorAll('.lrow.on').forEach(r=>r.classList.remove('on'));cbCtx(m)};
const st=m.querySelector('#st');if(st)st.onchange=async()=>{
const{error}=await hd.from('tickets').update({status:st.value,
closed_at:st.value==='resolved'?new Date().toISOString():null}).eq('id',open.i);
error?toast(error.message,true):(toast(st.value==='resolved'?'Resolved — moved to the Resolved tab':'Status: '+st.value),go(true))};
const mres=m.querySelector('#mv_res');if(mres)mres.onclick=async()=>{
const{error}=await hd.from('tickets').update({status:'resolved',closed_at:new Date().toISOString()}).eq('id',open.i);
error?toast(error.message,true):(toast('Resolved — moved to the Resolved tab'),open=null,go(true))};
const mro=m.querySelector('#mv_reopen');if(mro)mro.onclick=async()=>{const{error}=await hd.from('tickets').update({status:'open',closed_at:null}).eq('id',open.i);error?toast(error.message,true):(toast('Reopened'),go(true))};
const mpnd=m.querySelector('#mv_pnd');if(mpnd)mpnd.onclick=async()=>{
const nv=OPENT?.status==='pending'?'open':'pending';
const{error}=await hd.from('tickets').update({status:nv}).eq('id',open.i);
error?toast(error.message,true):(toast(nv==='pending'?'Marked pending — see My tickets → Pending':'Resumed'),go(true))};
const mbk=m.querySelector('#mv_back');if(mbk)mbk.onclick=async()=>{
const _pool=!!OPENT?.is_pool;
const rm=await ask((_pool?'Send this back to the document pool — a remark is required.':'Send this back to Inbox — a remark is required.')+'\n\nWhy is it being sent back?');
if(rm===null)return;
if(!rm.trim()){toast('A remark is required to send a ticket back',true);return}
const{error}=await hd.rpc('send_back_ticket',{p_ticket:open.i,p_remark:rm.trim()});
error?toast(error.message,true):(toast(_pool?'Sent back to the document pool with your remark':'Sent back to Inbox with your remark'),open=null,go(true))};
const pr=m.querySelector('#pr');if(pr)pr.onchange=async()=>{
const{error}=await hd.from('tickets').update({priority:+pr.value}).eq('id',open.i);
error?toast(error.message,true):(toast('Priority: '+(PRI[+pr.value]?.[0]??'')),go(true))};
const dlf=m.querySelector('#dl');if(dlf)dlf.onchange=async()=>{
const v=dlf.value?dISO(dlf.value):null;
const{error}=await hd.from('tickets').update({due_at:v}).eq('id',open.i);
error?toast(error.message,true):(toast(v?'Reply deadline set — it will surface in Late & at risk as it nears':'Deadline cleared'),go(true))};
const ra=m.querySelector('#ra');if(ra)ra.onclick=()=>{
if(!LI)return;
const cc=[...new Set([...(LI.to_emails||[]),...(LI.cc_emails||[])])]
.filter(a=>a&&!OWN.has(a.toLowerCase())&&a.toLowerCase()!==(LI.from_email||'').toLowerCase());
m.querySelector('#to').value=LI.from_email||'';
m.querySelector('#cc').value=cc.join(', ');
toast(cc.length?'Reply-all recipients filled':'No extra recipients on that message')};
const af=m.querySelector('#af'),att=m.querySelector('#att'),fl=m.querySelector('#fl');
const renderFl=()=>{if(!fl)return;
fl.innerHTML=FILES.map((f,i)=>`<span class="chip" data-x="${i}" title="Click to remove">📎 ${E(f.name)} <span class="mu">${KB(f.size)}</span> ✕</span>`).join('');
fl.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{FILES.splice(+c.dataset.x,1);renderFl()})};
if(af)af.onclick=()=>att.click();
if(att)att.onchange=()=>{for(const f of att.files){
if(f.size>15*1048576){toast(f.name+' is over 15 MB — send a link instead',true);continue}
if(FILES.length>=5){toast('Five files max per reply',true);break}
FILES.push(f)}att.value='';renderFl()};
const sd=m.querySelector('#sd'),sdnow=m.querySelector('#sdnow');const sendReply=async(now)=>{const btn=now?sdnow:sd;if(!btn)return;
const val=id=>m.querySelector('#'+id).value;
const list=s=>s.split(/[,;]/).map(x=>x.trim()).filter(Boolean);
const to=list(val('to')),cc=list(val('cc')),bc=list(val('bc'));
const{html,text}=edOut(m,'rp');
const sj=val('sj').trim(),out=m.querySelector('#sm');
if(!to.length||!text){out.innerHTML='<div class="blk">Add a recipient and a message.</div>';return}
sd.disabled=1;if(sdnow)sdnow.disabled=1;btn.textContent='Sending…';
try{
const ups=[];
for(const f of FILES){
const path=`outbound/${crypto.randomUUID()}/${f.name.replace(/[^\w.\- ]+/g,'_').slice(0,140)}`;
const{error:ue}=await pb.storage.from('helpdesk-attachments').upload(path,f,{contentType:f.type||'application/octet-stream'});
if(ue)throw new Error('Upload failed for '+f.name+': '+ue.message);
ups.push({path,f});UPQ.push(path)}
const _TK=open&&open.i;if(!_TK)throw new Error('That ticket was closed — reopen it and send again.');
const{data:t}=await hd.from('tickets').select('tenant_id,thread_id,inbox_id,subject').eq('id',_TK).single();
if(!t)throw new Error('That ticket is no longer available.');
const{data,error}=await hd.from('outbound_messages').insert({tenant_id:t.tenant_id,ticket_id:_TK,
thread_id:t.thread_id,from_inbox_id:t.inbox_id,to_emails:to,cc_emails:cc,bcc_emails:bc,
request_receipt:!!m.querySelector('#rr')?.checked,
subject:sj||(t.subject.startsWith('Re:')?t.subject:'Re: '+t.subject),
body_html:html,body_text:text,created_by:me.id,status:'queued'}).select().single();
if(error)throw new Error(/not allowed to send/i.test(error.message)?'You are not allowed to send from this mailbox — it is outside your mailbox access list.':error.message);
if(ups.length){const rows=ups.map(u=>({tenant_id:t.tenant_id,outbound_id:data.id,filename:u.f.name,
mime_type:u.f.type||null,size_bytes:u.f.size,storage_path:u.path,created_by:me.id}));
const{error:ae}=await hd.from('outbound_attachments').insert(rows);
if(ae)throw new Error('Reply queued but attachments failed to register: '+ae.message)}
UPQ=[];
if(data.status==='blocked'){out.innerHTML=`<div class="blk"><b>Not sent.</b> ${E(data.blocked_reason)}<br>
Client mail can only go to that client and to approved addresses. If it is legitimate, request approval and an admin can let it through.<div style="margin-top:8px"><button class="pri" id="rp_reqap">Request approval to send</button></div></div>`;
const _rq=out.querySelector('#rp_reqap');if(_rq)_rq.onclick=async()=>{_rq.disabled=1;_rq.textContent='Requesting…';const{error:_e}=await hd.rpc('request_send_approval',{p_outbound:data.id});if(_e){_rq.disabled=0;_rq.textContent='Request approval to send';toast(_e.message,true)}else{toast('Sent for approval — it goes out once an admin approves');out.innerHTML='<div class="note">Sent to an admin for approval — it will go out once approved.</div>';FILES=[];renderFl()}};return}
out.innerHTML='';UPQ=[];
try{delete RPD[_TK]}catch(_x){}
if(now){await markPriority(data.id);toast('Sending now — usually under a minute.')}
else toast(ups.length?`Queued with ${ups.length} attachment${ups.length===1?'':'s'} — goes out on the next mail run (~${nrun()})`:`Queued — goes out on the next mail run (~${nrun()}). Need it sooner? Use ⚡ Send now.`);
FILES=[];renderFl();
if(PENDRESOLVE&&open&&PENDRESOLVE===open.i){const _rid=open.i;PENDRESOLVE=null;let _re=null;try{({error:_re}=await hd.from('tickets').update({status:'resolved',closed_at:new Date().toISOString()}).eq('id',_rid))}catch(_x){_re=_x}
if(_re){toast('Reply sent, but marking it resolved failed: '+(_re.message||_re),true);go(true);return}
toast('Replied and resolved — moved to Resolved.');open=null;tab='resolved';setTimeout(()=>go(),300);return}
const ed=m.querySelector('#rp');if(ed)ed.innerHTML='<p><br></p>'+sigTail();
if(now)sendNowKick(data.id,true);
}catch(e){upClean();out.innerHTML=`<div class="blk">${E(e.message)}</div>`}
finally{sd.disabled=0;if(sdnow)sdnow.disabled=0;sd.textContent='Send on next run';if(sdnow)sdnow.textContent='⚡ Send now'}};
if(sd)sd.onclick=()=>sendReply(false);
if(sdnow)sdnow.onclick=async()=>{if(await conf(SEND_NOW_WARN,{okText:'Send now'}))sendReply(true)}}

// ---------- help tickets (report an issue) ----------
async function _capShot(name){
if(navigator.mediaDevices&&navigator.mediaDevices.getDisplayMedia){
try{const st=await navigator.mediaDevices.getDisplayMedia({video:{displaySurface:'browser'},audio:false,preferCurrentTab:true});
const v=document.createElement('video');v.srcObject=st;v.muted=true;v.playsInline=true;await v.play();
await new Promise(r=>setTimeout(r,220));
const w=v.videoWidth||0,h=v.videoHeight||0;let f=null;
if(w&&h){const cv=document.createElement('canvas');cv.width=w;cv.height=h;
cv.getContext('2d').drawImage(v,0,0,w,h);
const bl=await new Promise(res=>cv.toBlob(res,'image/png'));
if(bl&&bl.size>2000)f=new File([bl],name,{type:'image/png'})}
st.getTracks().forEach(t=>{try{t.stop()}catch(_x){}});v.srcObject=null;
if(f)return f}catch(e){if(e&&(e.name==='NotAllowedError'||e.name==='AbortError'))throw e}}
const mod=await import('https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/+esm');const h2c=mod.default||mod;
const canvas=await h2c(document.body,{scale:Math.min(2,window.devicePixelRatio||1),logging:false,useCORS:true,backgroundColor:getComputedStyle(document.body).backgroundColor||'#ffffff'});
const bl2=await new Promise(res=>canvas.toBlob(res,'image/png'));
return new File([bl2],name,{type:'image/png'})}
function supportModal(){const o=document.createElement('div');o.className='ovl';
o.innerHTML=`<div class="box"><div class="rw" style="justify-content:space-between;align-items:center;margin-bottom:6px;gap:10px"><h2 style="margin:0">🛟 Report an issue</h2>${NMYHELP>0?'<button class="gh" id="sp_track" style="font-size:12px;padding:6px 11px;white-space:nowrap;border-color:var(--c-accent);color:var(--c-accent)">📋 Track my tickets</button>':''}</div>
<div class="mu" style="margin-bottom:10px">Found a bug or something not working right? Describe it and it goes straight to the portal admin. A screenshot helps but is optional.</div>
<textarea id="sp_b" rows="5" style="width:100%" placeholder="What went wrong? What were you doing, and what did you expect? (at least 20 characters)"></textarea>
<div class="rw" style="margin-top:10px"><button class="gh" id="sp_af">📎 Attach screenshot (optional)</button><button class="gh" id="sp_cap">📸 Capture this screen</button>
<input id="sp_file" type="file" accept="image/*" multiple hidden><span id="sp_fn" class="mu"></span></div>
<div id="sp_fl" class="rw" style="gap:6px;flex-wrap:wrap;margin-top:6px"></div>
<div id="sp_msg"></div>
<div class="rw" style="margin-top:14px;justify-content:flex-end">
<button class="gh" id="sp_x">Cancel</button><button class="pri" id="sp_s">Send to portal admin</button></div></div>`;
document.body.appendChild(o);
let files=[];const SPMAX=5;
const _spfl=()=>{const fl=o.querySelector('#sp_fl'),fn=o.querySelector('#sp_fn');
if(fn)fn.textContent=files.length?files.length+' of '+SPMAX+' attached':'';
if(!fl)return;
fl.innerHTML=files.map((f,i)=>`<span class="chip" data-x="${i}" title="Click to remove">🖼 ${E(f.name)} <span class="mu">${KB(f.size)}</span> ✕</span>`).join('');
fl.querySelectorAll('.chip').forEach(c=>c.onclick=()=>{files.splice(+c.dataset.x,1);_spfl()})};
const _spadd=f=>{if(files.length>=SPMAX){toast('Up to '+SPMAX+' screenshots',true);return false}
if(!/^image\//.test(f.type)){toast('Screenshots must be an image',true);return false}
if(f.size>15*1048576){toast(f.name+' is over 15 MB',true);return false}
files.push(f);return true};
const _tk=o.querySelector('#sp_track');if(_tk)_tk.onclick=()=>{o.remove();tab='myhelp';go()};
bindCE(o,'help','#sp_s');
const fi=o.querySelector('#sp_file');
o.querySelector('#sp_af').onclick=()=>fi.click();
o.querySelector('#sp_cap').onclick=async()=>{const cap=o.querySelector('#sp_cap');
if(files.length>=SPMAX){toast('Up to '+SPMAX+' screenshots',true);return}
cap.disabled=1;cap.textContent='Capturing…';o.style.display='none';
try{const f=await _capShot('screen-'+(files.length+1)+'.png');if(f&&_spadd(f)){_spfl();toast('Screenshot attached')}}
catch(e){toast((e&&(e.name==='NotAllowedError'||e.name==='AbortError'))?'Screen capture was cancelled':'Capture failed: '+(e&&e.message||e),true)}
o.style.display='';cap.disabled=0;cap.textContent='📸 Capture this screen'};
fi.onchange=()=>{for(const f of Array.from(fi.files||[])){if(!_spadd(f))break}fi.value='';_spfl()};
const close=()=>o.remove();
o.querySelector('#sp_x').onclick=close;
o.onclick=e=>{if(e.target===o)close()};
o.querySelector('#sp_s').onclick=async()=>{
const body=o.querySelector('#sp_b').value.trim(),out=o.querySelector('#sp_msg');
if(body.length<20){out.innerHTML='<div class="blk">Please describe the issue in at least 20 characters.</div>';return}
const btn=o.querySelector('#sp_s');btn.disabled=1;btn.textContent='Sending…';
try{
const paths=[];
for(const f of files){const p=`support/${crypto.randomUUID()}/${f.name.replace(/[^\w.\- ]+/g,'_').slice(0,140)}`;
const{error:ue}=await pb.storage.from('helpdesk-attachments').upload(p,f,{contentType:f.type||'image/png'});
if(ue){if(paths.length){try{await pb.storage.from('helpdesk-attachments').remove(paths)}catch(_x){}}throw new Error('Screenshot upload failed: '+ue.message)}
paths.push(p)}
const path=paths[0]||null;
const{error}=await hd.from('support_requests').insert({tenant_id:me.tenant,body,screenshot_path:path,screenshot_paths:paths.length?paths:null});
if(error){if(paths.length){try{await pb.storage.from('helpdesk-attachments').remove(paths)}catch(_x){}}throw new Error(error.message);}
toast('Sent to the portal admin — thank you');close();
}catch(e){out.innerHTML=`<div class="blk">${E(e.message)}</div>`;btn.disabled=0;btn.textContent='Send to portal admin'}}}

async function _mbAlert(btn){
const em=btn.dataset.e||'',hl=btn.dataset.h||'',er=btn.dataset.m||'';
if(!await conf('Alert the portal admin that '+em+' is not fetching mail?\n\nA help ticket will be raised from your account, with a screenshot of this screen attached.',{title:'\uD83D\uDD14 Alert portal admin',okText:'Yes, alert them'}))return;
btn.disabled=1;const _t0=btn.textContent;btn.textContent='Sending\u2026';
let file=null;
try{file=await _capShot('mailbox-connection.png')}catch(_e){file=null}
const body='Mailbox connection problem \u2014 '+em+'\n\n'+'Connection status: '+(hl||'unknown')+'\n'+(er?'Reported error: '+er+'\n':'')+'Reported by: '+(me.name||'a portal member')+'\n'+'Reported at: '+FDT(new Date())+'\n\n'+'Mail is not being fetched from this mailbox. Please check the connection and re-authorise it if needed.';
let path=null;if(file)path=await _supUpload(file);
const{error}=await hd.from('support_requests').insert({tenant_id:me.tenant,body,screenshot_path:path});
btn.disabled=0;btn.textContent=_t0;
if(error){toast(error.message,true);return}
try{NMYHELP++;NMYHELPO++;paintNav()}catch(_x){}
const o=document.createElement('div');o.className='mdl';
o.innerHTML=`<div class="mdl-box" role="dialog" aria-modal="true" style="width:min(520px,calc(100vw - 20px))"><div class="mdl-t">\u2705 Portal admin alerted</div><div class="mdl-m">A help ticket has been raised from your account for <b>${E(em)}</b>${path?', with a screenshot of this screen attached':''}. The reply will appear under <b>My requests</b> \u2014 you\u2019ll get a nudge in the sidebar when there is one.</div><div class="rw" style="margin-top:14px;justify-content:flex-end;gap:8px"><button class="gh" id="mba_x">Close</button><button class="pri" id="mba_t">\uD83D\uDCCB Track my tickets</button></div></div>`;
document.body.appendChild(o);
const _c=()=>o.remove();o.querySelector('#mba_x').onclick=_c;o.onclick=e=>{if(e.target===o)_c()};
o.querySelector('#mba_t').onclick=()=>{_c();tab='myhelp';go()};
}
async function _supUpload(file){if(!file)return null;const path=`support/${crypto.randomUUID()}/${(file.name||'image.png').replace(/[^\w.\- ]+/g,'_').slice(0,140)}`;const{error}=await pb.storage.from('helpdesk-attachments').upload(path,file,{contentType:file.type||'image/png'});if(error){toast('Attach failed: '+error.message,true);return null}return path}
async function _supShot(p){const{data,error}=await pb.storage.from('helpdesk-attachments').createSignedUrl(p,600);if(error||!data?.signedUrl){toast('Could not open screenshot',true);return}const _u=data.signedUrl;const o=document.createElement('div');o.className='mdl';o.innerHTML=`<div class="mdl-box" role="dialog" aria-modal="true" style="width:min(980px,calc(100vw - 20px));height:min(90vh,940px);max-height:90vh;display:flex;flex-direction:column;padding:0"><div style="padding:10px 14px;border-bottom:1px solid var(--c-border);display:flex;justify-content:space-between;align-items:center;gap:10px"><div class="mdl-t" style="margin:0;font-size:14px;font-weight:600">\uD83D\uDDBC Screenshot</div><div style="display:flex;gap:8px;flex:0 0 auto;align-items:center"><a class="pri" href="${_u}" target="_blank" rel="noopener" style="text-decoration:none;padding:5px 13px;border-radius:6px;font-size:13px">Open original</a><button class="gh sh_x" style="font-size:17px;line-height:1;padding:3px 10px" title="Close">\u2715</button></div></div><div style="flex:1;min-height:0;overflow:auto;display:flex;align-items:center;justify-content:center;background:var(--c-surface-2)"><img src="${_u}" alt="Screenshot" style="max-width:100%;max-height:100%;object-fit:contain"></div></div>`;document.body.appendChild(o);const _cl=()=>o.remove();const _xb=o.querySelector('.sh_x');if(_xb)_xb.onclick=_cl;o.onclick=e=>{if(e.target===o)_cl()};document.addEventListener('keydown',function _k(e){if(e.key==='Escape'){_cl();document.removeEventListener('keydown',_k)}});}
function _supStage(r){if(r.status==='resolved')return['Resolved','d'];if(r.admin_resolved_at)return['Awaiting confirmation','w'];if(r.user_confirmed_at)return['Awaiting close','w'];if(r.status==='open')return['Open','w'];return['In progress','i']}
function _canSB(t){if(me.platform)return true;if(!SBEN)return false;if(me.crm)return SBADMINALL||t.assignee_id===me.id;return SBSCOPE==='everyone'&&t.assignee_id===me.id;}
async function supThreadHTML(id,isAdmin){
const{data,error}=await hd.rpc('support_thread',{p_request:id});
if(error)return `<div class="e">${E(error.message)}</div>`;
const R=data.request,MS=data.messages||[],st=_supStage(R);
const rows=[{sender_id:R.reporter_id,body:R.body,screenshot_path:R.screenshot_path,screenshot_paths:R.screenshot_paths,created_at:R.created_at,read_at:R.report_read_at,read_by:R.report_read_by,_first:true}].concat(MS);
const bubble=x=>{const mine=x.sender_id===me.id;const who=!x.sender_id?'System':x.sender_id===R.reporter_id?uName(R.reporter_id):uName(x.sender_id)+' (Portal Admin)';
return `<div class="rw" style="justify-content:${mine?'flex-end':'flex-start'};margin:8px 0"><div style="max-width:80%;background:${mine?'var(--c-info-bg)':'var(--c-surface-2)'};border:1px solid var(--c-border);border-radius:12px;padding:8px 11px"><div class="mu" style="font-size:11px;margin-bottom:2px">${E(who)}${x._first?' · original report':''} · ${A(x.created_at)}</div>${(()=>{const _ps=(x.screenshot_paths&&x.screenshot_paths.length)?x.screenshot_paths:(x.screenshot_path?[x.screenshot_path]:[]);const _bd=x.body?`<div style="white-space:pre-wrap;word-break:break-word;flex:1 1 160px;min-width:0">${E(x.body)}</div>`:'<span style="flex:1 1 40px"></span>';if(!_ps.length)return x.body?`<div style="white-space:pre-wrap;word-break:break-word">${E(x.body)}</div>`:'';return `<div class="rw" style="gap:10px;align-items:flex-start">${_bd}<span class="rw actbar" style="flex:0 0 auto;gap:6px;justify-content:flex-end">${_ps.map((p,i)=>`<button class="gh sup_shot" data-p="${E(p)}">🖼 ${_ps.length>1?'Screenshot '+(i+1):'View screenshot'}</button>`).join('')}</span></div>`})()}${(mine&&x.sender_id)?`<div style="text-align:right;margin-top:3px;font-size:12px;line-height:1;letter-spacing:-2px;color:${x.read_at?'#53bdeb':'var(--c-muted)'}" title="${x.read_at?E('Read by '+(x.read_by||'them')+' · '+Ap(x.read_at)):'Sent · not read yet'}">✓✓</div>`:''}</div></div>`};
return `<div class="rw" style="justify-content:space-between;align-items:center;margin-bottom:10px"><button class="gh" id="sup_back">← Back</button><span class="pill ${st[1]}">${st[0]}</span></div>
${(R.user_confirmed_at&&R.status!=='resolved')?`<div class="note" style="border-color:var(--c-done-tx)">✅ The member confirmed this is resolved on their end${isAdmin?' — you can mark it resolved.':'.'}</div>`:''}
<div class="card" style="max-height:52vh;overflow:auto">${rows.map(bubble).join('')}</div>
${R.status==='resolved'?`<div class="note" style="margin-top:10px">This ticket is resolved. <button class="gh" id="sup_reopen">↩ Reopen</button></div>`:(R.admin_resolved_at?`<div class="note" style="margin-top:10px">${isAdmin?`Marked resolved \u2014 awaiting <b>${E(uName(R.reporter_id))}</b>'s confirmation. It moves to Resolved once they confirm${_acLeft(R.admin_resolved_at)?`, or automatically in <b>${E(_acLeft(R.admin_resolved_at))}</b>`:''}. <button class="gh" id="sup_reopen">\u21a9 Undo</button>`:`The portal admin marked your issue resolved. Confirm it's sorted, or reopen it${_acLeft(R.admin_resolved_at)?` \u2014 if you do neither it closes itself in <b>${E(_acLeft(R.admin_resolved_at))}</b>`:''}. <button class="gh" id="sup_confirm">\u2705 Confirm resolved</button> <button class="gh" id="sup_reopen">\u21a9 Reopen</button>`}</div>`:'')}
<div style="margin-top:10px"><textarea id="sup_ct" rows="2" style="width:100%" placeholder="${isAdmin?'Reply to '+E(uName(R.reporter_id))+'…':'Type your message…'}"></textarea></div>
<div class="rw" style="margin-top:8px;gap:8px;flex-wrap:wrap"><button class="gh" id="sup_att">📎 Attach screenshot</button><input id="sup_file" type="file" accept="image/*" hidden><span id="sup_fn" class="mu"></span><button class="pri" id="sup_send">Send</button>${(isAdmin&&R.status!=='resolved'&&!R.admin_resolved_at)?`<button class="gh" id="sup_resolve">✓ Mark resolved</button>`:''}</div>`}
function wireSupThread(m){let file=null;bindCE(m,'help','#sup_send');
const bk=m.querySelector('#sup_back');if(bk)bk.onclick=()=>{SROPEN=null;go(true)};
m.querySelectorAll('.sup_shot').forEach(b=>b.onclick=()=>_supShot(b.dataset.p));
const fi=m.querySelector('#sup_file'),at=m.querySelector('#sup_att'),fn=m.querySelector('#sup_fn');
if(at)at.onclick=()=>fi.click();
if(fi)fi.onchange=()=>{const f=fi.files[0];if(!f)return;if(!/^image\//.test(f.type)){toast('Screenshots must be an image',true);fi.value='';return}if(f.size>15*1048576){toast('Image over 15 MB',true);fi.value='';return}file=f;if(fn)fn.textContent='📎 '+f.name};
const sd=m.querySelector('#sup_send');if(sd)sd.onclick=async()=>{const _RQ=SROPEN;if(!_RQ)return;const ta=m.querySelector('#sup_ct');const body=((ta&&ta.value)||'').trim();if(!body&&!file){toast('Write a message or attach a screenshot',true);return}sd.disabled=1;sd.textContent='Sending…';let path=null;if(file){path=await _supUpload(file);if(!path){sd.disabled=0;sd.textContent='Send';return}}const{error}=await hd.rpc('post_support_message',{p_request:_RQ,p_body:body,p_screenshot:path});sd.disabled=0;sd.textContent='Send';error?toast(error.message,true):(toast('Sent'),go(true))};
const cf=m.querySelector('#sup_confirm');if(cf)cf.onclick=async()=>{if(!await conf('Confirm this issue is resolved?\n\nIt will move to your Resolved list.'))return;const{error}=await hd.rpc('confirm_support_resolved',{p_request:SROPEN});error?toast(error.message,true):(toast('Confirmed — marked resolved'),go(true))};
const rs=m.querySelector('#sup_resolve');if(rs)rs.onclick=async()=>{rs.disabled=1;const{error}=await hd.rpc('set_support_status',{p_request:SROPEN,p_resolved:true});error?(toast(error.message,true),rs.disabled=0):(toast('Marked resolved — waiting for the reporter to confirm'),go(true))};
const ro=m.querySelector('#sup_reopen');if(ro)ro.onclick=async()=>{const{error}=await hd.rpc('reopen_support',{p_request:SROPEN});error?toast(error.message,true):(toast('Reopened'),go(true))}}
async function supportView(){
if(SROPEN)return await supThreadHTML(SROPEN,true);
const{data,error}=await hd.from('support_requests').select('*').order('last_msg_at',{ascending:false,nullsFirst:false}).limit(300);
if(error)return `<div class="e">${E(error.message)}</div>`;
SR=data??[];
NHELP=SR.filter(x=>x.status!=='resolved'&&!x.admin_resolved_at).length;try{hd.rpc('support_unseen_count').then(_r=>{NHELPNEW=(_r&&_r.data)||0;try{paintNav()}catch(_x){}})}catch(_x){}try{paintNav()}catch(e){}
if(!SR.length)return '<div class="note">Issues reported by members land here. Nothing reported yet.</div>';
return `<div class="note">Issues reported through the <b>🛟 Report issue</b> button. Open one to chat with the reporter, share screenshots, and resolve once they confirm.</div>
<div class="ftabs" style="border:none;position:static;margin-bottom:12px"><b class="${SRF==='open'?'on':''}" data-sf="open">Open (${SR.filter(x=>x.status!=='resolved'&&!x.admin_resolved_at).length})</b><b class="${SRF==='await'?'on':''}" data-sf="await">Awaiting confirmation (${SR.filter(x=>x.admin_resolved_at&&x.status!=='resolved').length})</b><b class="${SRF==='resolved'?'on':''}" data-sf="resolved">Resolved (${SR.filter(x=>x.status==='resolved').length})</b><b class="${SRF==='all'?'on':''}" data-sf="all">All (${SR.length})</b></div>
<div class="fbar"><input type="search" id="sr_q" placeholder="Search reporter or text…" value="${E(SSQ)}"><select id="sr_sort"><option value="recent" ${SSORT==='recent'?'selected':''}>Latest activity</option><option value="newest" ${SSORT==='newest'?'selected':''}>Newest first</option><option value="oldest" ${SSORT==='oldest'?'selected':''}>Oldest first</option><option value="reporter" ${SSORT==='reporter'?'selected':''}>Reporter A–Z</option></select>${(SSQ||SRF!=='open'||SSORT!=='recent')?`<button type="button" class="gh" id="sr_clr" title="Clear filters" style="border-color:var(--c-accent)">✕ Clear filters</button>`:''}<span class="mu" id="sr_ct" style="margin-left:auto"></span></div>
<div id="sr_list"></div>`}
function renderSupport(m){const list=m.querySelector('#sr_list');if(!list)return;
const _sq=(SSQ||'').trim().toLowerCase();
let rows=SR.filter(x=>SRF==='all'?true:SRF==='resolved'?x.status==='resolved':SRF==='await'?(!!x.admin_resolved_at&&x.status!=='resolved'):(x.status!=='resolved'&&!x.admin_resolved_at));
if(_sq)rows=rows.filter(x=>((uName(x.reporter_id)||'')+' '+(x.body||'')).toLowerCase().includes(_sq));
const _sc={recent:(a,b)=>+new Date(b.last_msg_at||b.created_at)-+new Date(a.last_msg_at||a.created_at),newest:(a,b)=>+new Date(b.created_at)-+new Date(a.created_at),oldest:(a,b)=>+new Date(a.created_at)-+new Date(b.created_at),reporter:(a,b)=>(uName(a.reporter_id)||'').localeCompare(uName(b.reporter_id)||'')}[SSORT];
if(_sc)rows=rows.slice().sort(_sc);
const _sct=m.querySelector('#sr_ct');if(_sct)_sct.textContent=rows.length+' shown';
list.innerHTML=rows.length?rows.map(x=>{const st=_supStage(x);return `<div class="card sup_open" data-id="${x.id}" style="cursor:pointer"><div class="rw" style="justify-content:space-between"><b>${E(uName(x.reporter_id))}</b><span class="rw" style="gap:6px;align-items:center">${x.user_confirmed_at&&x.status!=='resolved'?'<span class="pill d">✓ confirmed</span>':''}<span class="pill ${st[1]}">${st[0]}</span><span class="mu">${A(x.last_msg_at||x.created_at)}</span></span></div><div class="mu" style="margin-top:6px;white-space:pre-wrap;word-break:break-word">${E((x.body||'').slice(0,140))}${(x.body||'').length>140?'…':''}</div>${(x.admin_resolved_at&&x.status!=='resolved')?`<div class="mu" style="margin-top:6px;color:var(--c-accent)">${_acDue(x.admin_resolved_at)?`⏳ Closes itself on <b>${E(_acDue(x.admin_resolved_at).toLocaleString([],{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}))}</b> — about <b>${E(_acLeft(x.admin_resolved_at))}</b> left for ${E(uName(x.reporter_id))} to confirm or reopen`:`⏳ Stays here until ${E(uName(x.reporter_id))} confirms or reopens it`}</div>`:''}<div class="mu" style="margin-top:6px">Open conversation →</div></div>`}).join(''):'<div class="e">Nothing here.</div>';
list.querySelectorAll('.sup_open').forEach(c=>c.onclick=()=>{SROPEN=c.dataset.id;SROPEN_TAB='support';go(true)})}
function wireSupport(m){if(SROPEN){wireSupThread(m);return}renderSupport(m);
m.querySelectorAll('.ftabs b[data-sf]').forEach(b=>b.onclick=()=>{SRF=b.dataset.sf;m.querySelectorAll('.ftabs b[data-sf]').forEach(x=>x.classList.toggle('on',x===b));renderSupport(m)});
const _sq=m.querySelector('#sr_q');if(_sq)_sq.oninput=()=>{SSQ=_sq.value;renderSupport(m)};
const _ss=m.querySelector('#sr_sort');if(_ss)_ss.onchange=()=>{SSORT=_ss.value;renderSupport(m)};
const _scl=m.querySelector('#sr_clr');if(_scl)_scl.onclick=()=>{SSQ='';SRF='open';SSORT='recent';go(true)}}
async function myHelpView(){
if(SROPEN)return await supThreadHTML(SROPEN,false);
const{data,error}=await hd.rpc('my_support_tickets');
if(error)return `<div class="e">${E(error.message)}</div>`;
MYT=data||[];
NMYHELPO=MYT.filter(x=>x.status!=='resolved').length;NMYACT=MYT.filter(x=>x.admin_resolved_at&&x.status!=='resolved').length;try{paintNav()}catch(e){}
const head=`<div class="note">Track the issues you've reported and chat with the portal admin until they're sorted.</div>`;
if(!MYT.length)return head+`<div class="rw" style="margin-bottom:10px"><button class="pri" id="mh_new">\uD83D\uDEDF Report an issue</button></div><div class="e">You haven't reported anything yet. Tap \u201cReport an issue\u201d to start.</div>`;
const ftabs=`<div class="rw" style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px"><div class="ftabs" style="border:none;position:static;margin:0;flex:1 1 auto;min-width:0"><b class="${MHF==='open'?'on':''}" data-mf="open">Open (${MYT.filter(x=>x.status!=='resolved'&&!x.admin_resolved_at).length})</b><b class="${MHF==='await'?'on':''}" data-mf="await">Needs your confirmation (${MYT.filter(x=>x.admin_resolved_at&&x.status!=='resolved').length})${MYT.filter(x=>x.admin_resolved_at&&x.status!=='resolved').length?` <span class="act" style="color:#e0a800" title="Waiting on you">●</span>`:''}</b><b class="${MHF==='resolved'?'on':''}" data-mf="resolved">Resolved (${MYT.filter(x=>x.status==='resolved').length})</b><b class="${MHF==='all'?'on':''}" data-mf="all">All (${MYT.length})</b></div><button class="pri" id="mh_new">\uD83D\uDEDF Report an issue</button></div>`;
const fbar=`<div class="fbar"><input type="search" id="mh_q" placeholder="Search your issues…" value="${E(MSQ)}" style="flex:1 1 auto;width:auto;min-width:200px"><select id="mh_sort"><option value="recent" ${MSORT==='recent'?'selected':''}>Latest activity</option><option value="newest" ${MSORT==='newest'?'selected':''}>Newest first</option><option value="oldest" ${MSORT==='oldest'?'selected':''}>Oldest first</option></select>${(MSQ||MHF!=='open'||MSORT!=='recent')?`<button type="button" class="gh" id="mh_clr" title="Clear filters" style="border-color:var(--c-accent)">✕ Clear filters</button>`:''}<span class="mu" id="mh_ct" style="margin-left:auto"></span></div>`;
return head+ftabs+fbar+`<div id="mh_list"></div>`}
function renderMyHelp(m){const list=m.querySelector('#mh_list');if(!list)return;
const _mq=(MSQ||'').trim().toLowerCase();
let rows=MYT.filter(x=>MHF==='all'?true:MHF==='resolved'?x.status==='resolved':MHF==='await'?(!!x.admin_resolved_at&&x.status!=='resolved'):(x.status!=='resolved'&&!x.admin_resolved_at));
if(_mq)rows=rows.filter(x=>(x.body||'').toLowerCase().includes(_mq));
const _mcmp={recent:(a,b)=>+new Date(b.last_msg_at||b.created_at)-+new Date(a.last_msg_at||a.created_at),newest:(a,b)=>+new Date(b.created_at)-+new Date(a.created_at),oldest:(a,b)=>+new Date(a.created_at)-+new Date(b.created_at)}[MSORT];
if(_mcmp)rows=rows.slice().sort(_mcmp);
const _mct=m.querySelector('#mh_ct');if(_mct)_mct.textContent=rows.length+' shown';
list.innerHTML=rows.length?rows.map(x=>{const st=_supStage(x);return `<div class="card mh_open" data-id="${x.id}" style="cursor:pointer"><div class="rw" style="justify-content:space-between;gap:8px"><b style="white-space:pre-wrap;word-break:break-word;min-width:0">${E((x.body||'').slice(0,120))}${(x.body||'').length>120?'…':''}</b><span class="pill ${st[1]}" style="flex:0 0 auto">${st[0]}</span></div><div class="mu" style="margin-top:5px">Raised ${A(x.created_at)}${x.last_msg_at?' \u00b7 last activity '+A(x.last_msg_at):''}</div>${(x.admin_resolved_at&&x.status!=='resolved')?`<div class="mu" style="margin-top:6px">✅ Marked resolved by the portal admin on <b>${E(new Date(x.admin_resolved_at).toLocaleString([],{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}))}</b></div><div class="mu" style="margin-top:6px;color:var(--c-accent)">${_acDue(x.admin_resolved_at)?`\u23f3 Closes itself on <b>${E(_acDue(x.admin_resolved_at).toLocaleString([],{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}))}</b> \u2014 about <b>${E(_acLeft(x.admin_resolved_at))}</b> left to reopen it`:'\u23f3 Stays here until you confirm or reopen it'}</div><div class="rw" style="margin-top:9px;gap:8px;flex-wrap:wrap"><button class="pri mh_ok" data-id="${x.id}">\u2705 Confirm resolved</button><button class="gh mh_re" data-id="${x.id}">\u21a9 Reopen</button></div>`:''}<div class="mu" style="margin-top:9px">open conversation \u2192</div></div>`}).join(''):`<div class="e">${_mq?'Nothing matches your search.':MHF==='await'?'Nothing waiting on you \u2014 anything the portal admin marks resolved appears here to confirm.':MHF==='resolved'?'Nothing resolved yet.':MHF==='all'?'You haven\u2019t reported anything yet.':'Nothing open right now.'}</div>`;
list.querySelectorAll('.mh_ok').forEach(b=>b.onclick=async e=>{e.stopPropagation();
if(!await conf('Confirm this issue is resolved?\n\nIt will move to your Resolved list.'))return;
b.disabled=1;const{error}=await hd.rpc('confirm_support_resolved',{p_request:b.dataset.id});
error?(toast(error.message,true),b.disabled=0):(toast('Confirmed \u2014 marked resolved'),go(true))});
list.querySelectorAll('.mh_re').forEach(b=>b.onclick=async e=>{e.stopPropagation();
b.disabled=1;const{error}=await hd.rpc('reopen_support',{p_request:b.dataset.id});
error?(toast(error.message,true),b.disabled=0):(toast('Reopened \u2014 the portal admin has been notified'),go(true))});
list.querySelectorAll('.mh_open').forEach(c=>c.onclick=()=>{SROPEN=c.dataset.id;SROPEN_TAB='myhelp';go(true)})}
function wireMyHelp(m){if(SROPEN){wireSupThread(m);return}
const nb=m.querySelector('#mh_new');if(nb)nb.onclick=supportModal;
renderMyHelp(m);
m.querySelectorAll('.ftabs b[data-mf]').forEach(b=>b.onclick=()=>{MHF=b.dataset.mf;m.querySelectorAll('.ftabs b[data-mf]').forEach(x=>x.classList.toggle('on',x===b));renderMyHelp(m)});
const _mq=m.querySelector('#mh_q');if(_mq)_mq.oninput=()=>{MSQ=_mq.value;renderMyHelp(m)};
const _ms=m.querySelector('#mh_sort');if(_ms)_ms.onchange=()=>{MSORT=_ms.value;renderMyHelp(m)};
const _mc=m.querySelector('#mh_clr');if(_mc)_mc.onclick=()=>{MSQ='';MSORT='recent';MHF='open';go(true)}}
// ---------- router ----------
// go(true) = in-place refresh: keeps the old screen visible while reloading (no
// white flash) and restores window + pane scroll positions afterwards.
const TABI={triage:'New mail that has not been sorted yet. Read it, then tag it as a help ticket, a document for the pool, or ignore it \u2014 anything ignored or blocked moves to Archive.',mine:'Tickets assigned to you. Reply, mark pending, or resolve them here. The deadline shown is the one an admin set \u2014 use <b>Send back</b> with a remark if it should not be yours.',mymails:'Unsorted mail sitting in the mailboxes you have access to, so you can sort your own without going through the shared Inbox.',all:'Every open ticket in the portal, whoever it belongs to. The bold heading is the client or the outside person on the mail; the small chip on the right is who owns it.',support:'Issues people have raised about the portal itself. Reply, then mark resolved \u2014 the person who raised it is asked to confirm before it closes.',myhelp:'Issues you have raised with the portal admin. <b>Needs your confirmation</b> holds anything marked resolved that is waiting on you.',pool:'Documents nobody owns yet. Claim one to make it yours, or send it back with a remark if it is not for you.',late:'Tickets already past their deadline or close to it. Nothing is created here \u2014 it is a filtered view of work that is already assigned.',resolved:'Resolved and closed tickets, kept for reference. Reopen one if the issue comes back.',logs:'A record of what happened in the portal \u2014 who sorted, assigned, replied, approved or changed a setting, and when.',drafts:'Replies and new mail you started but have not sent. Nothing here goes out until you send it.',sent:'Mail sent from the portal. Sends leave on the next mail run unless you use <b>\u26a1 Send now</b>.',archive:'Mail taken out of the Inbox \u2014 ignored, blocked, or aged out. It can be restored until the retention window in Settings passes, after which it is deleted for good.',inbox:'Portal settings \u2014 mailboxes, people and access, retention, approvals, send rules and your own preferences. Some sections are admin-only.'};
function collapseNotes(scope){if(!scope)return;const h1=(scope.closest&&scope.closest('main')&&scope.closest('main').querySelector('h1'))||document.querySelector('main.mn h1');scope.querySelectorAll('.note').forEach(n=>{if(n.dataset.ib)return;n.dataset.ib='1';const w=document.createElement('span');w.className='ib';w.tabIndex=0;w.setAttribute('title','Show info');const x=document.createElement('span');x.className='ibx';x.innerHTML=n.innerHTML;w.appendChild(document.createTextNode('i'));w.appendChild(x);if(h1&&n.parentElement===scope){w.style.cssText='flex:0 0 auto;align-self:center;margin:0';if(h1.parentNode)h1.parentNode.insertBefore(w,h1.nextSibling);else h1.appendChild(w);n.remove()}else{n.replaceWith(w)}});
if(h1&&h1.parentNode&&!h1.parentNode.querySelector('.ib')&&TABI[tab]){const w=document.createElement('span');w.className='ib';w.tabIndex=0;w.setAttribute('title','What this tab is for');w.style.cssText='flex:0 0 auto;align-self:center;margin:0';
const x=document.createElement('span');x.className='ibx';x.innerHTML=TABI[tab];w.appendChild(document.createTextNode('i'));w.appendChild(x);h1.parentNode.insertBefore(w,h1.nextSibling)}}
async function go(keep){
if(SROPEN&&SROPEN_TAB!==tab)SROPEN=null;
const pos=keep?{y:window.scrollY,l:document.querySelector('.mlist')?.scrollTop,r:document.querySelector('.mread')?.scrollTop}:null;
const oldM=keep?document.getElementById('m')?.innerHTML:null;
shell(oldM||LOADING);const m=document.getElementById('m');if(!keep)m.innerHTML=LOADING;startLoad();
banner().then(()=>paintNav()).catch(()=>{});
const fin=()=>{const _mm=document.getElementById('m');collapseNotes(_mm);makeSearchable(_mm);if(!pos)return;requestAnimationFrame(()=>{window.scrollTo(0,pos.y||0);
const l=document.querySelector('.mlist');if(l&&pos.l!=null)l.scrollTop=pos.l;
const r=document.querySelector('.mread');if(r&&pos.r!=null)r.scrollTop=pos.r})};
try{
if(CM!==null){m.innerHTML=composeView();wireCompose(m);return}
if(tab==='triage'){m.innerHTML=await triageView();wireTriage(m);fin();return}
if(tab==='mymails'){m.innerHTML=await triageView(true);wireTriage(m);fin();return}
if(tab==='inbox'){m.innerHTML=await inboxView();wireInbox(m);fin();return}
if(tab==='drafts'){m.innerHTML=await draftsView();wireDrafts(m);fin();return}
if(tab==='sent'){m.innerHTML=await sentView();wireSent(m);fin();return}
if(tab==='archive'){m.innerHTML=await archView();wireArch(m);fin();return}
if(tab==='myhelp'){m.innerHTML=await myHelpView();wireMyHelp(m);fin();return}
if(tab==='support'){if(!me.platform){m.innerHTML='<div class="e">This area is limited to the portal owner.</div>';return}m.innerHTML=await supportView();wireSupport(m);fin();return}
if(tab==='logs'){if(!FEAT.activity){m.innerHTML='<div class="e">The Activity log is limited — ask an admin for access.</div>';return}
m.innerHTML=await logsView();wireLogs(m);fin();return}
m.innerHTML=await listView(tab);
renderList(m);wireF(m,()=>renderList(m));
m.querySelectorAll('.sbx').forEach(b=>b.onclick=async()=>{const{error}=await hd.rpc('dismiss_sendback',{p_id:b.dataset.id});error?toast(error.message,true):(toast('Dismissed'),go(true))});
const _ls=m.querySelector('#lsort');if(_ls)_ls.onchange=()=>{LSORT=_ls.value;renderList(m)};
if(open){const rd=m.querySelector('#read');rd.innerHTML=await oneView(open.i,open.h);
wireTicket(m);hydrateMail(rd);wireChips(rd);wireRte(rd)}
cbCtx(m);fin()
}finally{endLoad()}}
function wireTriage(m){renderTriage(m);wireF(m,()=>renderTriage(m));
if(PENDTRI){const _p=PENDTRI;PENDTRI=null;TRO={th:_p.th,mid:_p.mid};renderTriage(m);openTriRead(m)}
m.querySelectorAll('.sbx').forEach(b=>b.onclick=async()=>{const{error}=await hd.rpc('dismiss_sendback',{p_id:b.dataset.id});error?toast(error.message,true):(toast('Dismissed'),go(true))});
const sy=m.querySelector('#syncnow');if(sy)sy.onclick=()=>syncNow(sy);
m.querySelectorAll('.pa_open,.pa_sub').forEach(b=>b.onclick=()=>{const _th=b.dataset.th;if(!_th)return;
const _pf=(TR||[]).filter(r=>r.thread_id===_th).sort((a,c)=>(+new Date(c.sent_at))-(+new Date(a.sent_at)))[0];
TRO={th:_th,mid:_pf?_pf.message_id:null};renderTriage(m);openTriRead(m);
const _rd=m.querySelector('#tread');if(_rd&&_rd.scrollIntoView)try{_rd.scrollIntoView({behavior:'smooth',block:'start'})}catch(_e){}});
m.querySelectorAll('.pa_ok,.pa_no').forEach(b=>b.onclick=async()=>{b.disabled=1;
const{error}=await hd.rpc('decide_approval',{p_id:b.dataset.id,p_approve:b.classList.contains('pa_ok')});
if(error){
if(/already handled|already decided|not found/i.test(error.message||'')){toast(error.message||'That request was already handled');go(true);return}
toast(error.message,true);b.disabled=0;return}
toast(b.classList.contains('pa_ok')?'Approved \u2014 applied':'Rejected \u2014 nothing changed');go(true)});
if(!window._paWatch){window._paWatch=1;
document.addEventListener('visibilitychange',async()=>{
if(document.hidden||tab!=='triage'||CM!==null||document.querySelector('.mdl,.ovl'))return;
try{const{count}=await hd.from('pending_approvals').select('id',{count:'exact',head:true}).eq('status','pending');
if(typeof count==='number'&&count!==((PEND&&PEND.length)||0))go(true)}catch(_e){}});}
const ts=m.querySelector('#tsort');if(ts)ts.onchange=()=>{TSORT=ts.value;
if(TSORT==='oldest'||TSORT==='newest')go(true);else renderTriage(m)};
}

async function boot(){
const{data:{user:u0}}=await pb.auth.getUser();
if(u0?.user_metadata?.must_change_password){try{await hd.rpc('log_signin_pending_password',{p_ua:navigator.userAgent})}catch(e){}return pwChange()}
me=await who();if(!me)return login();
if(me.none){el.innerHTML=`<div class="authwrap"><div class="lg"><div class="e">This account (${E(me.email)}) is not a member of
the firm's workspace yet. Ask an administrator to add you.<br><br>
<button id="o">Sign out</button></div></div></div>`;
document.getElementById('o').onclick=async()=>{await doSignOut('manual');login()};return}
const{data:un}=await hd.from('usernames').select('username').eq('user_id',me.id).maybeSingle();
UNM=un?.username??null;
;(async()=>{try{const{data:{session:_ss}}=await pb.auth.getSession();const _t=_ss?.access_token;if(_t){const _pl=JSON.parse(atob(_t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));if(_pl&&_pl.session_id)await hd.rpc('register_portal_session',{p_session_id:_pl.session_id,p_ua:(navigator.userAgent||'').slice(0,300)})}}catch(e){}})();
await Promise.all([people(),loadPrefs(),loadInb(),loadRoles(),
(async()=>{const{data:vi}=await hd.rpc('visible_inboxes');MYVIS=new Set((vi??[]).map(x=>x.inbox_id))})(),
(async()=>{const{data:ts}=await hd.from('tenant_settings').select('deadline_max_months,open_send,client_pill_color,sent_all_days,send_mode,drafts_scope,restrict_enabled,onboarding_html,onboarding_enabled,inactivity_minutes,sendback_enabled,sendback_scope,sendback_admin_all,tag_restrict_connected_default,support_autoconfirm_days,date_format').eq('tenant_id',me.tenant).maybeSingle();if(ts){DFMT=(['dmy','mdy','ymd'].indexOf(ts.date_format)>=0?ts.date_format:'dmy');if(ts.deadline_max_months)DLMAX=ts.deadline_max_months;OPENSEND=!!ts.open_send;CLICOL=ts.client_pill_color||'';SADAYS=ts.sent_all_days||90;TAGRCONN=!!ts.tag_restrict_connected_default;SUPAC=(ts.support_autoconfirm_days==null?3:Math.max(0,+ts.support_autoconfirm_days||0));SBEN=ts.sendback_enabled!==false;SBSCOPE=ts.sendback_scope||'everyone';SBADMINALL=ts.sendback_admin_all!==false;SMODE=ts.send_mode||(ts.open_send?'open':'list');DRAFTSCOPE=ts.drafts_scope||'account';RESTRICTON=ts.restrict_enabled!==false;ONBHTML=ts.onboarding_html||'';ONBON=ts.onboarding_enabled!==false;IDLE_MIN=(ts.inactivity_minutes==null?30:Math.max(0,+ts.inactivity_minutes||0))}})(),
(async()=>{try{const{data:h}=await hd.rpc('have_only_show_to');HASMM=!!h;if(h){const{count}=await hd.from('v_my_mails').select('message_id',{count:'exact',head:true});NMYM=count||0}}catch(e){}})(),
(async()=>{const{data:f,error:_fe}=await hd.rpc('my_features');if(f)FEAT=f;else if(_fe)FEAT={activity:false,housekeeping:false,mailboxes:false,all_tickets:false}})(),
(async()=>{const{data:ap}=await hd.from('approval_settings').select('*').limit(1).maybeSingle();APPR=ap??null})(),
(async()=>{const{data:rt}=await hd.from('retention_settings').select('*').limit(1).maybeSingle();RET=rt??RET})(),
(async()=>{const{data:vg}=await hd.rpc('vip_groups');VIPS=new Set(vg??[])})(),
(async()=>{try{const{data:cd}=await hd.rpc('client_directory');const seen=new Set(),opt=[];
const push=(v,label)=>{if(!v||!label)return;const k=label.toLowerCase();if(seen.has(k))return;seen.add(k);opt.push({v,label})};
[...new Set((cd||[]).map(r=>r.client_group).filter(Boolean))].forEach(g=>push(g,g));
(cd||[]).forEach(r=>{if(r.full_name&&r.full_name!==r.client_group)push(r.client_group,r.full_name+' · '+r.client_group);if(r.company_name&&r.company_name!==r.client_group&&r.company_name!==r.full_name)push(r.client_group,r.company_name+' · '+r.client_group)});
opt.sort((a,b)=>a.label.localeCompare(b.label));CLOPT=opt}catch(e){CLOPT=[]}})(),
(async()=>{const[{data:tg},{data:ct2},{data:cx}]=await Promise.all([
hd.from('tags').select('id,name,behavior,color,client_name'),
hd.from('contact_tags').select('contact_id,tag_id'),
hd.from('contacts').select('id,email').order('msg_count',{ascending:false}).limit(2000)]);
TAGS=tg??[];
const cmap=Object.fromEntries((cx??[]).map(c=>[c.id,c.email]));
CEMAILS=[...new Set((cx??[]).map(c=>c.email).filter(Boolean))];
EMTAG={};(ct2??[]).forEach(x=>{const em=cmap[x.contact_id],t=TAGS.find(g=>g.id===x.tag_id);
if(em&&t)(EMTAG[em]=EMTAG[em]||[]).push(t.name)})})()]);
if(!UNM)return unameScreen();
try{const{data:_sr}=await hd.rpc('my_support_replies');SUPREP=_sr||[]}catch(e){}
try{const{data:_n}=await hd.rpc('my_support_count');NMYHELP=_n||0}catch(e){}
if(me.platform){try{const{count:_hc}=await hd.from('support_requests').select('id',{count:'exact',head:true}).neq('status','resolved').is('admin_resolved_at',null);NHELP=_hc||0}catch(e){}}
try{const{data:_no}=await hd.rpc('my_support_open_count');NMYHELPO=_no||0}catch(e){}
try{const{data:_na}=await hd.rpc('my_support_awaiting_count');NMYACT=_na||0}catch(e){}
if(!me.crm)tab='mine';go();startIdle();if(ONBON&&!ONBSEEN)setTimeout(()=>{try{showGuide(true)}catch(e){}},600)}
const isRecov=RECOV_URL;
pb.auth.onAuthStateChange(ev=>{if(ev==='PASSWORD_RECOVERY')pwChange(true)});
pb.auth.getSession().then(({data})=>{if(isRecov)return pwChange(true);return data.session?boot():login()});
