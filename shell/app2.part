const tgb=m.querySelector('#tg_b');if(tgb)tgb.onchange=()=>{m.querySelector('#tg_c').hidden=tgb.value!=='client'};
const tga=m.querySelector('#tg_add');if(tga)tga.onclick=async()=>{
const n=m.querySelector('#tg_n').value.trim(),bh=m.querySelector('#tg_b').value,cn=m.querySelector('#tg_c').value.trim(),out=m.querySelector('#tg_msg');
if(!n){out.innerHTML='<div class="blk">Give the tag a name.</div>';return}
const{error}=await hd.from('tags').insert({tenant_id:me.tenant,name:n,behavior:bh,client_name:bh==='client'?(cn||null):null,color:m.querySelector('#tg_col')?.value||null,created_by:me.id});
error?out.innerHTML=`<div class="blk">${E(error.message)}</div>`:(toast('Tag created'),go(true))};
m.querySelectorAll('.tged').forEach(b=>b.onclick=async()=>{
const nn=await ask('Rename this tag — the new name takes effect immediately everywhere it is used:',b.dataset.n);if(nn===null)return;const nm=nn.trim();
if(!nm){toast('Name cannot be empty',true);return}
const{error}=await hd.from('tags').update({name:nm}).eq('id',b.dataset.id);
error?toast(error.message,true):(toast('Tag renamed — updated everywhere immediately'),go(true))});
m.querySelectorAll('.tgcol').forEach(i=>i.onchange=async()=>{const{error}=await hd.from('tags').update({color:i.value}).eq('id',i.dataset.id);if(error){toast(error.message,true);return}const t=TAGS.find(g=>g.id===i.dataset.id);if(t)t.color=i.value;toast('Pill colour saved — shows on the pills right away')});
const _cc=m.querySelector('#cli_col');if(_cc)_cc.onchange=async()=>{const v=_cc.value;const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,client_pill_color:v,updated_by:me.id,updated_at:new Date().toISOString()});if(error){toast(error.message,true);return}CLICOL=v;toast('Client pill colour saved — every client pill uses it now')};
const _ccr=m.querySelector('#cli_col_rst');if(_ccr)_ccr.onclick=async()=>{const{error}=await hd.from('tenant_settings').upsert({tenant_id:me.tenant,client_pill_color:null,updated_by:me.id,updated_at:new Date().toISOString()});if(error){toast(error.message,true);return}CLICOL='';const cc=m.querySelector('#cli_col');if(cc)cc.value='#8b5cf6';toast('Client pill colour reset to the default violet')};
m.querySelectorAll('.tgx').forEach(b=>b.onclick=async()=>{
